# Documentation asset workspace. This tree holds 3D build inputs, generated
# registries, provider downloads, source masters, and review renders. It is
# working data rather than shipped mod content and must never be committed or
# pushed.
docs/assets/

# Qoder agent runtime (generated subagent definitions + local MCP registration)
.qoder/

# opencode agent runtime (generated subagent definitions + local MCP registration + imagegen sidecar)
.opencode/

# Claude Code agent runtime (generated subagents, linked skills, local runtime state).
# `.mcp.json` at the repo root is the committed Claude Code entry point.
# `CLAUDE.md` is generated as a copy of `AGENTS.md` by sync_claude_agents.py and is never committed.
.claude/
/CLAUDE.md

# DSH agent runtime (project skill root, which ranks above the shared .agents/skills root,
# plus any local runtime state). The DSH standard is documented in docs/runtimes.md.
.dsh/

# Python bytecode caches produced by the tooling in .tools/ and the repo skills.
__pycache__/
*.pyc

# Local crash diagnostics. Game crash minidumps run to multiple gigabytes and exceed
# the per-object limit of the LFS remote, so they stay local next to their capture logs.
.tools/qa/
*.dmp
