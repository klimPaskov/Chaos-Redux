# Documentation asset workspace. This tree holds 3D build inputs, generated
# registries, provider downloads, source masters, and review renders. It is
# working data rather than shipped mod content and must never be committed or
# pushed.
docs/assets/

# Qoder agent runtime (generated subagent definitions + local MCP registration)
.qoder/

# opencode agent runtime (generated subagent definitions + local MCP registration + imagegen sidecar)
.opencode/

# Claude Code definitions are canonical and public: .claude/agents, .claude/skills and CLAUDE.md.
# Every other runtime is generated from them by python .tools/sync/sync_agents.py:
# the shared skill root .agents/skills (junctions to .claude/skills) and the Codex agent TOMLs.
.agents/skills/
.codex/agents/
# Keep machine-local session state out of version control.
.claude/worktrees/
.claude/*.lock
.claude/settings.local.json

# DSH agent runtime (project skill root, which ranks above the shared .agents/skills root,
# plus any local runtime state). The DSH standard is documented in docs/runtimes.md.
.dsh/

# Python bytecode caches produced by the tooling in .tools/ and the repo skills.
__pycache__/
*.pyc

# Local crash diagnostics. Game crash minidumps run to multiple gigabytes and exceed
# the per-object limit of the LFS remote, so they stay local next to their capture logs.
.tools/qa/
*.dmp

# Git LFS storage budget. Only assets the game loads may be committed as binaries:
# gfx/ textures, meshes and animations, sound and music audio, map bitmaps, and the launcher
# thumbnail (all in LFS, see .gitattributes), plus the few maintained non-game binaries re-included
# below. Evidence screenshots, renders, contact sheets, previews, GIFs, source art, provider
# downloads, model interchange files and archives stay local or go to the external LFS archive.
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.tif
*.tiff
*.bmp
*.psd
*.xcf
*.ora
*.kra
*.dds
*.tga
*.mesh
*.anim
