    "meshy_image_to_3d": {
      "required_ai_model": "meshy-7",
      "accepted_ai_models": [
        "meshy-7"
      ],
      "required_arguments": [],
      "required_argument_groups": [
        [
          "file_path",
          "image_url",
          "input_task_id"
        ]
      ],
      "input_image_exclusivity": [
        "file_path",
        "image_url",
        "input_task_id"
      ],
      "optional_arguments": [
        "ai_model",
        "alpha_thumbnail",
        "auto_size",
        "decimation_mode",
        "enable_pbr",
        "file_path",
        "hd_texture",
        "image_enhancement",
        "image_url",
        "input_task_id",
        "model_type",
        "multi_view_thumbnails",
        "origin_at",
        "pose_mode",
        "remove_lighting",
        "response_format",
        "save_pre_remeshed_model",
        "should_remesh",
        "should_texture",
        "symmetry_mode",
        "target_formats",
        "target_polycount",
        "texture_image_url",
        "texture_prompt",
        "texture_resolution",
        "topology",
        "ultra_mode"
      ],
      "multi_view_thumbnails": false,
      "paid": true,
      "live_input_schema": {
        "type": "object",
        "properties": {
          "image_url": {
            "type": "string",
            "description": "PUBLIC image URL (https://...). Use ONLY for remote images. For local files use file_path instead. NEVER manually base64-encode."
          },
          "file_path": {
            "type": "string",
            "description": "ABSOLUTE path to LOCAL image (.jpg/.png). PREFERRED for local files. Server auto-encodes. Example: /Users/me/photo.jpg. NEVER manually base64-encode."
          },
          "input_task_id": {
            "type": "string",
            "description": "Chain from a SUCCEEDED text-to-image or image-to-image task: use its generated image as the input instead of image_url/file_path. Provide only one image source."
          },
          "ai_model": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "meshy-5",
                  "meshy-6",
                  "meshy-7",
                  "latest"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "meshy-t1",
                  "meshy-t2"
                ]
              }
            ],
            "description": "AI model. Standard generation: 'meshy-5', 'meshy-6', 'meshy-7', or 'latest' (default \u2014 resolves to Meshy 7 here). Smart Topology generation (set model_type: 'smart-topology'): 'meshy-t2' (default, recommended \u2014 native part separation) or 'meshy-t1'. IMPORTANT: Before calling this tool, ask the user which model to use and explain the trade-off: meshy-7/latest = best quality (20 credits mesh, 30 textured); meshy-t2 smart-topology = clean part-separated geometry and much cheaper (5 credits mesh, 15 textured); meshy-5 = previous gen (5 credits). NOTE: passing remove_lighting with 'latest' keeps the task on Meshy 6."
          },
          "ultra_mode": {
            "type": "boolean",
            "description": "Meshy 7 Ultra \u2014 run the extra high-detail geometry pass (+5 credits). Only valid when the task actually runs Meshy 7: pass ai_model 'meshy-7' explicitly (reliable), or 'latest' while latest resolves to Meshy 7. On meshy-5/meshy-6 the API returns 400. Single-image only \u2014 not available on multi-image-to-3d. Cannot be combined with model_type 'lowpoly'. Confirm the extra cost with the user first."
          },
          "model_type": {
            "type": "string",
            "enum": [
              "standard",
              "smart-topology",
              "lowpoly"
            ],
            "description": "Model type: 'standard' (default), 'smart-topology' (part-separated geometry via meshy-t1/meshy-t2, much cheaper), or 'lowpoly' (deprecated \u2014 prefer smart-topology)"
          },
          "pose_mode": {
            "type": "string",
            "enum": [
              "a-pose",
              "t-pose"
            ],
            "description": "Pose mode for character models: 'a-pose' or 't-pose'. IMPORTANT: When the user intends to rig or animate the model, default to 't-pose' for best rigging results"
          },
          "enable_pbr": {
            "type": "boolean",
            "default": false,
            "description": "Enable physically-based rendering textures. Default false"
          },
          "topology": {
            "type": "string",
            "enum": [
              "quad",
              "triangle"
            ],
            "description": "Mesh topology type (quad or triangle)"
          },
          "target_polycount": {
            "type": "integer",
            "minimum": 100,
            "maximum": 300000,
            "description": "Target polygon count for the model (100\u2013300,000)"
          },
          "decimation_mode": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "description": "Adaptive decimation polycount level (1=ultra, 2=high, 3=medium, 4=low). When set, target_polycount is ignored."
          },
          "should_remesh": {
            "type": "boolean",
            "description": "Whether to remesh. Default false for meshy-6, true for others"
          },
          "symmetry_mode": {
            "type": "string",
            "enum": [
              "off",
              "auto",
              "on"
            ],
            "description": "DEPRECATED \u2014 no longer affects output (kept for backward compatibility). Values: 'off', 'auto', 'on'."
          },
          "should_texture": {
            "type": "boolean",
            "description": "Whether to generate textures. Default true"
          },
          "texture_prompt": {
            "type": "string",
            "maxLength": 600,
            "description": "Text to guide texturing. Max 600 characters"
          },
          "texture_image_url": {
            "type": "string",
            "format": "uri",
            "description": "Image URL to guide texturing"
          },
          "texture_resolution": {
            "type": "string",
            "enum": [
              "2k",
              "4k",
              "8k"
            ],
            "description": "Base color texture resolution: '2k' (default), '4k', or '8k'. 8K costs 15 credits instead of 10 \u2014 confirm with the user before selecting it. Only supported on meshy-6 / meshy-7 / latest / smart-topology; PBR maps stay at 2K. Replaces the deprecated hd_texture flag."
          },
          "hd_texture": {
            "type": "boolean",
            "description": "DEPRECATED \u2014 use texture_resolution instead (hd_texture: true is exactly texture_resolution: '4k'). Kept for backward compatibility."
          },
          "image_enhancement": {
            "type": "boolean",
            "description": "Optimize input image for better results. Default true. Meshy-6/latest only"
          },
          "remove_lighting": {
            "type": "boolean",
            "default": true,
            "description": "Removes highlights and shadows from the base color texture for cleaner results under custom lighting. Default true. Only supported when ai_model is meshy-6 or latest"
          },
          "save_pre_remeshed_model": {
            "type": "boolean",
            "description": "Store GLB before remeshing. Default false. Only applies when should_remesh is true"
          },
          "target_formats": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "glb",
                "obj",
                "fbx",
                "stl",
                "usdz",
                "3mf"
              ]
            },
            "description": "Output formats to generate. When omitted, produces glb/obj/fbx/stl/usdz but NOT 3mf. To get 3MF, you MUST include '3mf' explicitly (e.g. [\"glb\", \"3mf\"]). Specifying formats can reduce task completion time."
          },
          "alpha_thumbnail": {
            "type": "boolean",
            "description": "Also render a transparent-background (RGBA) preview, returned as alpha_thumbnail_url. Default false."
          },
          "multi_view_thumbnails": {
            "type": "boolean",
            "description": "Also return 4 cardinal-view thumbnails (front/back/left/right). Default false."
          },
          "auto_size": {
            "type": "boolean",
            "description": "Use AI to auto-estimate real-world height and resize the model. Default false."
          },
          "origin_at": {
            "type": "string",
            "enum": [
              "bottom",
              "center"
            ],
            "description": "Origin position: 'bottom' or 'center'. Default 'bottom' when auto_size is true."
          },
          "response_format": {
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ],
            "default": "markdown",
            "description": "Output format: 'markdown' for human-readable or 'json' for machine-readable"
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
