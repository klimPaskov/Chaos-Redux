+
+# Event 012 Gods of Africa overlay. This plan is additive to the ordinary
+# continental route plans and only runs on the committed African host. The
+# focus tree still owns every prerequisite and evolution gate; these factors
+# keep an AI host moving through the overlay instead of leaving the capability
+# flags dormant behind the generic plan set.
+africa_gods_of_africa_overlay_focus_plan = {
+	name = "Event 12 Gods of Africa overlay"
+	desc = "Event 12 tribute, protection, and settlement focus behaviour"
+
+	allowed = { always = yes }
+	enable = {
+		is_ai = yes
+		africa_is_current_host = yes
+		africa_focus_has_continental_tree = yes
+		has_country_flag = gods_of_africa_active
+		has_country_flag = gods_of_africa_activation_committed
+		NOT = { has_global_flag = world_end }
+	}
+	abort = {
+		OR = {
+			NOT = { is_ai = yes }
+			NOT = { africa_is_current_host = yes }
+			NOT = { africa_focus_has_continental_tree = yes }
+			NOT = { has_country_flag = gods_of_africa_active }
+			NOT = { has_country_flag = gods_of_africa_activation_committed }
+			has_global_flag = world_end
+		}
+	}
+
+	focus_factors = {
+		gods_of_africa_focus_prepare_proclamation = @africa_plan_high
+		gods_of_africa_focus_office_voices = @africa_plan_high
+		gods_of_africa_focus_continental_proclamation = @africa_plan_urgent
+		gods_of_africa_focus_reciprocal_covenant = @africa_plan_high
+		gods_of_africa_focus_sovereign_exaction = @africa_plan_high
+		gods_of_africa_focus_measure_needs = @africa_plan_urgent
+		gods_of_africa_focus_continental_arsenals = @africa_plan_high
+		gods_of_africa_focus_rails_ports_fuel = @africa_plan_high
+		gods_of_africa_focus_continental_reserve = @africa_plan_high
+		gods_of_africa_focus_recognize_voice = @africa_plan_high
+		gods_of_africa_focus_return_soil = @africa_plan_high
+		gods_of_africa_focus_end_sponsorship = @africa_plan_high
+		gods_of_africa_focus_security_oaths = @africa_plan_urgent
+		gods_of_africa_focus_shelter_faithful = @africa_plan_high
+		gods_of_africa_focus_relief_beyond = @africa_plan_high
+		gods_of_africa_focus_expedition = @africa_plan_urgent
+		gods_of_africa_focus_final_council = @africa_plan_crisis
+		gods_of_africa_focus_record_refusal = @africa_plan_high
+		gods_of_africa_focus_reach_beyond_coast = @africa_plan_high
+		gods_of_africa_focus_let_world_answer = @africa_plan_high
+		gods_of_africa_focus_hand_judgment = @africa_plan_urgent
+		gods_of_africa_focus_no_sanctuary = @africa_plan_high
+		gods_of_africa_focus_last_sentence = @africa_plan_crisis
+		gods_of_africa_focus_africa_speaks_for_itself = @africa_plan_outcome
+	}
+
+	research = { }
