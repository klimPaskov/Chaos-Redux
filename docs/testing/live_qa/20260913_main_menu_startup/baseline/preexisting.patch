+				set_variable = { global.acid_rain_superstorm_start_entries^acid_rain_new_superstorm_id = global.date }
+				add_to_variable = { global.acid_rain_superstorm_start_entries^acid_rain_new_superstorm_id = constant:acid_rain_evolution.superstorm_lead_days }
+				set_variable_to_random = { var = global.acid_rain_superstorm_end_entries^acid_rain_new_superstorm_id min = constant:acid_rain_evolution.superstorm_duration_min_days max = constant:acid_rain_evolution.superstorm_duration_max_days_exclusive integer = yes }
+				add_to_variable = { global.acid_rain_superstorm_end_entries^acid_rain_new_superstorm_id = global.acid_rain_superstorm_start_entries^acid_rain_new_superstorm_id }
+				set_variable = { global.acid_rain_superstorm_target_count_entries^acid_rain_new_superstorm_id = global.acid_rain_superstorm_planner_targets^num }
