@@ -14,12 +14,15 @@ is_independence_wave_active_country = {
 }
 
 # Country-local Event 006 decisions, categories, and focus content are
-# player-facing and require a real active Event 006 origin. Origin-neutral
-# adapters may consume the internal package-content setup predicate below,
-# but they never publish an Event 006 player surface.
+# player-facing for a real Event 006 origin or a complete human package
+# delivered through Event 021. The Event 021 branch is receipt-only and does
+# not publish Event 006 lifecycle, network, or league state.
 is_independence_wave_event6_local_content_active = {
 	exists = yes
-	is_independence_wave_active_country = yes
+	OR = {
+		is_independence_wave_active_country = yes
+		is_independence_wave_event021_package_country = yes
+	}
 }
 
 is_independence_wave_package_content_active = {
@@ -48,16 +51,45 @@ is_independence_wave_package_content_active = {
 	}
 }
 
-# Player-facing Event 006 categories and decisions stay closed while Event 021
-# is borrowing an Event 006 package as an origin-neutral adapter. The adapter
-# still needs the package-content predicate for leaders, forces, and setup,
-# but none of those transient receipts may publish an Event 006 surface.
+# Package-local identity gate. A real Event 006 origin keeps its historical
+# origin value. The Event 021 adapter receives an origin-neutral compatibility
+# receipt during setup and after completion, so the reused package roots can
+# expose their own leaders, forces, focus, decisions, AI, and formable checks
+# without being misclassified as an Event 006 origin.
+is_independence_wave_package_origin_compatible = {
+	OR = {
+		check_variable = { liberation_origin = constant:liberation_origin.independence_wave }
+		AND = {
+			random_civil_war_is_normal_human_country = yes
+			OR = {
+				AND = {
+					has_country_flag = random_civil_war_event6_adapter_preparing
+					has_country_flag = independence_wave_event6_adapter_package_ready
+					has_valid_independence_wave_setup_input = yes
+				}
+				is_independence_wave_event021_package_country = yes
+			}
+		}
+	}
+}
+
+# Transient Event 021 adapter receipts stay closed. Once a complete human
+# package is proven, its existing Event 006 categories and decisions may be
+# used as part of the reused package without becoming an Event 006 origin.
 is_independence_wave_event6_player_surface_allowed = {
-	is_independence_wave_active_country = yes
-	NOT = { has_country_flag = random_civil_war_event6_adapter_preparing }
-	NOT = { has_country_flag = random_civil_war_event6_adapter_complete }
-	NOT = { has_country_flag = random_civil_war_origin_adapter_complete }
-	NOT = { has_country_flag = independence_wave_event021_adapter_setup_proven }
+	OR = {
+		AND = {
+			is_independence_wave_active_country = yes
+			NOT = { has_country_flag = random_civil_war_event6_adapter_preparing }
+			NOT = { has_country_flag = random_civil_war_event6_adapter_complete }
+			NOT = { has_country_flag = random_civil_war_origin_adapter_complete }
+			NOT = { has_country_flag = independence_wave_event021_adapter_setup_proven }
+		}
+		AND = {
+			is_independence_wave_event021_package_country = yes
+			NOT = { has_country_flag = random_civil_war_event6_adapter_preparing }
+		}
+	}
 }
 
