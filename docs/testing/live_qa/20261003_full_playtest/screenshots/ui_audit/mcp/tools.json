    "hoi4.gui_inspect": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "workspaceId": {
          "default": "current",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "windowName": {
          "type": "string",
