          "kind": "scripted_effect",
          "id": "africa_disease_dispatch_seed_from_current_state",
          "path": "mod:common/scripted_effects/012_africa_disease_effects.txt",
          "rootKind": "mod",
          "loadOrder": 15,
          "overridden": false,
          "sourceShadowed": false,
          "startLine": 34,
          "endLine": 54,
          "fromLine": 34,
          "toLine": 54,
          "nextLine": null,
          "nextColumn": null,
          "text": "africa_disease_dispatch_seed_from_current_state = {\n\tbio_lifecycle_reset_seed_record = yes\n\tset_temp_variable = { bio_seed_agent = event_target:africa_host.africa_disease_agent_slot }\n\tset_temp_variable = { bio_seed_route = constant:bio_lifecycle_route.battlefield_dissemination }\n\tset_temp_variable = { bio_seed_source = constant:bio_lifecycle_source.deliberate }\n\tset_temp_variable = { bio_seed_result = event_target:africa_host.africa_disease_seed_result }\n\tset_temp_variable = { bio_seed_actor_proof = constant:bio_lifecycle_proof.supplied }\n\tset_temp_variable = { bio_seed_victim_proof = constant:bio_lifecycle_proof.supplied }\n\tset_temp_variable = { bio_seed_payload_debit_proof = constant:bio_lifecycle_proof.supplied }\n\tset_temp_variable = { bio_seed_use_history_proof = constant:bio_lifecycle_proof.supplied }\n\tset_temp_variable = { bio_seed_payload_required = constant:africa_disease.payload_unit }\n\tset_temp_variable = { bio_seed_payload_consumed = constant:africa_disease.payload_unit }\n\tset_temp_variable = { bio_seed_weaponization_mult = constant:bio_lifecycle_math.one }\n\tevent_target:africa_host = { save_event_target_as = bio_seed_actor }\n\tCONTROLLER = { save_event_target_as = bio_seed_victim }\n\tbio_lifecycle_dispatch_seed = yes\n\tif = {\n\t\tlimit = { check_variable = { var = bio_seed_dispatch_status value = constant:bio_lifecycle_proof.supplied compare = equals } }\n\t\tCONTROLLER = { set_variable = { africa_disease_dispatch_accepted = constant:africa_value.one } }\n\t}\n}"
        }
