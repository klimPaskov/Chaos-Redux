      "name": "hoi4.gui_inspect",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "default": "current",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "windowName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "scenario": {
            "description": "GUI preview scenario; optional date and controls {stateId: controllerTag}."
          },
          "relatedScenarios": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "description": "GUI preview scenario; optional date and controls {stateId: controllerTag}."
            }
