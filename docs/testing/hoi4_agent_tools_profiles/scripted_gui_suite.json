{
  "schemaVersion": "1.0",
  "id": "chaos_redux_scripted_gui",
  "cases": [
    {
      "id": "meter_inspect",
      "domain": "tool",
      "tool": "hoi4.gui_inspect",
      "arguments": {
        "windowName": "chaos_meter_popup_window",
        "scenario": { "id": "meter_history", "resolution": { "width": 1920, "height": 1080 }, "uiScale": 1, "flags": { "chaos_meter_window_open": true, "chaos_meter_history_tab": true } },
        "relatedScenarios": [{ "id": "meter_air", "resolution": { "width": 1920, "height": 1080 }, "uiScale": 1, "flags": { "chaos_meter_window_open": true, "chaos_meter_air_tab": true } }],
        "generatedScenarios": { "enabled": false }
      },
      "assertions": [{ "id": "window", "path": ["data", "windowName"], "expected": "chaos_meter_popup_window" }],
      "views": ["summary", "artifacts", "diagnostics"]
    },
    {
      "id": "meter_render",
      "domain": "tool",
      "tool": "hoi4.gui_render",
      "arguments": {
        "windowName": "chaos_meter_popup_window",
        "scenario": { "id": "meter_history", "resolution": { "width": 1920, "height": 1080 }, "uiScale": 1, "flags": { "chaos_meter_window_open": true, "chaos_meter_history_tab": true } },
        "relatedScenarios": [{ "id": "meter_air", "resolution": { "width": 1920, "height": 1080 }, "uiScale": 1, "flags": { "chaos_meter_window_open": true, "chaos_meter_air_tab": true } }],
        "states": ["normal"],
        "resolutions": [{ "width": 1920, "height": 1080, "uiScale": 1 }],
        "generatedScenarios": { "enabled": false }
      },
      "assertions": [{ "id": "scenario", "path": ["data", "scenarioId"], "expected": "meter_history" }],
      "views": ["summary", "artifacts", "diagnostics"]
    },
