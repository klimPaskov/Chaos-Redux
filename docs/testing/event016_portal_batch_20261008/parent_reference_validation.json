  "neutralBody": {
    "source": "\tset_temp_variable = { portal_transit_equipment_delivered = constant:portal_transit_batch.zero }\n\tif = {\n\t\tlimit = {\n\t\t\tcheck_variable = { portal_transit_equipment_amount > constant:portal_transit_batch.zero }\n\t\t\thas_tech = brilliant_scientist_portal_warfare_tech\n\t\t}\n\t\tset_temp_variable = { portal_transit_equipment_before = num_equipment@teleportation_equipment_1 }\n\t\tadd_equipment_to_stockpile = { type = teleportation_equipment_1 amount = portal_transit_equipment_amount producer = THIS }\n\t\tset_temp_variable = { portal_transit_equipment_delivered = num_equipment@teleportation_equipment_1 }\n\t\tsubtract_from_temp_variable = { portal_transit_equipment_delivered = portal_transit_equipment_before }\n\t\tclamp_temp_variable = { var = portal_transit_equipment_delivered min = constant:portal_transit_batch.zero }\n\t}\n\t# Consume the explicit input even on refusal; a literal reuse cannot redeliver.\n\tset_temp_variable = { portal_transit_equipment_amount = constant:portal_transit_batch.zero }\n",
    "fileSha256": "5d0bae27543f17d8213481a0c14ae1522a61ab91cac88c2684df7ec1a32f947a"
