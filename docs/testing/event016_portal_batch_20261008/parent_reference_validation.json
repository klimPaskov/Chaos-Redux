                "fromLine": 213,
                "toLine": 243,
                "nextLine": null,
                "nextColumn": null,
                "text": "\tbrilliant_scientist_krg_fabricate_portal_transit_batch = {\n\t\ticon = GFX_decision_brilliant_scientist_krg_portal_terminal\n\t\tvisible = {\n\t\t\tbrilliant_scientist_krg_decisions_are_active = yes\n\t\t\tbrilliant_scientist_kruger_focus_teleportation_is_operational = yes\n\t\t\thas_country_flag = brilliant_scientist_focus_unlock_bounded_portal_recruitment\n\t\t}\n\t\tavailable = {\n\t\t\tbrilliant_scientist_kruger_focus_teleportation_is_operational = yes\n\t\t\thidden_trigger = { has_country_flag = brilliant_scientist_focus_unlock_bounded_portal_recruitment }\n\t\t\tOR = {\n\t\t\t\tbrilliant_scientist_kruger_raid_ai_is_active = yes\n\t\t\t\thas_country_flag = brilliant_scientist_krg_terminal_supply_network_linked\n\t\t\t}\n\t\t\tbrilliant_scientist_krg_can_pay_project_batch_cost = yes\n\t\t\tcheck_variable = { brilliant_scientist_krg_portal_transit_batches < constant:brilliant_scientist_krg_capacity.portal_transit_batch_maximum }\n\t\t}\n\t\tcost = constant:brilliant_scientist_krg_cost.pp_heavy\n\t\tdays_remove = constant:brilliant_scientist_krg_timing.heavy_days\n\t\tdays_re_enable = constant:brilliant_scientist_krg_timing.reenable_short_days\n\t\tmodifier = { civilian_factory_use = @CR_SC_BRILLIANT_SCIENTIST_KRG_MODIFIER_HEAVY_FACTORY_USE }\n\t\tcomplete_effect = { brilliant_scientist_krg_pay_project_batch_cost = yes }\n\t\tcancel_trigger = {\n\t\t\tOR = {\n\t\t\t\tNOT = { brilliant_scientist_krg_decisions_are_active = yes }\n\t\t\t\tNOT = { brilliant_scientist_kruger_focus_teleportation_is_operational = yes }\n\t\t\t}\n\t\t}\n\t\tremove_effect = { brilliant_scientist_krg_complete_portal_transit_batch = yes }\n\t\tai_will_do = { base = constant:brilliant_scientist_krg_ai.medium }\n\t}"
              }
