{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chaos-redux-formable-state-puzzle-consumer/v1",
  "title": "Chaos Redux formable/event state-puzzle consumer specification",
  "description": "Build-time declaration of a fixed state candidate set, projection canvas, and live helper policies. The game never discovers candidate ids dynamically.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "category_id", "formable_id", "registry", "projection", "state_ids"],
  "properties": {
    "schema": {"const": "chaos-redux-formable-state-puzzle-consumer/v1"},
    "status": {"type": "string", "enum": ["draft", "complete"]},
    "category_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.-]+$"},
    "formable_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.-]+$"},
    "group_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.-]+$"},
    "activation_helper": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "group_scripted_gui_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "group_window_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "registry": {"type": "string", "minLength": 1},
    "projection": {"$ref": "#/$defs/projection"},
    "state_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "summary_required_count": {"type": "integer", "minimum": 1},
    "state_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "state_ids"],
        "properties": {
          "group_id": {"type": "string", "minLength": 1},
          "state_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
        }
      }
    },
    "qualification_policy": {"$ref": "#/$defs/policy"},
    "visibility_policy": {"$ref": "#/$defs/policy"},
    "state_overrides": {
      "type": "array",
      "items": {"$ref": "#/$defs/override"}
    },
    "territory_helper": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "assets": {"$ref": "#/$defs/assets"},
    "output": {"$ref": "#/$defs/output"}
  },
  "allOf": [
    {"if": {"required": ["group_id"]}, "then": {"required": ["activation_helper"]}},
    {"if": {"required": ["activation_helper"]}, "then": {"required": ["group_id"]}},
    {"if": {"required": ["group_scripted_gui_id"]}, "then": {"required": ["group_id"]}},
    {"if": {"required": ["group_window_id"]}, "then": {"required": ["group_id"]}}
  ],
  "$defs": {
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canvas", "padding"],
      "properties": {
        "canvas": {
          "type": "array",
          "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}],
          "minItems": 2,
          "maxItems": 2
        },
        "padding": {"type": "integer", "minimum": 0},
        "scale": {"type": "number", "exclusiveMinimum": 0},
        "offset": {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "policy": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id"],
      "properties": {
        "state_id": {"type": "integer", "minimum": 1},
        "required": {"type": "boolean"},
        "qualification_policy": {"$ref": "#/$defs/policy"},
        "visibility_policy": {"$ref": "#/$defs/policy"},
        "qualification_helper": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "visibility_helper": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unresolved_rgba": {"$ref": "#/$defs/rgba"},
        "qualifying_rgba": {"$ref": "#/$defs/rgba"},
        "alpha": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    },
    "rgba": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0, "maximum": 255},
        {"type": "integer", "minimum": 0, "maximum": 255},
        {"type": "integer", "minimum": 0, "maximum": 255},
        {"type": "integer", "minimum": 0, "maximum": 255}
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest": {"type": "string", "minLength": 1},
        "source_dir": {"type": "string", "minLength": 1},
        "processed_dir": {"type": "string", "minLength": 1},
        "dds_dir": {"type": "string", "minLength": 1},
        "preview_dir": {"type": "string", "minLength": 1}
      }
    }
  }
}
