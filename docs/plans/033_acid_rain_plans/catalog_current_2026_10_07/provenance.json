  "cellValues": {
    "Events!C34": {
      "before": "A lethal atmospheric system moves through a frozen registry of valid states, touching each state exactly once while prepared countries spend resources to limit deaths, damage, contamination, and supply loss before the ordinary cloud dissipates.",
      "after": "A lethal acid-rain system moves between regions, exposing the inhabited states in its path to corrosion, poisoned runoff, infrastructure damage, and direct civilian loss. Countries can build shelters, protect water and food, expand emergency medicine, harden transport, evacuate states ahead of storm forecasts, and repair the aftermath. The rain ordinarily disperses only after it has crossed every state in its path.",
      "source": "acid_rain.event_details.description static premise only; dynamic status and achievement scripted localisations excluded"
    },
    "Events!D34": {
      "before": "Severe Storm Cells: localized high-intensity cells add stronger human, infrastructure, supply, and military pressure while the regional system continues moving.",
      "after": "Severe Storm Cells: Concentrated cells form inside the moving front, giving threatened states nine days to prepare for heavier corrosion and lethal exposure.",
      "source": "acid_rain.evolution.stage_1.title and acid_rain.evolution.stage_1.body"
    },
    "Events!E34": {
      "before": "Multiple Weather Fronts: two independent fronts can operate at once, with a conditional third front, separate warnings, timers, intensity, and severe cells.",
      "after": "Multiple Weather Fronts: The atmospheric mass divides into independent fronts with separate routes, warnings, intensity, and severe cells.",
      "source": "acid_rain.evolution.stage_2.title and acid_rain.evolution.stage_2.body"
    },
    "Events!F34": {
      "before": "Global Acid Rain: simultaneous worldwide exposure closes the regional phase, applies the same exact population-loss contract everywhere, and retains a guaranteed dissipation path.",
      "after": "Global Acid Rain: The fronts merge into a worldwide layer that exposes every inhabited state in its path and produces regional superstorms with nine-day forecasts.",
      "source": "acid_rain.evolution.stage_3.title and acid_rain.evolution.stage_3.body"
    },
    "Events!M34": {
      "before": "To Be Reworked",
      "after": "Needs Testing",
      "source": "catalog_changes_pending.md; live-game verification remains the gate"
    },
    "Clusters!C6": {
      "before": "Natural and environmental catastrophes strike states or regions through five distinct Natural Disasters slots, followed by optional Acid Rain and Heat Wave crises. A sequence containing Acid Rain commits Major-event pacing once while preserving the cluster history.",
      "after": "Natural and environmental catastrophes strike states or regions, with repeated disaster slots allowing the cluster to scale into larger cascades.",
      "source": "chaosx.events_log.window.cluster_details.description.natural_disasters"
    }
  },
