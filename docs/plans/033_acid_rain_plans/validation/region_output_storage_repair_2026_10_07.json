            "nextLine": null,
            "nextColumn": null,
            "text": "acid_rain_prepare_region_cursor = {\n\tif = {\n\t\tlimit = {\n\t\t\tOR = {\n\t\t\t\tNOT = { has_variable = global.acid_rain_region_index_generation }\n\t\t\t\tcheck_variable = { var = global.acid_rain_region_index_generation value = global.acid_rain_generation_id compare = not_equals }\n\t\t\t}\n\t\t}\n\t\tacid_rain_build_region_index = yes\n\t}\n\tset_temp_variable = { acid_rain_cursor_start = constant:acid_rain_runtime.zero }\n\tset_temp_variable = { acid_rain_cursor_end = constant:acid_rain_runtime.zero }\n\tif = {\n\t\tlimit = {\n\t\t\tcheck_variable = { var = acid_rain_cursor_region value = constant:acid_rain_region.first compare = greater_than_or_equals }\n\t\t\tcheck_variable = { var = acid_rain_cursor_region value = constant:acid_rain_region.last compare = less_than_or_equals }\n\t\t}\n\t\tset_temp_variable = { acid_rain_cursor_start = global.acid_rain_region_index_start_entries^acid_rain_cursor_region }\n\t\tset_temp_variable = { acid_rain_cursor_end = global.acid_rain_region_index_end_entries^acid_rain_cursor_region }\n\t}\n}"
          }
        ],
