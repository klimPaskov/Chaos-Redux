{
  "server": {
    "name": "hoi4-agent-tools",
    "version": "3.6.0",
    "websiteUrl": "https://github.com/klimPaskov/hoi4-agent-tools"
  },
  "capabilities": {
    "logging": {},
    "prompts": {
      "listChanged": true
    },
    "resources": {
      "listChanged": true
    },
    "tools": {
      "listChanged": true
    },
    "tasks": {
      "list": {},
      "cancel": {},
      "requests": {
        "tools": {
          "call": {}
        }
      }
    }
  },
  "schemas": [
    {
      "name": "hoi4.reference_search",
      "title": "Search local HOI4 references",
      "description": "Search bounded, cited sections of the configured offline wiki and installed game documentation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "default": "current",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "sources": {
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "game_doc",
                "wiki",
                "script_doc"
              ]
            }
          },
          "limit": {
            "default": 6,
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        },
        "required": [
          "query"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "blocked",
              "error"
            ]
          },
          "code": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "filesScanned": {
            "type": "array",
            "items": {}
          },
          "proposedFiles": {
            "type": "array",
            "items": {}
          },
          "changedFiles": {
            "type": "array",
            "items": {}
          },
          "diagnostics": {
            "maxItems": 20,
            "type": "array",
            "items": {}
          },
          "artifacts": {
            "maxItems": 32,
            "type": "array",
            "items": {}
          },
          "validation": {},
          "blockers": {
            "type": "array",
            "items": {}
          },
          "data": {
            "type": "object",
            "properties": {},
            "additionalProperties": {}
          }
        },
        "required": [
          "status",
          "code",
          "workspaceId",
          "filesScanned",
          "proposedFiles",
          "changedFiles",
          "diagnostics",
          "artifacts",
          "validation",
          "blockers",
          "data"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "hoi4.reference_read",
      "title": "Read cited HOI4 reference section",
      "description": "Read at most 80 lines from one revision-bound local documentation section.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "default": "current",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "startLine": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "startColumn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "maxLines": {
            "default": 40,
            "type": "integer",
            "minimum": 1,
            "maximum": 80
          }
        },
        "required": [
          "id",
          "revision"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "blocked",
              "error"
            ]
          },
          "code": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "filesScanned": {
            "type": "array",
            "items": {}
          },
          "proposedFiles": {
            "type": "array",
            "items": {}
          },
          "changedFiles": {
            "type": "array",
            "items": {}
          },
          "diagnostics": {
            "maxItems": 20,
            "type": "array",
            "items": {}
          },
          "artifacts": {
            "maxItems": 32,
            "type": "array",
            "items": {}
          },
          "validation": {},
          "blockers": {
            "type": "array",
            "items": {}
          },
          "data": {
            "type": "object",
            "properties": {},
            "additionalProperties": {}
          }
        },
        "required": [
          "status",
          "code",
          "workspaceId",
          "filesScanned",
          "proposedFiles",
          "changedFiles",
          "diagnostics",
          "artifacts",
          "validation",
          "blockers",
          "data"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "hoi4.event_inspect",
      "title": "Inspect event chains",
      "description": "Scan, find roots, trace, explain paths, inspect state flow, lint, or assess impact. Full source-linked reports are resources.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "default": "current",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "scan",
              "roots",
              "trace",
              "explain_path",
              "state_flow",
              "lint",
              "impact",
              "helper_expansion"
            ]
          },
          "selector": {
            "description": "Event selector; see docs/events.md."
          },
          "from": {
            "description": "Event selector; see docs/events.md."
          },
          "to": {
            "description": "Event selector; see docs/events.md."
          },
          "direction": {
            "type": "string",
            "enum": [
              "upstream",
              "downstream",
              "both"
            ]
          },
          "maxDepth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "maxNodes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          },
          "maxEdges": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20000
          },
          "expandHelpers": {
            "type": "boolean"
          },
          "stateSubject": {
            "description": "State kind and name."
          },
          "impactSubject": {
            "description": "Impact kind and name."
          },
          "helperExpansion": {
            "description": "Bounded helper paths; opaque continuationUri resumes the same source and roots. See docs/events.md."
          },
          "refresh": {
            "type": "boolean"
          }
        },
        "required": [
          "mode"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "blocked",
              "error"
            ]
          },
          "code": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "filesScanned": {
            "type": "array",
            "items": {}
          },
          "proposedFiles": {
            "type": "array",
            "items": {}
          },
          "changedFiles": {
            "type": "array",
            "items": {}
          },
          "diagnostics": {
            "maxItems": 20,
            "type": "array",
            "items": {}
          },
          "artifacts": {
            "maxItems": 32,
            "type": "array",
            "items": {}
          },
          "validation": {},
          "blockers": {
            "type": "array",
            "items": {}
          },
          "data": {
            "type": "object",
            "properties": {},
            "additionalProperties": {}
          }
        },
        "required": [
          "status",
          "code",
          "workspaceId",
          "filesScanned",
          "proposedFiles",
          "changedFiles",
          "diagnostics",
          "artifacts",
          "validation",
          "blockers",
          "data"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "optional"
      }
    },
    {
      "name": "hoi4.tech_inspect",
      "title": "Inspect technology trees",
      "description": "Scan, discover folders, trace, explain, inspect unlocks or bonuses, lint, and assess impact.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "default": "current",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "scan",
              "folders",
              "trace",
              "explain",
              "unlocks",
              "bonus_coverage",
              "lint",
              "impact",
              "helper_expansion"
            ]
          },
          "folderId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "technologyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "categoryId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "targetKind": {
            "type": "string",
            "enum": [
              "equipment",
              "equipment_module",
              "sub_unit",
              "building",
              "ability",
              "tactic",
              "other"
            ]
          },
          "targetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "direction": {
            "type": "string",
            "enum": [
              "prerequisites",
              "descendants",
              "both"
            ]
          },
          "maxDepth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          },
          "maxNodes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25000
          },
          "includeSubTechnologies": {
            "type": "boolean"
          },
          "classifications": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "confirmed_error",
                "probable_defect",
                "design_warning",
                "unresolved_analysis"
              ]
            }
          },
          "codes": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "impact": {
            "description": "Rename or removal subject."
          },
          "helperExpansion": {
            "description": "Bounded helper paths; opaque continuationUri resumes the same source and roots. See docs/technology.md."
          },
          "refresh": {
            "type": "boolean"
          }
        },
        "required": [
          "mode"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "blocked",
              "error"
            ]
          },
          "code": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "filesScanned": {
            "type": "array",
            "items": {}
          },
          "proposedFiles": {
            "type": "array",
            "items": {}
          },
          "changedFiles": {
            "type": "array",
            "items": {}
          },
          "diagnostics": {
            "maxItems": 20,
            "type": "array",
            "items": {}
          },
          "artifacts": {
            "maxItems": 32,
            "type": "array",
            "items": {}
          },
          "validation": {},
          "blockers": {
            "type": "array",
            "items": {}
          },
          "data": {
            "type": "object",
            "properties": {},
            "additionalProperties": {}
          }
        },
        "required": [
          "status",
          "code",
          "workspaceId",
          "filesScanned",
          "proposedFiles",
          "changedFiles",
          "diagnostics",
          "artifacts",
          "validation",
          "blockers",
          "data"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "optional"
      }
    }
  ]
}