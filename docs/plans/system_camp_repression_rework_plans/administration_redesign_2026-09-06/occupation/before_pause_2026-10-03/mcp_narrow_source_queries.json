{
  "server": {
    "name": "hoi4-agent-tools",
    "version": "3.6.0",
    "websiteUrl": "https://github.com/klimPaskov/hoi4-agent-tools"
  },
  "sdk": "1.30.0",
  "schema": {
    "name": "hoi4.source_lookup",
    "title": "Look up HOI4 source symbol",
    "description": "Find exact Clausewitz definitions, override status, a bounded source block, and indexed usages in the configured game and mod.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspaceId": {
          "default": "current",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "includeReferences": {
          "default": true,
          "type": "boolean"
        },
        "maxDefinitions": {
          "default": 3,
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "maxReferences": {
          "default": 10,
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "maxLines": {
          "default": 30,
          "type": "integer",
          "minimum": 1,
          "maximum": 80
        },
        "fromLine": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fromColumn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expectedRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "symbol"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "blocked",
            "error"
          ]
        },
        "code": {
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        },
        "filesScanned": {
          "type": "array",
          "items": {}
        },
        "proposedFiles": {
          "type": "array",
          "items": {}
        },
        "changedFiles": {
          "type": "array",
          "items": {}
        },
        "diagnostics": {
          "maxItems": 20,
          "type": "array",
          "items": {}
        },
        "artifacts": {
          "maxItems": 32,
          "type": "array",
          "items": {}
        },
        "validation": {},
        "blockers": {
          "type": "array",
          "items": {}
        },
        "data": {
          "type": "object",
          "properties": {},
          "additionalProperties": {}
        }
      },
      "required": [
        "status",
        "code",
        "workspaceId",
        "filesScanned",
        "proposedFiles",
        "changedFiles",
        "diagnostics",
        "artifacts",
        "validation",
        "blockers",
        "data"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  "attempts": [
    {
      "args": {
        "workspaceId": "camp_origin_architecture_oct3",
        "symbol": "camp_occ_reconcile_external_population",
        "kind": "scripted_effect",
        "includeReferences": false,
        "maxDefinitions": 1,
        "maxReferences": 0,
        "maxLines": 12
      },
      "error": "McpError: MCP error -32001: Request timed out",
      "code": -32001,
      "timeout": {
        "timeout": 30000
      }
    },
