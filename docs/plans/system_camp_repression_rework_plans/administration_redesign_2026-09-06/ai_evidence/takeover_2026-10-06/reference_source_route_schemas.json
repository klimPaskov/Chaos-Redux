    {
      "name": "hoi4.event_inspect",
      "title": "Inspect event chains",
      "description": "Scan, find roots, trace, explain paths, inspect state flow, lint, or assess impact. Full source-linked reports are resources.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "default": "current",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "scan",
              "roots",
              "trace",
              "explain_path",
              "state_flow",
              "lint",
              "impact",
              "helper_expansion"
            ]
          },
          "selector": {
            "description": "Event selector; see docs/events.md."
          },
          "from": {
            "description": "Event selector; see docs/events.md."
          },
          "to": {
            "description": "Event selector; see docs/events.md."
          },
          "direction": {
            "type": "string",
            "enum": [
              "upstream",
              "downstream",
              "both"
            ]
          },
          "maxDepth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "maxNodes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          },
          "maxEdges": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20000
          },
          "expandHelpers": {
            "type": "boolean"
          },
          "stateSubject": {
            "description": "State kind and name."
          },
          "impactSubject": {
            "description": "Impact kind and name."
          },
          "helperExpansion": {
            "description": "Bounded helper paths; opaque continuationUri resumes the same source and roots. See docs/events.md."
          },
          "refresh": {
            "type": "boolean"
          }
        },
        "required": [
          "mode"
