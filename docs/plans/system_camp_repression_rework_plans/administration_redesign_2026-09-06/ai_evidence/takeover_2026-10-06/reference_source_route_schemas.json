  "schemas": [
    {
      "name": "hoi4.reference_search",
      "title": "Search local HOI4 references",
      "description": "Search bounded, cited sections of the configured offline wiki and installed game documentation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "default": "current",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "sources": {
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "game_doc",
                "wiki",
                "script_doc"
              ]
            }
          },
          "limit": {
            "default": 6,
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        },
        "required": [
          "query"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "blocked",
              "error"
            ]
          },
          "code": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "filesScanned": {
            "type": "array",
            "items": {}
          },
          "proposedFiles": {
            "type": "array",
            "items": {}
          },
          "changedFiles": {
            "type": "array",
            "items": {}
          },
          "diagnostics": {
            "maxItems": 20,
            "type": "array",
            "items": {}
          },
          "artifacts": {
            "maxItems": 32,
            "type": "array",
            "items": {}
          },
          "validation": {},
          "blockers": {
            "type": "array",
            "items": {}
          },
          "data": {
            "type": "object",
            "properties": {},
            "additionalProperties": {}
          }
        },
        "required": [
          "status",
          "code",
          "workspaceId",
          "filesScanned",
          "proposedFiles",
          "changedFiles",
          "diagnostics",
          "artifacts",
          "validation",
          "blockers",
          "data"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
