    {
      "name": "hoi4.source_lookup",
      "title": "Look up HOI4 source symbol",
      "description": "Find exact Clausewitz definitions and usages; navigate nested keyPath blocks or list bounded child structure with view=structure. Or pass path and line to get the definitions and keyPath containing that line.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "default": "current",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "column": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "includeReferences": {
            "default": true,
            "type": "boolean"
          },
          "maxDefinitions": {
            "default": 3,
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "maxReferences": {
            "default": 10,
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "maxLines": {
            "default": 30,
            "type": "integer",
            "minimum": 1,
            "maximum": 80
          },
          "keyPath": {
            "maxItems": 24,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "occurrence": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000
                    }
                  },
                  "required": [
                    "key"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000
                    }
                  },
                  "required": [
                    "index"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "view": {
            "default": "source",
            "type": "string",
            "enum": [
              "source",
              "structure"
            ]
          },
          "maxChildren": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 40
          },
          "childOffset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "fromLine": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "fromColumn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "expectedRevision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "blocked",
              "error"
            ]
          },
          "code": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "filesScanned": {
            "type": "array",
            "items": {}
          },
          "proposedFiles": {
            "type": "array",
            "items": {}
          },
          "changedFiles": {
            "type": "array",
            "items": {}
          },
          "diagnostics": {
            "maxItems": 20,
            "type": "array",
            "items": {}
          },
          "artifacts": {
            "maxItems": 32,
            "type": "array",
            "items": {}
          },
          "validation": {},
          "blockers": {
            "type": "array",
            "items": {}
          },
          "data": {
            "type": "object",
            "properties": {},
            "additionalProperties": {}
          }
        },
        "required": [
          "status",
          "code",
          "workspaceId",
          "filesScanned",
          "proposedFiles",
          "changedFiles",
          "diagnostics",
          "artifacts",
          "validation",
          "blockers",
          "data"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
