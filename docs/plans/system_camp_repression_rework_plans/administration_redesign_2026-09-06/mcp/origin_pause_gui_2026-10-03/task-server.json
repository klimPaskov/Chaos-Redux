  "tools": [
    {
      "name": "hoi4.gui_inspect",
      "title": "Inspect scripted GUI",
      "description": "Inspect GUI sources and scenarios.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "default": "current",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "windowName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "scenario": {
            "description": "GUI preview scenario; optional date and controls {stateId: controllerTag}."
          },
          "relatedScenarios": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "description": "GUI preview scenario; optional date and controls {stateId: controllerTag}."
            }
          },
          "generatedScenarios": {
            "description": "GUI generated-scenario options."
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "blocked",
              "error"
            ]
          },
          "code": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "filesScanned": {
            "type": "array",
            "items": {}
          },
          "proposedFiles": {
            "type": "array",
            "items": {}
          },
          "changedFiles": {
            "type": "array",
            "items": {}
          },
          "diagnostics": {
            "maxItems": 20,
            "type": "array",
            "items": {}
          },
          "artifacts": {
            "maxItems": 32,
            "type": "array",
            "items": {}
          },
          "validation": {},
          "blockers": {
            "type": "array",
            "items": {}
          },
          "data": {
            "type": "object",
            "properties": {},
            "additionalProperties": {}
          }
        },
        "required": [
          "status",
          "code",
          "workspaceId",
          "filesScanned",
          "proposedFiles",
          "changedFiles",
          "diagnostics",
          "artifacts",
          "validation",
          "blockers",
          "data"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "optional"
      }
    },
    {
      "name": "hoi4.gui_render",
      "title": "Render scripted GUI artifacts",
      "description": "Render GUI states, resolutions, scenarios, hierarchy, comparisons, and diagnostics.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "default": "current",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "windowName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "scenario": {
            "description": "GUI preview scenario; optional date and controls {stateId: controllerTag}."
          },
          "states": {
            "maxItems": 14,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "normal",
                "hover",
                "selected",
                "locked",
                "disabled",
                "warning",
                "active",
                "completed",
                "empty-list",
                "full-list",
                "minimum-value",
                "maximum-value",
                "long-text",
                "missing-localisation"
              ]
            }
          },
          "resolutions": {
            "minItems": 1,
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 320,
                  "maximum": 16384
                },
                "height": {
                  "type": "integer",
                  "minimum": 200,
                  "maximum": 16384
                },
                "uiScale": {
                  "description": "In-game UI scale for this resolution. Use 1 at 1920x1080; do not use it to enlarge an artifact.",
                  "type": "number",
                  "minimum": 0.25,
                  "maximum": 4
                }
              },
              "required": [
                "width",
                "height"
              ],
              "additionalProperties": false
            }
          },
          "relatedScenarios": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "description": "GUI preview scenario; optional date and controls {stateId: controllerTag}."
            }
          },
          "generatedScenarios": {
            "description": "GUI generated-scenario options."
          },
          "comparisonScenario": {
            "description": "GUI preview scenario; optional date and controls {stateId: controllerTag}."
          },
          "sourceBaseline": {
            "description": "Previous mod-owned .gui source for a matched source comparison using the requested scenario.",
            "type": "object",
            "properties": {
              "relativePath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "source": {
                "type": "string",
                "maxLength": 33554432
              }
            },
            "required": [
              "relativePath",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "windowName",
          "scenario"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "blocked",
              "error"
            ]
          },
          "code": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "filesScanned": {
            "type": "array",
            "items": {}
          },
          "proposedFiles": {
            "type": "array",
            "items": {}
          },
          "changedFiles": {
            "type": "array",
            "items": {}
          },
          "diagnostics": {
            "maxItems": 20,
            "type": "array",
            "items": {}
          },
          "artifacts": {
            "maxItems": 32,
            "type": "array",
            "items": {}
          },
          "validation": {},
          "blockers": {
            "type": "array",
            "items": {}
          },
          "data": {
            "type": "object",
            "properties": {},
            "additionalProperties": {}
          }
        },
        "required": [
          "status",
          "code",
          "workspaceId",
          "filesScanned",
          "proposedFiles",
          "changedFiles",
          "diagnostics",
          "artifacts",
          "validation",
          "blockers",
          "data"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "optional"
      }
    },
    {
      "name": "hoi4.gui_rewrite",
      "title": "Create or clean up scripted GUI",
      "description": "Apply one validated source, helper, or exact-patch GUI package. Text dependencies use additionalFiles; binary art stays workspace-referenced.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "source",
              "helpers",
              "patches"
            ]
          },
          "workspaceId": {
            "default": "current",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "windowName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "scenario": {
            "description": "GUI preview scenario; optional date and controls {stateId: controllerTag}."
          },
          "requestKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "source": {
            "type": "string",
            "maxLength": 33554432
          },
          "helper": {
            "description": "GUI helper document."
          },
          "additionalFiles": {
            "maxItems": 31,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "relativePath": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "source": {
                  "type": "string",
                  "maxLength": 33554432
                }
              },
              "required": [
                "relativePath",
                "source"
              ],
              "additionalProperties": false
            }
          },
          "expectedSourceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "patches": {
            "minItems": 1,
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "end": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "expectedText": {
                  "type": "string",
                  "maxLength": 5000000
                },
                "text": {
                  "type": "string",
                  "maxLength": 5000000
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "required": [
                "start",
                "end",
                "expectedText",
                "text",
                "description"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "mode",
          "relativePath",
          "windowName",
          "scenario"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "blocked",
              "error"
            ]
          },
          "code": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "filesScanned": {
            "type": "array",
            "items": {}
          },
          "proposedFiles": {
            "type": "array",
            "items": {}
          },
          "changedFiles": {
            "type": "array",
            "items": {}
          },
          "diagnostics": {
            "maxItems": 20,
            "type": "array",
            "items": {}
          },
          "artifacts": {
            "maxItems": 32,
            "type": "array",
            "items": {}
          },
          "validation": {},
          "blockers": {
            "type": "array",
            "items": {}
          },
          "data": {
            "type": "object",
            "properties": {},
            "additionalProperties": {}
          }
        },
        "required": [
          "status",
          "code",
          "workspaceId",
          "filesScanned",
          "proposedFiles",
          "changedFiles",
          "diagnostics",
          "artifacts",
          "validation",
          "blockers",
          "data"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "optional"
      }
    },
    {
      "name": "hoi4.job_inspect",
      "title": "Inspect persistent job",
      "description": "Inspect a durable background operation. A completed job returns the original tool result; active and terminal non-result states return bounded status evidence.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "default": "current",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "jobId": {
            "type": "string",
            "pattern": "^job_[a-f0-9]{64}$"
          }
        },
        "required": [
          "jobId"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
