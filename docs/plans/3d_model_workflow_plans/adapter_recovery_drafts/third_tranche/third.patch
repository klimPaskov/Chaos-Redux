+    return finish_verified(req,h,job,source,output,{'operation':'bind_existing_pdx_material','source_material':source_name,'material':material.name,'material_spec_sha256':digest(p['material_spec']),'targets':{obj.name:slots for obj,slots in targets},'geometry_uvs_weights_rig_actions_and_old_materials_preserved':True,'status':'bound_requires_preview_and_export_texture_reference_review'})
