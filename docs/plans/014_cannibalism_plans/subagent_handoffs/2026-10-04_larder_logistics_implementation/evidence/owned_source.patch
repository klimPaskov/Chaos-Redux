+		data = fixed_point
+	}
+	capacity_base = 1200
+	capacity_per_controlled_state = 100
+	capacity_per_development_point = 50
+	distance_loss_divisor = 10000
+	distance_loss_maximum = 0.60
+	zero = 0
+	one = 1
+	minus_one = -1
+}
