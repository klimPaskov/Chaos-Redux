# Some fields in this file reject script-constant tokens.
# These file-scoped values mirror the authoritative shared constants.
@CR_SC_CBRN_OCCUPATION_DECISION_COST_PROTECTIVE_AID_FACTORIES = 2
@CR_SC_CBRN_OCCUPATION_DECISION_COST_PROTECTIVE_AID_PP_AI_HINT = 25
# Fixed AI saving hints mirror the two ordinary cover-up prices; the actual
# charge and eligibility still use the live Condemnation-scaled quote.
@CR_SC_CBRN_OCCUPATION_SEAL_STATE_PP_AI_HINT = 40
@CR_SC_CBRN_OCCUPATION_DESTROY_RECORDS_PP_AI_HINT = 60
# ============================================================================
# CHAOS REDUX - CBRN OCCUPATION DECISIONS
# ============================================================================
# Overview:
# - Authorizes protective occupation administration, delivers real
#   population-scaled respirator aid from a foreign stockpile, and resolves
#   exact-record concealment or disclosure choices.
# - The hidden coercive-authorization token is retained for occupation-law
#   compatibility. Sarin and Soman attacks are not decision actions.
# - Aid debits real stock; record choices use exact historical chemical
#   records and Condemnation-scaled Political Power for concealment.
# ============================================================================

cbrn_occupation_measures_category = {
	cbrn_authorize_coercive_security = {
		icon = GFX_decision_cbrn_authorize_coercive_security
		cost = constant:cbrn_occupation_decision_cost.authorize_coercive_security_pp
		fire_only_once = yes

		visible = {
			# The coercive selected-state route is retained only for migration.
			always = no
		}

		available = {
			custom_trigger_tooltip = {
				tooltip = cbrn_authorize_coercive_security_requirements_tt
				hidden_trigger = {
					cbrn_occupation_coercive_security_authorization_requirements = yes
				}
			}
		}

		complete_effect = {
			custom_effect_tooltip = cbrn_authorize_coercive_security_effect_tt
			hidden_effect = { cbrn_occupation_authorize_coercive_security = yes }
		}

		ai_will_do = {
			base = constant:cbrn_occupation_decision_ai.authorize_coercive_security
			modifier = {
				factor = constant:cbrn_occupation_decision_ai.disabled
				NOT = { cbrn_occupation_ai_coercive_route_requirements = yes }
			}
		}
	}

	cbrn_adopt_protected_occupation = {
		icon = GFX_decision_cbrn_adopt_protected_occupation
		cost = constant:cbrn_occupation_decision_cost.authorize_protected_administration_pp
		fire_only_once = yes

		visible = {
			NOT = { has_country_flag = cbrn_occupation_protected_administration_authorized }
			cbrn_occupation_protected_administration_authorization_requirements = yes
		}

		available = {
			custom_trigger_tooltip = {
				tooltip = cbrn_adopt_protected_occupation_requirements_tt
				hidden_trigger = {
					cbrn_occupation_protected_administration_authorization_requirements = yes
				}
			}
		}

		complete_effect = {
			custom_effect_tooltip = cbrn_adopt_protected_occupation_effect_tt
			hidden_effect = { cbrn_occupation_authorize_protected_administration = yes }
		}

		ai_will_do = {
			base = constant:cbrn_occupation_decision_ai.authorize_protected_administration
			modifier = {
				factor = constant:cbrn_occupation_decision_ai.defensive_inspection_factor
				cbrn_ai_has_defensive_cbrn_profile = yes
			}
		}
	}

	cbrn_deploy_protective_aid = {
		icon = GFX_decision_cbrn_deploy_protective_aid
		state_target = any
		on_map_mode = map_and_decisions_view
		ai_hint_pp_cost = @CR_SC_CBRN_OCCUPATION_DECISION_COST_PROTECTIVE_AID_PP_AI_HINT
		days_remove = constant:cbrn_occupation_timing.protective_aid_days
		days_re_enable = constant:cbrn_occupation_timing.protective_aid_reenable_days
		modifier = {
			civilian_factory_use = @CR_SC_CBRN_OCCUPATION_DECISION_COST_PROTECTIVE_AID_FACTORIES
		}

		target_root_trigger = {
			OR = {
				AND = {
	NOT = { is_actual_nonhuman_country = yes }
	has_country_flag = cbrn_program_established
	cbrn_country_has_any_mask_stock = yes
	NOT = {
		num_of_civilian_factories_available_for_projects < constant:cbrn_occupation_decision_cost.protective_aid_factories
	}
}
				check_variable = { cbrn_external_aid_active_reservations_count > constant:cbrn_math.zero }
			}
		}

		target_trigger = {
			FROM = {
				OR = {
					cbrn_occupation_state_can_receive_external_protective_aid = yes
					cbrn_occupation_state_has_donor_external_aid_reservation = yes
				}
			}
		}

		visible = {
			OR = {
				AND = {
	NOT = { is_actual_nonhuman_country = yes }
	has_country_flag = cbrn_program_established
	cbrn_country_has_any_mask_stock = yes
	NOT = {
		num_of_civilian_factories_available_for_projects < constant:cbrn_occupation_decision_cost.protective_aid_factories
	}
}
				FROM = { cbrn_occupation_state_has_donor_external_aid_reservation = yes }
			}
		}

		available = {
			hidden_trigger = { AND = {
	AND = {
	NOT = { is_actual_nonhuman_country = yes }
	has_country_flag = cbrn_program_established
	cbrn_country_has_any_mask_stock = yes
	NOT = {
		num_of_civilian_factories_available_for_projects < constant:cbrn_occupation_decision_cost.protective_aid_factories
	}
}
	black_friday_can_pay_cbrn_external_aid_pp_fee = yes
	FROM = { cbrn_occupation_state_can_receive_external_protective_aid = yes }
} }
		}
		custom_cost_trigger = { hidden_trigger = { AND = {
	AND = {
	NOT = { is_actual_nonhuman_country = yes }
	has_country_flag = cbrn_program_established
	cbrn_country_has_any_mask_stock = yes
	NOT = {
		num_of_civilian_factories_available_for_projects < constant:cbrn_occupation_decision_cost.protective_aid_factories
	}
}
	black_friday_can_pay_cbrn_external_aid_pp_fee = yes
	FROM = { cbrn_occupation_state_can_receive_external_protective_aid = yes }
} } }
		custom_cost_text = cbrn_deploy_protective_aid_cost

		complete_effect = {
			custom_effect_tooltip = cbrn_deploy_protective_aid_begin_tt
			hidden_effect = {
				FROM = {
					set_temp_variable = { cbrn_mask_reservation_quote = constant:cbrn_math.zero }
					if = {
						limit = {
							ROOT = {
								# Native selection may already commit the factories checked before the click.
								cbrn_occupation_country_can_continue_external_protective_aid = yes
								cbrn_country_has_any_mask_stock = yes
								black_friday_can_pay_cbrn_external_aid_pp_fee = yes
							}
							cbrn_occupation_state_can_receive_external_protective_aid = yes
							cbrn_quote_external_state_mask_reservation = yes
							check_variable = { cbrn_mask_reservation_quote > constant:cbrn_math.zero }
						}
						set_temp_variable = { cbrn_mask_escrow_requested = cbrn_mask_reservation_quote }
						set_temp_variable = { cbrn_mask_escrow_external = constant:cbrn_math.one }
						set_temp_variable = { cbrn_mask_escrow_completed = constant:cbrn_math.zero }
						cbrn_reserve_requested_masks_to_state = yes
						if = {
							limit = { check_variable = { cbrn_mask_escrow_completed > constant:cbrn_math.zero } }
							save_event_target_as = cbrn_external_aid_transaction_target_state
							ROOT = { black_friday_pay_cbrn_external_aid_pp_fee = yes }
						}
						if = {
							limit = {
								check_variable = { cbrn_mask_escrow_completed > constant:cbrn_math.zero }
								check_variable = { var = black_friday_cbrn_external_aid_pp_payment_success value = constant:universal_cost_framework.one compare = equals }
							}
							cbrn_occupation_register_external_aid_reservation = yes
							set_temp_variable = { cbrn_occupation_external_aid_days = constant:cbrn_occupation_timing.protective_aid_days }
							set_state_flag = { flag = cbrn_occupation_external_aid_project_active days = var:cbrn_occupation_external_aid_days }
						}
						if = {
							limit = {
								check_variable = { cbrn_mask_escrow_completed > constant:cbrn_math.zero }
								check_variable = { var = black_friday_cbrn_external_aid_pp_payment_success value = constant:universal_cost_framework.zero compare = equals }
							}
							cbrn_refund_external_state_mask_reservation = yes
						}
					}
				}
			}
		}

		remove_effect = {
			custom_effect_tooltip = cbrn_deploy_protective_aid_complete_tt
			hidden_effect = {
				FROM = {
					cbrn_occupation_close_external_aid_reservation = yes
					clr_state_flag = cbrn_occupation_external_aid_project_active
					save_event_target_as = cbrn_occupation_target_state
				}
				cbrn_occupation_execute_external_protective_aid = yes
				set_temp_variable = { black_friday_cbrn_external_aid_successful_completion = constant:universal_cost_framework.zero }
				if = {
					limit = {
						check_variable = {
							var = cbrn_occupation_protective_aid_proof
							value = constant:cbrn_proof.supplied
							compare = equals
						}
					}
					set_temp_variable = { black_friday_cbrn_external_aid_successful_completion = constant:universal_cost_framework.one }
				}
				FROM = { black_friday_settle_cbrn_external_aid_pp_fee_receipt = yes }
			}
		}

		cancel_trigger = {
			OR = {
				NOT = { cbrn_occupation_country_can_continue_external_protective_aid = yes }
				FROM = {
					OR = {
						NOT = { cbrn_occupation_state_has_donor_external_aid_reservation = yes }
						NOT = { cbrn_occupation_state_remains_external_protective_aid_target = yes }
					}
				}
			}
		}

		cancel_effect = {
			hidden_effect = {
				FROM = {
					cbrn_occupation_close_external_aid_reservation = yes
					cbrn_refund_external_state_mask_reservation = yes
					clr_state_flag = cbrn_occupation_external_aid_project_active
					set_temp_variable = { black_friday_cbrn_external_aid_successful_completion = constant:universal_cost_framework.zero }
					black_friday_settle_cbrn_external_aid_pp_fee_receipt = yes
				}
			}
		}

		ai_will_do = {
			base = constant:cbrn_occupation_decision_ai.protective_aid
			modifier = {
				factor = constant:cbrn_occupation_decision_ai.protective_aid_own_core_factor
				FROM = { is_core_of = ROOT }
			}
			modifier = {
				factor = constant:cbrn_occupation_decision_ai.protective_aid_allied_core_factor
				FROM = { owner = { is_in_faction_with = ROOT } }
			}
			modifier = {
				factor = constant:cbrn_occupation_decision_ai.protective_aid_trauma_factor
				FROM = {
					has_variable = cbrn_occupation_nerve_suppression_trauma
					check_variable = {
						cbrn_occupation_nerve_suppression_trauma > constant:cbrn_math.zero
					}
				}
			}
		}
	}

	cbrn_seal_state = {
		icon = GFX_decision_cbrn_seal_state
		state_target = any_controlled_state
		on_map_mode = map_and_decisions_view
		ai_hint_pp_cost = @CR_SC_CBRN_OCCUPATION_SEAL_STATE_PP_AI_HINT
		custom_cost_trigger = { hidden_trigger = { cbrn_occupation_can_pay_seal_state_pp = yes } }
		custom_cost_text = cbrn_seal_state_cost
		days_re_enable = constant:cbrn_occupation_timing.coverup_reenable_days

		target_root_trigger = {
			has_country_flag = cbrn_occupation_nerve_suppression_history
		}

		target_trigger = {
			FROM = { cbrn_occupation_state_can_start_coverup = yes }
		}

		available = {
			custom_trigger_tooltip = {
				tooltip = cbrn_seal_state_requirements_tt
				hidden_trigger = { FROM = { cbrn_occupation_state_can_start_coverup = yes } }
			}
			hidden_trigger = { cbrn_occupation_can_pay_seal_state_pp = yes }
		}

		complete_effect = {
			custom_effect_tooltip = cbrn_seal_state_effect_tt
			hidden_effect = {
				set_temp_variable = { cbrn_occupation_coverup_payment_action = constant:cbrn_occupation_coverup_action.seal_state }
				cbrn_occupation_execute_paid_coverup = yes
			}
		}

		ai_will_do = {
			base = constant:cbrn_occupation_decision_ai.seal_state
			modifier = {
				factor = constant:cbrn_occupation_decision_ai.disabled
				OR = {
					has_government = democratic
					NOT = { cbrn_ai_route_allows_first_use = yes }
				}
			}
		}
	}

	cbrn_destroy_contaminated_records = {
		icon = GFX_decision_cbrn_destroy_contaminated_records
		state_target = any_controlled_state
		on_map_mode = map_and_decisions_view
		ai_hint_pp_cost = @CR_SC_CBRN_OCCUPATION_DESTROY_RECORDS_PP_AI_HINT
		custom_cost_trigger = { hidden_trigger = { cbrn_occupation_can_pay_destroy_records_pp = yes } }
		custom_cost_text = cbrn_destroy_contaminated_records_cost
		days_re_enable = constant:cbrn_occupation_timing.coverup_reenable_days

		target_root_trigger = {
			has_country_flag = cbrn_occupation_nerve_suppression_history
		}

		target_trigger = {
			FROM = { cbrn_occupation_state_can_start_coverup = yes }
		}

		available = {
			custom_trigger_tooltip = {
				tooltip = cbrn_destroy_contaminated_records_requirements_tt
				hidden_trigger = { FROM = { cbrn_occupation_state_can_start_coverup = yes } }
			}
			hidden_trigger = { cbrn_occupation_can_pay_destroy_records_pp = yes }
		}

		complete_effect = {
			custom_effect_tooltip = cbrn_destroy_contaminated_records_effect_tt
			hidden_effect = {
				set_temp_variable = { cbrn_occupation_coverup_payment_action = constant:cbrn_occupation_coverup_action.destroy_records }
				cbrn_occupation_execute_paid_coverup = yes
			}
		}

		ai_will_do = {
			base = constant:cbrn_occupation_decision_ai.destroy_records
			modifier = {
				factor = constant:cbrn_occupation_decision_ai.disabled
				NOT = { cbrn_ai_route_allows_unrestricted_use = yes }
			}
		}
	}

	cbrn_admit_accidental_release = {
		icon = GFX_decision_cbrn_admit_accidental_release
		state_target = any
		on_map_mode = map_and_decisions_view
		cost = constant:cbrn_occupation_decision_cost.admit_release_pp
		days_re_enable = constant:cbrn_occupation_timing.coverup_reenable_days

		target_root_trigger = {
			has_country_flag = cbrn_occupation_nerve_suppression_history
		}

		target_trigger = {
			FROM = { cbrn_occupation_state_can_admit_release = yes }
		}

		available = {
			custom_trigger_tooltip = {
				tooltip = cbrn_admit_accidental_release_requirements_tt
				hidden_trigger = { FROM = { cbrn_occupation_state_can_admit_release = yes } }
			}
		}

		complete_effect = {
			custom_effect_tooltip = cbrn_admit_accidental_release_effect_tt
			hidden_effect = {
				FROM = {
					set_variable = {
						cbrn_occupation_requested_coverup_action = constant:cbrn_occupation_coverup_action.admit_accident
					}
					cbrn_occupation_apply_requested_coverup_action = yes
					clear_variable = cbrn_occupation_requested_coverup_action
				}
			}
		}

		ai_will_do = {
			base = constant:cbrn_occupation_decision_ai.admit_release
			modifier = {
				factor = constant:cbrn_occupation_decision_ai.defensive_inspection_factor
				OR = {
					has_government = democratic
					cbrn_ai_has_defensive_cbrn_profile = yes
				}
			}
		}
	}

	cbrn_permit_inspection = {
		icon = GFX_decision_cbrn_permit_inspection
		state_target = any_controlled_state
		on_map_mode = map_and_decisions_view
		cost = constant:cbrn_occupation_decision_cost.permit_inspection_pp
		days_re_enable = constant:cbrn_occupation_timing.coverup_reenable_days

		target_root_trigger = {
			has_country_flag = cbrn_occupation_nerve_suppression_history
		}

		target_trigger = {
			FROM = { cbrn_occupation_state_can_permit_inspection = yes }
		}

		available = {
			custom_trigger_tooltip = {
				tooltip = cbrn_permit_inspection_requirements_tt
				hidden_trigger = { FROM = { cbrn_occupation_state_can_permit_inspection = yes } }
			}
		}

		complete_effect = {
			custom_effect_tooltip = cbrn_permit_inspection_effect_tt
			hidden_effect = {
				FROM = {
					set_variable = {
						cbrn_occupation_requested_coverup_action = constant:cbrn_occupation_coverup_action.permit_inspection
					}
					cbrn_occupation_apply_requested_coverup_action = yes
					clear_variable = cbrn_occupation_requested_coverup_action
				}
			}
		}

		ai_will_do = {
			base = constant:cbrn_occupation_decision_ai.permit_inspection
			modifier = {
				factor = constant:cbrn_occupation_decision_ai.defensive_inspection_factor
				cbrn_ai_has_defensive_cbrn_profile = yes
			}
			modifier = {
				factor = constant:cbrn_occupation_decision_ai.high_condemnation_inspection_factor
				condemnation_is_formally_censured = yes
			}
		}
	}
}
