digraph G {
graph [fontname="DejaVu Sans", fontsize=20, labelloc=t, labeljust=l, bgcolor="white", ranksep=0.7, nodesep=0.35, pad=0.35, splines=polyline]
node [shape=box, style="rounded,filled", fillcolor="#f3f5f1", color="#72806c", fontname="DejaVu Sans", fontsize=12, margin="0.18,0.12"]
edge [color="#677361", arrowsize=0.7, fontname="DejaVu Sans", fontsize=10]

label="071 PERSIA | FOCUS ARCHITECTURE
Branch relationships and working labels, not a final in-game layout"
root [label="Persian restoration
Actual opening force granted once", fillcolor="#dce6d4"]
review [label="Military review and
provisional authority"]
base [label="Homeland recovery
and supply preparation"]
choice [label="Political settlement
Choose one main route", fillcolor="#e9e2cd"]
a [label="THE ACHAEMENID LEGACY
Charters and regional assembly", fillcolor="#e9e2cd"]
s [label="THE SASANIAN RESTORATION
Central and frontier commands", fillcolor="#e9e2cd"]
m [label="THE NEW PERSIAN EMPIRE
Industry, clients and security", fillcolor="#e9e2cd"]
a1 [label="Western / eastern networks
Roads, satrapies, representation"]
s1 [label="Western / northern / eastern fronts
Supply, armor, command oversight"]
m1 [label="Domestic production / concessions
Oil, investment, access agreements"]
a2 [label="Chartered imperial network"]
s2 [label="Functioning command system"]
m2 [label="Industrial imperial bloc"]
shared [label="SHARED DEVELOPMENT
Industry, regular army, air force, navy
Logistics, Immortals, capitals, reconstruction", fillcolor="#e5e9ec"]
e1 [label="Evolution I | Chaos 200+
Specialized satrapies and court disputes"]
e2 [label="Evolution II | Chaos 400+
Advanced paid guard institutions"]
e3 [label="Evolution III | Chaos 600+
Supremacy after route success
Submission, tribute, guarantees"]
crisis [label="CONSEQUENTIAL FAILURE
Lost center, charter coalition
Command split, failed client obligations", fillcolor="#eee0dc"]
recovery [label="Recovery or a reduced empire
Persistent history, no repeated army grant", fillcolor="#eee0dc"]
root -> review
review -> base
review -> choice
review -> shared [style=dashed, label="parallel access"]
choice -> a
choice -> s
choice -> m
{rank=same a s m}
a -> a1 -> a2
s -> s1 -> s2
m -> m1 -> m2
{rank=same a1 s1 m1}
{rank=same a2 s2 m2}
a2 -> e3
s2 -> e3
m2 -> e3
shared -> e1 [style=dashed, label="available extensions"]
e1 -> e2 [style=dashed]
e2 -> e3 [style=dashed, label="cumulative, no repeat grant"]
base -> crisis [style=dashed, label="actual defeat"]
a2 -> crisis [style=dashed]
s2 -> crisis [style=dashed]
m2 -> crisis [style=dashed]
crisis -> recovery
