# Chaos Redux mutant zombie entity: a lanky, eyeless creature with a split jaw.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the measured phase it voices.

entity = {
	name = "chaosx_mutant_zombies_entity"
	pdxmesh = "chaosx_mutant_zombies_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Head-first bite with trapping arms: reach peaks at frames 17-19 and 77-88.
		event = { time = 0.3000 sound = { soundeffect = "chaosx_mutant_zombie_attack" } }
		event = { time = 0.5000 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 2.4667 sound = { soundeffect = "chaosx_mutant_zombie_attack" } }
		event = { time = 2.8333 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Doubled over by a blow to the waist at frame 10.
		event = { time = 0.3000 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# Both arms slam the ground at frame 16, rake back by 57, then the roar.
		event = { time = 0.4333 sound = { soundeffect = "chaosx_base_zombie_body_fall" } }
		event = { time = 1.8000 sound = { soundeffect = "chaosx_mutant_zombie_roar" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Limping plants: left 22 and 30, right 42.
		event = { time = 0.7000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 0.9667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.3667 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { time = 0.1667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 0.7333 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.3667 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Knocked down: the torso drops through frames 14-19 and lands at 20.
		event = { time = 0.0667 node = "Head" particle = "blood_particle" }
		event = { time = 0.0667 sound = { soundeffect = "chaosx_mutant_zombie_roar" } }
		event = { time = 0.6333 sound = { soundeffect = "chaosx_base_zombie_body_fall" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "chaosx_zombie_idle" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Crouching roar with the arms flung wide at frame 27.
		event = { time = 0.4000 sound = { soundeffect = "chaosx_mutant_zombie_roar" } }
	}

	# The mesh keeps the vanilla infantry source height, so the vanilla entity scale applies once.
	scale = 0.8
}
