# Chaos Redux oracle recon entity: a bone-armoured seer carrying a skull-crowned staff.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the measured phase it voices.

entity = {
	name = "chaosx_oracle_recon_entity"
	pdxmesh = "chaosx_oracle_recon_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Raises the staff overhead at frame 11, points it forward and sweeps a circle, peaking at frame 63.
		event = { time = 0.2667 sound = { soundeffect = "chaosx_oracle_recon_recon_sfx" } }
		event = { time = 2.0000 sound = { soundeffect = "chaosx_oracle_recon_recon_sfx" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Gathers a warding charge and releases it with the staff at frame 50.
		event = { time = 0.1667 sound = { soundeffect = "chaosx_oracle_recon_observation_sfx" } }
		event = { time = 1.6333 sound = { soundeffect = "chaosx_oracle_recon_recon_sfx" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# Prostrates beside the planted staff and receives a vision, rising after frame 100.
		event = { time = 0.1000 sound = { soundeffect = "chaosx_oracle_recon_observation_sfx" } }
		event = { time = 2.2000 sound = { soundeffect = "chaosx_oracle_recon_observation_sfx" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# A slow walk that pauses to look around; plants measured across the 715-frame loop.
		event = { time = 2.6000 sound = { soundeffect = "chaosx_oracle_recon_move_sfx" } }
		event = { time = 3.8000 sound = { soundeffect = "chaosx_oracle_recon_move_sfx" } }
		event = { time = 5.6333 sound = { soundeffect = "chaosx_oracle_recon_move_sfx" } }
		event = { time = 6.3333 sound = { soundeffect = "chaosx_oracle_recon_move_sfx" } }
		event = { time = 8.0667 sound = { soundeffect = "chaosx_oracle_recon_move_sfx" } }
		event = { time = 9.0667 sound = { soundeffect = "chaosx_oracle_recon_move_sfx" } }
		event = { time = 10.2667 sound = { soundeffect = "chaosx_oracle_recon_move_sfx" } }
		event = { time = 11.4333 sound = { soundeffect = "chaosx_oracle_recon_move_sfx" } }
		event = { time = 13.4000 sound = { soundeffect = "chaosx_oracle_recon_move_sfx" } }
		event = { time = 14.1667 sound = { soundeffect = "chaosx_oracle_recon_move_sfx" } }
		event = { time = 15.5667 sound = { soundeffect = "chaosx_oracle_recon_move_sfx" } }
		event = { time = 17.2333 sound = { soundeffect = "chaosx_oracle_recon_move_sfx" } }
		event = { time = 18.4000 sound = { soundeffect = "chaosx_oracle_recon_move_sfx" } }
		event = { time = 19.2000 sound = { soundeffect = "chaosx_oracle_recon_move_sfx" } }
		event = { time = 22.0000 sound = { soundeffect = "chaosx_oracle_recon_move_sfx" } }
		event = { time = 22.1667 sound = { soundeffect = "chaosx_oracle_recon_move_sfx" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Limping backward: plants at frames 4, 13, 31 and 43.
		event = { time = 0.1000 sound = { soundeffect = "chaosx_oracle_recon_move_sfx" } }
		event = { time = 0.4000 sound = { soundeffect = "chaosx_oracle_recon_move_sfx" } }
		event = { time = 1.0000 sound = { soundeffect = "chaosx_oracle_recon_move_sfx" } }
		event = { time = 1.4000 sound = { soundeffect = "chaosx_oracle_recon_move_sfx" } }
	}
	state = {
		name = "deploy"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		event = { time = 0.1000 sound = { soundeffect = "chaosx_oracle_recon_observation_sfx" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Dying backward; the body lands at frame 35 with the staff laid along the ground.
		event = { time = 0.1000 node = "Head" particle = "blood_particle" keep_particle = yes }
		event = { time = 0.1000 sound = { soundeffect = "chaosx_oracle_recon_death_sfx" } }
		event = { time = 1.1333 sound = { soundeffect = "chaosx_oracle_recon_move_sfx" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "chaosx_oracle_recon_idle_sfx" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Spell-casting drill: both hands thrust out at frame 37.
		event = { time = 1.2000 sound = { soundeffect = "chaosx_oracle_recon_recon_sfx" } }
	}

	# The mesh keeps the vanilla infantry source height, so the vanilla entity scale applies once.
	scale = 0.8
}
