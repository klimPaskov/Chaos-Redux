# Event 014 custom cannibal unit entities and action-synchronised audio.

entity = {
	name = "cannibal_feast_guard_entity"
	pdxmesh = "cannibal_feast_guard_mesh"
	default_state = "idle"

	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "cannibal_feast_guard_idle_vocal_sfx" } }
