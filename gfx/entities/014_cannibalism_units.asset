		event = { time = 2.3333 sound = { soundeffect = "cannibal_feast_guard_weapon_attack_sfx" } }
		event = { time = 3.5000 sound = { soundeffect = "cannibal_feast_guard_weapon_impact_sfx" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = yes
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		event = { time = 3.9167 sound = { soundeffect = "cannibal_feast_guard_weapon_attack_sfx" } }
		event = { time = 5.8333 sound = { soundeffect = "cannibal_feast_guard_weapon_impact_sfx" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = yes
		event = { time = 0.0417 sound = { soundeffect = "cannibal_feast_guard_movement_sfx" } }
		event = { time = 0.9167 sound = { soundeffect = "cannibal_feast_guard_movement_sfx" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = yes
		event = { time = 1.7500 sound = { soundeffect = "cannibal_feast_guard_training_sfx" } }
	}
	state = {
		name = "death"
