	clone = "resources_found_cave_monster_entity"
	name = "cave_burrow_war_brood_entity"
}

entity = {
	clone = "resources_found_cave_monster_entity"
	name = "cave_scree_tide_brood_entity"
}

entity = {
	clone = "resources_found_cave_monster_entity"
	name = "cave_anchor_guard_brood_entity"
}
