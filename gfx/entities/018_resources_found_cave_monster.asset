# Event 018 Oth-Kesh cave-monster entity: a stone-plated quadruped with magma seams, on its own creature skeleton.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the authored beat it voices.

entity = {
	name = "resources_found_cave_monster_entity"
	pdxmesh = "resources_found_cave_monster_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Crouches on its haunches at frame 12, lunges, and snaps its jaws down at frame 24.
		event = { time = 0.3667 sound = { soundeffect = "resources_found_cave_monster_move_foot_02" } }
		event = { time = 0.7667 sound = { soundeffect = "resources_found_cave_monster_attack_bounded" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Drops low behind its plated shoulders by frame 15, head down, and growls.
		event = { time = 0.4667 sound = { soundeffect = "resources_found_cave_monster_growl" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# Rears onto its hind legs by frame 18, slams both forelimbs down at frame 30, and roars at frame 45.
		event = { time = 0.9667 sound = { soundeffect = "resources_found_cave_monster_move_foot_04" } }
		event = { time = 1.0000 sound = { soundeffect = "resources_found_cave_monster_attack_bounded" } }
		event = { time = 1.4667 sound = { soundeffect = "resources_found_cave_monster_growl" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Four-beat walk: rear right, front left, rear left, front right touch down at frames 1, 11, 21, and 31.
		event = { time = 0.0000 sound = { soundeffect = "resources_found_cave_monster_move_foot_01" } }
		event = { time = 0.3333 sound = { soundeffect = "resources_found_cave_monster_move_foot_02" } }
		event = { time = 0.6667 sound = { soundeffect = "resources_found_cave_monster_move_foot_03" } }
		event = { time = 1.0000 sound = { soundeffect = "resources_found_cave_monster_move_foot_04" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# The walk played backward: feet touch down on the same four beats.
		event = { time = 0.0000 sound = { soundeffect = "resources_found_cave_monster_move_foot_03" } }
		event = { time = 0.3333 sound = { soundeffect = "resources_found_cave_monster_move_foot_04" } }
		event = { time = 0.6667 sound = { soundeffect = "resources_found_cave_monster_move_foot_01" } }
		event = { time = 1.0000 sound = { soundeffect = "resources_found_cave_monster_move_foot_02" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Staggers, then collapses onto its belly with the legs splayed by frame 35.
		event = { time = 0.1000 sound = { soundeffect = "resources_found_cave_monster_death_bounded" } }
		event = { time = 1.1333 sound = { soundeffect = "resources_found_cave_monster_body_slam" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "resources_found_cave_monster_idle" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Paws the ground with the right forelimb at frame 30, roars at frame 45, then paws with the left at frame 70.
		event = { time = 0.9667 sound = { soundeffect = "resources_found_cave_monster_move_foot_02" } }
		event = { time = 1.4667 sound = { soundeffect = "resources_found_cave_monster_growl" } }
		event = { time = 2.3000 sound = { soundeffect = "resources_found_cave_monster_move_foot_03" } }
	}

	# The mesh keeps its calibrated source size, so the vanilla entity scale applies once.
	scale = 0.8
}

# The unit system resolves each sub-unit sprite through <sprite>_entity. Keep
# one canonical authored entity and expose lightweight aliases for the five
# role-specific counter identities.
entity = {
	clone = "resources_found_cave_monster_entity"
	name = "cave_monster_brood_entity"
}

entity = {
	clone = "resources_found_cave_monster_entity"
	name = "cave_stone_phalanx_brood_entity"
}

