# Load-order bridge for clone aliases that inherit installed German infantry.
# The zz prefix ensures the vanilla parent entities are registered first.

entity = { clone = "GER_infantry_entity" name = "aryan_clone_infantry_entity" }
entity = { clone = "GER_infantry_entity_snow" name = "aryan_clone_infantry_entity_snow" }
entity = { clone = "GER_infantry_entity_desert" name = "aryan_clone_infantry_entity_desert" }
