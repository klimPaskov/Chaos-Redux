		animation = { id = "retreat" type = "chaosx_zombies_retreat_animation" }
		animation = { id = "training" type = "chaosx_zombies_training_animation" }
		animation = { id = "death" type = "chaosx_zombies_death_animation" }

		meshsettings = {
			name = "char1.003"
