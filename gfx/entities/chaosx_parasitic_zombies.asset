# Chaos Redux parasitic zombie entity: a woman overtaken by a tentacled parasite.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the measured phase it voices.

entity = {
	name = "chaosx_parasitic_zombies_entity"
	pdxmesh = "chaosx_parasitic_zombies_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Pulled forward in whipping lashes: peaks at frames 18-19 and 86-92.
		event = { time = 0.2000 sound = { soundeffect = "chaosx_parasitic_zombie_gurgle" } }
		event = { time = 0.5333 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 2.8333 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Spasms as if shocked from frame 14 onward.
		event = { time = 0.4333 sound = { soundeffect = "chaosx_parasitic_zombie_gurgle" } }
		event = { time = 2.6667 sound = { soundeffect = "chaosx_parasitic_zombie_gurgle" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# The back arches as the parasite pushes outward, peaking at frames 57-60 and 77-84.
		event = { time = 0.8000 sound = { soundeffect = "chaosx_parasitic_zombie_feed" } }
		event = { time = 1.8000 sound = { soundeffect = "chaosx_parasitic_zombie_gurgle" } }
		event = { time = 2.4667 sound = { soundeffect = "chaosx_parasitic_zombie_feed" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Monster-walk plants: left 19, 54, 101; right 31, 73, 114.
		event = { time = 0.6000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.0000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.7667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 2.4000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 3.3333 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 3.8000 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { time = 0.1667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 0.3667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.1000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.3667 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Strangled from within: sags, staggers at 1.4 s and lands near 3.6 s.
		event = { time = 0.1000 node = "Head" particle = "blood_particle" }
		event = { time = 0.1000 sound = { soundeffect = "chaosx_parasitic_zombie_gurgle" } }
		event = { time = 1.4000 sound = { soundeffect = "chaosx_parasitic_zombie_gurgle" } }
		event = { time = 3.6000 sound = { soundeffect = "chaosx_base_zombie_body_fall" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "chaosx_parasitic_zombie_ambient" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Crouching scream with the tentacles flared at frame 25-27.
		event = { time = 0.4000 sound = { soundeffect = "chaosx_parasitic_zombie_gurgle" } }
	}

	# The mesh keeps the vanilla infantry source height, so the vanilla entity scale applies once.
	scale = 0.8
}
