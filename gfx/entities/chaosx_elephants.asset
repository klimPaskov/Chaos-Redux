# Event 012 shared elephant entity. The parent unit definitions may consume this
# entity through a shared sprite; no second body is created for logistics/shock.

entity = {
	name = "chaosx_elephant_shared_base_entity"
	pdxmesh = "chaosx_elephant_shared_base_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		event = { sound = { soundeffect = "chaosx_elephant_attack_call" } }
	}
	state = {
		name = "defend"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		event = { sound = { soundeffect = "chaosx_elephant_attack_call" } }
	}
	state = {
		name = "support_attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		event = { sound = { soundeffect = "chaosx_elephant_attack_call" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.8
		animation_speed = 1.0
		looping = yes
		event = { sound = { soundeffect = "chaosx_elephant_move_contact" } }
	}
	state = {
		name = "deploy"
		animation = "deploy"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "idle"
	}
	state = {
		name = "supply_load"
		animation = "supply_load"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		event = { time = 0.8333 sound = { soundeffect = "chaosx_elephant_supply_load_creak" } }
	}
	state = {
		name = "retreat"
		animation = "move"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { sound = { soundeffect = "chaosx_elephant_move_contact" } }
	}
	state = {
		name = "death"
		animation = "impact"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		event = { sound = { soundeffect = "chaosx_elephant_death_call" } }
		event = { time = 0.5 sound = { soundeffect = "chaosx_elephant_impact_contact" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { sound = { soundeffect = "chaosx_elephant_idle_call" } }
	}
	state = {
		name = "training"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
	}

	# The rider was calibrated at vanilla infantry source height and this entity
	# preserves the installed infantry rider scale exactly once.
	scale = 0.8
}
