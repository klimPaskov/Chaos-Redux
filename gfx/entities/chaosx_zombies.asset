# Chaos Redux base zombie unit entity: an undead infantryman in a rotting field uniform.
# Combat contacts use the exported action timing: attack/defend at 30 FPS and support attack at 60 FPS.

entity = {
	name = "chaosx_zombies_entity"
	pdxmesh = "chaosx_zombies_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Step into the grab at frame 26.5, pull at 34, then rake downward at 70.
		event = { time = 0.2000 sound = { soundeffect = "chaosx_base_zombie_lunge" } }
		event = { time = 0.6500 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 0.8333 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 1.6500 sound = { soundeffect = "chaosx_base_zombie_attack_growl" } }
		event = { time = 2.2833 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 3.1833 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Brace at frame 17, then counter-shove contact at frame 33.
		event = { trigger_once = yes sound = { soundeffect = "chaosx_zombie_ambient" } }
		event = { time = 0.5167 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 1.0500 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# Alternating claw contacts at native reimport frames 45 and 85 (60 FPS).
		event = { time = 0.2000 sound = { soundeffect = "chaosx_base_zombie_lunge" } }
		event = { time = 0.7167 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 1.3833 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Mummy stagger plants at frames 19, 43, 65, 93, 116, and 144.
		event = { time = 0.6000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.4000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 2.1333 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 3.0667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 3.8333 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 4.7667 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Backward limp plants at frames 6, 13, and 35.
		event = { time = 0.1667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 0.4000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.1333 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Shot backward from the first frames; the torso strikes the ground at frame 65.
		event = { time = 0.1000 node = "Head" particle = "blood_particle" }
		event = { time = 0.1000 sound = { soundeffect = "chaosx_base_zombie_defeated" } }
		event = { time = 2.1333 sound = { soundeffect = "chaosx_base_zombie_body_fall" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "chaosx_zombie_ambient" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Crouching scream: the arms spread widest at frame 27.
		event = { time = 0.4000 sound = { soundeffect = "chaosx_base_zombie_attack_growl" } }
	}

	# The mesh keeps the vanilla infantry source height, so the vanilla entity scale applies once.
	scale = 0.8
}
