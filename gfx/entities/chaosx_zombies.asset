# Chaos Redux base zombie unit entity.
# Actions run at 30 FPS; each event time is (action frame - 1) / 30 at the measured phase it voices.

entity = {
	name = "chaosx_zombies_entity"
	pdxmesh = "chaosx_zombies_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Two-handed claw lunge: the growl builds into the grabs at frames 49 and 75.
		event = { time = 1.0000 sound = { soundeffect = "chaosx_base_zombie_attack_growl" } }
		event = { time = 1.6000 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 2.4667 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Forearm shield: the counter-deflect lands at frame 27.
		event = { trigger_once = yes sound = { soundeffect = "chaosx_zombie_idle" } }
		event = { time = 0.8667 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# Grab and bite: the jaw closes at frames 24 and 54.
		event = { time = 0.5000 sound = { soundeffect = "chaosx_base_zombie_lunge" } }
		event = { time = 0.7667 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 1.7667 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Shamble plants: right at frames 17 and 39, left at 28 and 46.
		event = { time = 0.5333 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 0.9000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.2333 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.5000 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Backward stagger plants: left at frames 11 and 30, right at 16.
		event = { time = 0.3333 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 0.5000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 0.9667 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# The hit lands at frame 8 and the body strikes the ground at frame 53.
		event = { time = 0.2333 node = "Head" particle = "blood_particle" keep_particle = yes }
		event = { time = 0.2333 sound = { soundeffect = "chaosx_base_zombie_defeated" } }
		event = { time = 1.7333 sound = { soundeffect = "chaosx_base_zombie_body_fall" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "chaosx_zombie_idle" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Claw swipes peak at frames 38 and 77, the lunge at 111, and feeding begins at 131.
		event = { time = 1.0000 sound = { soundeffect = "chaosx_base_zombie_attack_growl" } }
		event = { time = 3.4000 sound = { soundeffect = "chaosx_base_zombie_lunge" } }
		event = { time = 4.3333 sound = { soundeffect = "chaosx_base_zombie_eating" } }
	}

	# The mesh keeps the vanilla infantry source height, so the vanilla entity scale applies once.
	scale = 0.8
}
