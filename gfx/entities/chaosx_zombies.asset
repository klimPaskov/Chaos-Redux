# Chaos Redux base zombie unit entity: an undead infantryman in a rotting field uniform.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the measured phase it voices.

entity = {
	name = "chaosx_zombies_entity"
	pdxmesh = "chaosx_zombies_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Lurching grab: the growl leads the reach peaks at frames 24, 46, and 74.
		event = { time = 0.3333 sound = { soundeffect = "chaosx_base_zombie_attack_growl" } }
		event = { time = 0.7000 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 1.4333 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 2.3667 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# The hit lands at the frame 14 recoil.
		event = { trigger_once = yes sound = { soundeffect = "chaosx_zombie_idle" } }
		event = { time = 0.4333 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# Grab at frame 39, pull in at 63, and tear with the bite from frame 70.
		event = { time = 0.6000 sound = { soundeffect = "chaosx_base_zombie_lunge" } }
		event = { time = 1.2000 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 2.0000 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 2.2333 sound = { soundeffect = "chaosx_base_zombie_eating" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Mummy stagger plants at frames 19, 43, 65, 93, 116, and 144.
		event = { time = 0.6000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.4000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 2.1333 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 3.0667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 3.8333 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 4.7667 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Backward limp plants at frames 6, 13, and 35.
		event = { time = 0.1667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 0.4000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.1333 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Shot backward from the first frames; the torso strikes the ground at frame 65.
		event = { time = 0.1000 node = "Head" particle = "blood_particle" }
		event = { time = 0.1000 sound = { soundeffect = "chaosx_base_zombie_defeated" } }
		event = { time = 2.1333 sound = { soundeffect = "chaosx_base_zombie_body_fall" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "chaosx_zombie_idle" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Crouching scream: the arms spread widest at frame 27.
		event = { time = 0.4000 sound = { soundeffect = "chaosx_base_zombie_attack_growl" } }
	}

	# The mesh keeps the vanilla infantry source height, so the vanilla entity scale applies once.
	scale = 0.8
}
