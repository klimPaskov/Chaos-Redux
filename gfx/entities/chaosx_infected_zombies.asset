# Chaos Redux infected zombie entity: a feverish, rotting man in a torn long coat.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the measured phase it voices.

entity = {
	name = "chaosx_infected_zombies_entity"
	pdxmesh = "chaosx_infected_zombies_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Clumsy overhead claws: right strike peaks at frame 28-38, left at 69-80.
		event = { time = 0.4000 sound = { soundeffect = "chaosx_infected_zombie_attack" } }
		event = { time = 1.1667 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 2.2000 sound = { soundeffect = "chaosx_infected_zombie_attack" } }
		event = { time = 2.5667 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Jerks under repeated hits from frame 10 onward.
		event = { time = 0.3000 sound = { soundeffect = "chaosx_infected_zombie_pain" } }
		event = { time = 1.5000 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# Doubles over retching, then straightens and spits forward near frame 85.
		event = { time = 0.3000 sound = { soundeffect = "chaosx_infected_zombie_pain" } }
		event = { time = 1.2000 sound = { soundeffect = "chaosx_infected_zombie_pain" } }
		event = { time = 2.7333 sound = { soundeffect = "chaosx_infected_zombie_attack" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Limping plants: left 14 and 48, right 27 and 63.
		event = { time = 0.4333 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 0.8667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.5667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 2.0667 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { time = 0.1667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 0.4000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.2667 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Shot and sinking backward; the body lands near frame 80.
		event = { time = 0.1000 node = "Head" particle = "blood_particle" }
		event = { time = 0.1000 sound = { soundeffect = "chaosx_infected_zombie_pain" } }
		event = { time = 2.6333 sound = { soundeffect = "chaosx_base_zombie_body_fall" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Scratches feverishly at the head and neck.
		event = { trigger_once = yes sound = { soundeffect = "chaosx_zombie_idle" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Catching its breath between coughing fits.
		event = { time = 1.2000 sound = { soundeffect = "chaosx_infected_zombie_pain" } }
		event = { time = 3.9667 sound = { soundeffect = "chaosx_infected_zombie_pain" } }
	}

	# The mesh keeps the vanilla infantry source height, so the vanilla entity scale applies once.
	scale = 0.8
}
