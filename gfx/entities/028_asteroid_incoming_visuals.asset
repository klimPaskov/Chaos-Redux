# Event 028 presentation aliases reuse the complete vanilla blast packages.
# Starting the attack state emits their existing particles, lights and sound.
# These are graphical objects, not bomb types, raids or nuclear detonations.
entity = {
	clone = "nuke_big_entity"
	name = "asteroid_incoming_main_visual_entity"
	default_state = "attack"
}

entity = {
	clone = "nuke_entity"
	name = "asteroid_incoming_fragment_visual_entity"
	default_state = "attack"
}
