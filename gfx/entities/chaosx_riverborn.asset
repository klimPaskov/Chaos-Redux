# Chaos Redux riverborn entity: a river-spirit warrior in a feathered water cloak with a spear and a spiral bronze shield.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the measured phase it voices.

entity = {
	name = "riverborn_entity"
	pdxmesh = "chaosx_riverborn_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Steps in at frame 50 and thrusts twice from behind the shield at frames 54 and 68.
		event = { time = 1.5667 sound = { soundeffect = "chaosx_riverborn_move_sfx" } }
		event = { time = 1.7000 sound = { soundeffect = "chaosx_riverborn_attack_sfx" } }
		event = { time = 2.1667 sound = { soundeffect = "chaosx_riverborn_attack_sfx" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Braces at frame 21 and drives the shield forward at frame 34.
		event = { time = 0.6667 sound = { soundeffect = "chaosx_riverborn_move_sfx" } }
		event = { time = 1.1000 sound = { soundeffect = "chaosx_riverborn_attack_sfx" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# A long step at frame 49, then the spear is hurled overhand at frame 55.
		event = { time = 1.5333 sound = { soundeffect = "chaosx_riverborn_move_sfx" } }
		event = { time = 1.7333 sound = { soundeffect = "chaosx_riverborn_attack_sfx" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Spear-walk plants: left 11, right 28.
		event = { time = 0.3333 sound = { soundeffect = "chaosx_riverborn_move_sfx" } }
		event = { time = 0.9000 sound = { soundeffect = "chaosx_riverborn_move_sfx" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Backing away behind the shield: plants at frames 11 and 26.
		event = { time = 0.3333 sound = { soundeffect = "chaosx_riverborn_move_sfx" } }
		event = { time = 0.8333 sound = { soundeffect = "chaosx_riverborn_move_sfx" } }
	}
	state = {
		name = "deploy"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		# Rises from the water and cuts the air with the spear at frame 25.
		event = { time = 0.1000 sound = { soundeffect = "chaosx_riverborn_water_transition_sfx" } }
		event = { time = 0.8000 sound = { soundeffect = "chaosx_riverborn_attack_sfx" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Shot, staggering forward; the body lands near frame 46.
		event = { time = 0.1000 node = "Head" particle = "blood_particle" keep_particle = yes }
		event = { time = 0.1000 sound = { soundeffect = "chaosx_riverborn_death_sfx" } }
		event = { time = 1.5000 sound = { soundeffect = "chaosx_riverborn_water_transition_sfx" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "chaosx_riverborn_idle_sfx" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Thrust-and-slash drill: the spear strikes at frames 25 and 43.
		event = { time = 0.8000 sound = { soundeffect = "chaosx_riverborn_attack_sfx" } }
		event = { time = 1.4000 sound = { soundeffect = "chaosx_riverborn_attack_sfx" } }
	}

	# The mesh keeps the vanilla infantry source height, so the vanilla entity scale applies once.
	scale = 0.8
}
