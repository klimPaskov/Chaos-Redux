# Chaos Redux riverborn entity: a river-spirit warrior in a feathered water cloak with a spear and a spiral bronze shield.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the measured phase it voices.

entity = {
	name = "riverborn_entity"
	pdxmesh = "chaosx_riverborn_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Coils back at frame 18, steps into a lunge thrust at frame 30, coils again and thrusts at frame 74.
		event = { time = 0.7667 sound = { soundeffect = "chaosx_riverborn_move_sfx" } }
		event = { time = 0.9667 sound = { soundeffect = "chaosx_riverborn_attack_sfx" } }
		event = { time = 2.4333 sound = { soundeffect = "chaosx_riverborn_attack_sfx" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Braces behind the shield at frame 21 and drives it forward at frame 34, spear held low.
		event = { time = 0.6500 sound = { soundeffect = "chaosx_riverborn_move_sfx" } }
		event = { time = 1.3743 sound = { soundeffect = "chaosx_riverborn_attack_sfx" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# Raises the spear overhead by frame 30, steps long at frame 49 and drives it down at frame 55.
		event = { time = 1.6047 sound = { soundeffect = "chaosx_riverborn_move_sfx" } }
		event = { time = 2.0038 sound = { soundeffect = "chaosx_riverborn_attack_sfx" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Spear-walk plants: left 11, right 28.
		event = { time = 0.3608 sound = { soundeffect = "chaosx_riverborn_move_sfx" } }
		event = { time = 0.9553 sound = { soundeffect = "chaosx_riverborn_move_sfx" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Backs away behind the shield: the trailing foot plants at frames 1 and 20.
		event = { time = 0.0000 sound = { soundeffect = "chaosx_riverborn_move_sfx" } }
		event = { time = 0.6333 sound = { soundeffect = "chaosx_riverborn_move_sfx" } }
	}
	state = {
		name = "deploy"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		# Rises from the water, punches with the shield at frame 26 and strikes with the spear butt at frame 48.
		event = { time = 0.0918 sound = { soundeffect = "chaosx_riverborn_water_transition_sfx" } }
		event = { time = 0.8333 sound = { soundeffect = "chaosx_riverborn_attack_sfx" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Shot, staggering forward; the body lands near frame 52.
		event = { time = 0.1080 node = "Head" particle = "blood_particle" }
		event = { time = 0.1080 sound = { soundeffect = "chaosx_riverborn_death_sfx" } }
		event = { time = 1.7000 sound = { soundeffect = "chaosx_riverborn_water_transition_sfx" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "chaosx_riverborn_idle_sfx" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Drill: shield punch at frame 26, spear-butt strike at frame 48, then an overhead spear flourish and a raised salute.
		event = { time = 0.8333 sound = { soundeffect = "chaosx_riverborn_attack_sfx" } }
		event = { time = 1.5667 sound = { soundeffect = "chaosx_riverborn_attack_sfx" } }
	}

	# The mesh keeps the vanilla infantry source height, so the vanilla entity scale applies once.
	scale = 0.8
}
