# Chaos Redux demonic zombie entity: a winged, grinning ghoul.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the measured phase it voices.
# The wings ride their own spine-rooted bones, so they flare in attacks, wrap forward in defence, and splay in death.

entity = {
	name = "chaosx_demonic_zombies_entity"
	pdxmesh = "chaosx_demonic_zombies_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Standing double slash: right claw peaks at frame 34 and left claw at frame 76, each after a crouch.
		event = { time = 0.5667 sound = { soundeffect = "chaosx_demonic_zombie_attack" } }
		event = { time = 1.1000 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 1.9667 sound = { soundeffect = "chaosx_demonic_zombie_attack" } }
		event = { time = 2.5000 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Side-step dodges at frames 10 and 22 behind forward-wrapped wings.
		event = { trigger_once = yes sound = { soundeffect = "chaosx_zombie_ambient" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# Crouch to frame 28, leap from 29 to 47 with both claws raised, and slam at frame 49.
		event = { time = 0.9667 sound = { soundeffect = "chaosx_demonic_zombie_scream" } }
		event = { time = 1.6333 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Clawed-foot plants: right 22, 64, 109, 152, 195, 241; left 37, 92, 132, 175, 219.
		event = { time = 0.7000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.2000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 2.1000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 3.0333 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 3.6000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 4.3667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 5.0333 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 5.8000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 6.4667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 7.2667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 8.0000 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { time = 0.0667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.4000 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Thrown backward; the body and splayed wings reach the ground near frame 42.
		event = { time = 0.1000 node = "Head" particle = "blood_particle" }
		event = { time = 0.1000 sound = { soundeffect = "chaosx_demonic_zombie_scream" } }
		event = { time = 1.3667 sound = { soundeffect = "chaosx_base_zombie_body_fall" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "chaosx_zombie_ambient" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Angry stomps land at frames 9, 25, and 40 with the wings flared.
		event = { time = 0.1000 sound = { soundeffect = "chaosx_demonic_zombie_scream" } }
		event = { time = 0.2667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 0.8000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.3000 sound = { soundeffect = "chaosx_zombie_move" } }
	}

	# The mesh keeps the vanilla infantry source height, so the vanilla entity scale applies once.
	scale = 0.8
}
