# Chaos Redux 3D model pilot entities.
# The humanoid state table exposes the two provider actions and the authored
# in-place locomotion action used by moving land units.

entity = {
	name = "building_anomaly_signal_beacon_pilot"
	pdxmesh = "chaosx_anomaly_signal_beacon_mesh"
	default_state = "idle"
	state = { name = "idle" }
	# Match the vanilla special-project facility's rendered height: 2.464908 source units at entity scale 2.0.
	scale = 3.280031
}

entity = {
	name = "building_anomaly_signal_beacon_pilot_spawn"
	pdxmesh = "chaosx_anomaly_signal_beacon_mesh"
	default_state = "idle"
	state = { name = "idle" }
	# Keep the spawn marker at the same scale as the visible building entity.
	scale = 3.280031
}

entity = {
	name = "chaosx_anomaly_recon_trooper_entity"
	pdxmesh = "chaosx_anomaly_recon_trooper_mesh"
	default_state = "idle"

	state = { name = "attack" animation = "attack" animation_blend_time = 0.0 animation_speed = 1.0 looping = no next_state = "attack" }
	state = { name = "defend" animation = "attack" animation_blend_time = 0.3 animation_speed = 1.0 looping = no next_state = "defend" }
	state = { name = "support_attack" animation = "attack" animation_blend_time = 0.3 animation_speed = 1.0 looping = no next_state = "support_attack" }
	state = { name = "move" animation = "move" animation_blend_time = 1.0 animation_speed = 1.0 looping = yes }
	state = { name = "retreat" animation = "move" animation_blend_time = 0.3 animation_speed = 1.0 looping = yes }
	state = { name = "death" animation = "idle" animation_blend_time = 0.3 animation_speed = 1.0 looping = yes }
	state = { name = "idle" animation = "idle" animation_blend_time = 0.3 animation_speed = 1.0 looping = yes }

	# The source mesh is normalized to the measured vanilla infantry mesh. The
	# live pilot consumer calibration was separately measured at scale 0.25.
	scale = 0.25
}
