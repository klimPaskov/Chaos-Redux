# Chaos Redux plague carrier entity: a pack donkey hauling sealed plague containers and a hanging basket.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the authored beat it voices.

entity = {
	name = "plague_carriers_entity"
	pdxmesh = "chaosx_plague_carriers_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Drops its head at frame 12 and stamps with each forehoof at frames 30 and 50, swinging the basket.
		event = { time = 0.9667 sound = { soundeffect = "chaosx_plague_carriers_impact_sfx" } }
		event = { time = 1.6333 sound = { soundeffect = "chaosx_plague_carriers_impact_sfx" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Shies back with ears pinned and head up by frame 10.
		event = { time = 0.3000 sound = { soundeffect = "chaosx_plague_carriers_idle_sfx" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# Rears by frame 15, stamps down at frame 28, and bucks the containment basket open at frame 40.
		event = { time = 0.9000 sound = { soundeffect = "chaosx_plague_carriers_impact_sfx" } }
		event = { time = 1.3000 sound = { soundeffect = "chaosx_plague_carriers_release_containment_sfx" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Four-beat walk: rear right, front left, rear left, front right hooves land at frames 1, 11, 21, and 31.
		event = { time = 0.0000 sound = { soundeffect = "chaosx_plague_carriers_move_sfx" } }
		event = { time = 0.4893 sound = { soundeffect = "chaosx_plague_carriers_move_sfx" } }
		event = { time = 1.0963 sound = { soundeffect = "chaosx_plague_carriers_move_sfx" } }
		event = { time = 1.5008 sound = { soundeffect = "chaosx_plague_carriers_move_sfx" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { time = 0.0000 sound = { soundeffect = "chaosx_plague_carriers_move_sfx" } }
		event = { time = 0.7590 sound = { soundeffect = "chaosx_plague_carriers_move_sfx" } }
		event = { time = 1.1338 sound = { soundeffect = "chaosx_plague_carriers_move_sfx" } }
		event = { time = 1.7992 sound = { soundeffect = "chaosx_plague_carriers_move_sfx" } }
	}
	state = {
		name = "deploy"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		event = { time = 0.9000 sound = { soundeffect = "chaosx_plague_carriers_deploy_sfx" } }
		event = { time = 1.3000 sound = { soundeffect = "chaosx_plague_carriers_release_containment_sfx" } }
	}
	state = {
		name = "supply_load"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		event = { time = 1.3000 sound = { soundeffect = "chaosx_plague_carriers_release_containment_sfx" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Buckles and collapses under its load by frame 30.
		event = { time = 0.0888 sound = { soundeffect = "chaosx_plague_carriers_death_sfx" } }
		event = { time = 0.9933 sound = { soundeffect = "chaosx_plague_carriers_impact_sfx" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "chaosx_plague_carriers_idle_sfx" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Paws the ground at frames 30 and 70 and brays at frame 45.
		event = { time = 0.9667 sound = { soundeffect = "chaosx_plague_carriers_impact_sfx" } }
		event = { time = 1.4667 sound = { soundeffect = "chaosx_plague_carriers_idle_sfx" } }
		event = { time = 2.3000 sound = { soundeffect = "chaosx_plague_carriers_impact_sfx" } }
	}

	# Source height 8.268482 multiplied by 0.75 gives an effective height of 6.201362.
	scale = 0.75
}
