# Chaos Redux temporal guard entity: a riveted chrono-armoured soldier whose chest core bends time.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the measured phase it voices.
# The public sprite = temporal_guard resolves to temporal_guard_entity, a clone of this entity.

entity = {
	name = "chaosx_temporal_guard_entity"
	pdxmesh = "chaosx_temporal_guard_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Thrusts a palm to freeze the target at frame 7, backhands it at frame 48, and strikes again at frame 104.
		event = { time = 0.1333 sound = { soundeffect = "chaosx_temporal_guard_temporal_special" } }
		event = { time = 1.5000 sound = { soundeffect = "chaosx_temporal_guard_attack_contact" } }
		event = { time = 3.3667 sound = { soundeffect = "chaosx_temporal_guard_impact" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Parries blows on the forearm plates at frames 23 and 59.
		event = { time = 0.7333 sound = { soundeffect = "chaosx_temporal_guard_attack_contact" } }
		event = { time = 1.9333 sound = { soundeffect = "chaosx_temporal_guard_attack_contact" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# Lifts an unseen weight overhead, then brings both fists down on the ground at frame 99.
		event = { time = 0.2000 sound = { soundeffect = "chaosx_temporal_guard_temporal_special" } }
		event = { time = 3.2000 sound = { soundeffect = "chaosx_temporal_guard_impact" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Armoured strides: left 12 and 53, right 32 and 71.
		event = { time = 0.3667 sound = { soundeffect = "chaosx_temporal_guard_footstep_a" } }
		event = { time = 1.0333 sound = { soundeffect = "chaosx_temporal_guard_footstep_b" } }
		event = { time = 1.7333 sound = { soundeffect = "chaosx_temporal_guard_footstep_a" } }
		event = { time = 2.3333 sound = { soundeffect = "chaosx_temporal_guard_footstep_b" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { time = 0.0333 sound = { soundeffect = "chaosx_temporal_guard_footstep_a" } }
		event = { time = 0.8000 sound = { soundeffect = "chaosx_temporal_guard_footstep_b" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# The core fails and time closes in; the guard chokes and falls forward near frame 204.
		event = { time = 0.1000 sound = { soundeffect = "chaosx_temporal_guard_temporal_special" } }
		event = { time = 0.2000 sound = { soundeffect = "chaosx_temporal_guard_death" } }
		event = { time = 6.7667 sound = { soundeffect = "chaosx_temporal_guard_impact" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "chaosx_temporal_guard_idle_clock" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Relaxes, then strikes battle poses at frames 30, 60, and 98.
		event = { time = 0.9667 sound = { soundeffect = "chaosx_temporal_guard_attack_contact" } }
		event = { time = 1.9667 sound = { soundeffect = "chaosx_temporal_guard_attack_contact" } }
		event = { time = 3.2333 sound = { soundeffect = "chaosx_temporal_guard_attack_contact" } }
	}

	# The mesh keeps the vanilla infantry source height, so the vanilla entity scale applies once.
	scale = 0.8
}

entity = {
	clone = "chaosx_temporal_guard_entity"
	name = "temporal_guard_entity"
}
