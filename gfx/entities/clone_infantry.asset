# Shared clone infantry runtime entity. The generic entity is used by Kruger
# and ordinary Mengele clones. Aryan clone aliases deliberately inherit the
# installed German infantry entities instead of the generated clone body.

entity = {
	name = "clone_infantry_entity"
	pdxmesh = "clone_infantry_mesh"
	default_state = "idle"

	state = { name = "idle" animation = "idle" animation_blend_time = 0.3 animation_speed = 1.0 looping = yes }
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { time = 0.0417 sound = { soundeffect = "clone_infantry_step_left" } }
		event = { time = 0.5833 sound = { soundeffect = "clone_infantry_step_right" } }
	}
	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "defend"
		event = { time = 0.0 trigger_once = yes sound = { soundeffect = "clone_infantry_attack_voice" } }
		event = { time = 0.7500 node = "muzzle" particle = "rifle_muzzle_particle" light = "muzzle_flash" sound = { soundeffect = "clone_infantry_rifle_attack" } }
		event = { time = 1.5833 node = "cartridge" particle = "rifle_cartridge_particle" sound = { soundeffect = "clone_infantry_rifle_cartridge" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = yes
		event = { time = 1.0000 node = "muzzle" particle = "rifle_muzzle_particle" light = "muzzle_flash" sound = { soundeffect = "clone_infantry_rifle_attack" } }
		event = { time = 1.8333 node = "cartridge" particle = "rifle_cartridge_particle" sound = { soundeffect = "clone_infantry_rifle_cartridge" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "defend"
		event = { time = 0.0 trigger_once = yes sound = { soundeffect = "clone_infantry_attack_voice" } }
		event = { time = 1.0000 node = "muzzle" particle = "rifle_muzzle_particle" light = "muzzle_flash" sound = { soundeffect = "clone_infantry_rifle_attack" } }
		event = { time = 1.8333 node = "cartridge" particle = "rifle_cartridge_particle" sound = { soundeffect = "clone_infantry_rifle_cartridge" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = yes
		event = { time = 0.0417 sound = { soundeffect = "clone_infantry_step_left" } }
		event = { time = 0.5833 sound = { soundeffect = "clone_infantry_step_right" } }
	}
	state = { name = "training" animation = "training" animation_blend_time = 0.2 animation_speed = 1.0 looping = yes }
	state = {
		name = "wounded"
		animation = "wounded"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		event = { time = 0.0417 sound = { soundeffect = "clone_infantry_wounded" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		event = { time = 0.0417 sound = { soundeffect = "clone_infantry_death" } }
		# Authored source marker: death frame 37 at 24 FPS; model contact review remains separate.
		event = { time = 1.5000 sound = { soundeffect = "clone_infantry_body_impact" } }
	}

	scale = 0.8
}

entity = { clone = "clone_infantry_entity" name = "clone_infantry_entity_snow" }
entity = { clone = "clone_infantry_entity" name = "clone_infantry_entity_desert" }
