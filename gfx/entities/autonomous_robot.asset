# Shared provider-neutral autonomous robot entity and action-synchronized sound identity.

entity = {
	name = "autonomous_robot_entity"
	pdxmesh = "autonomous_robot_mesh"
	default_state = "idle"

	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "autonomous_robot_idle_sfx" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "autonomous_robot_move_sfx" } }
		event = { time = 0.0417 sound = { soundeffect = "autonomous_robot_footfall_sfx" } }
		event = { time = 0.5833 sound = { soundeffect = "autonomous_robot_footfall_sfx" } }
	}
	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Left and right Gun bone locators follow the final40 exported discharge frames at 24 FPS.
		# The guns heave up before the burst, spent casings rain through it, and the rams vent as the barrels settle.
		event = { time = 0.0000 sound = { soundeffect = "autonomous_robot_gun_heave_sfx" } }
		event = { time = 1.0000 sound = { soundeffect = "autonomous_robot_casings_sfx" } }
		event = { time = 1.7500 sound = { soundeffect = "autonomous_robot_casings_sfx" } }
		event = { time = 2.5000 sound = { soundeffect = "autonomous_robot_casings_sfx" } }
		event = { time = 3.2500 sound = { soundeffect = "autonomous_robot_casings_sfx" } }
		event = { time = 3.4500 sound = { soundeffect = "autonomous_robot_hydraulic_release_sfx" } }
		event = { time = 0.6667 node = "robot_muzzle_l" particle = "chaosx_robot_sustained_muzzle_particle" light = "mg_muzzle_flash" sound = { soundeffect = "autonomous_robot_mg_report_sfx" } }
		event = { time = 0.6667 node = "robot_muzzle_l" particle = "chaosx_robot_muzzle_smoke_particle" }
		event = { time = 0.7917 node = "robot_muzzle_r" particle = "chaosx_robot_sustained_muzzle_particle" light = "mg_muzzle_flash" sound = { soundeffect = "autonomous_robot_mg_report_sfx" } }
		event = { time = 0.7917 node = "robot_muzzle_r" particle = "chaosx_robot_muzzle_smoke_particle" }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = yes
		# Braced bursts toward the scanned side; each discharge precedes its recoil peak by one frame.
		# Casings fall after each braced burst.
		event = { time = 1.4000 sound = { soundeffect = "autonomous_robot_casings_sfx" } }
		event = { time = 3.4000 sound = { soundeffect = "autonomous_robot_casings_sfx" } }
		event = { time = 0.7500 node = "robot_muzzle_l" particle = "chaosx_robot_braced_muzzle_particle" light = "mg_muzzle_flash" sound = { soundeffect = "autonomous_robot_mg_short_burst_sfx" } }
		event = { time = 0.7500 node = "robot_muzzle_l" particle = "chaosx_robot_muzzle_smoke_particle" }
		event = { time = 2.7500 node = "robot_muzzle_r" particle = "chaosx_robot_braced_muzzle_particle" light = "mg_muzzle_flash" sound = { soundeffect = "autonomous_robot_mg_short_burst_sfx" } }
		event = { time = 2.7500 node = "robot_muzzle_r" particle = "chaosx_robot_muzzle_smoke_particle" }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# The support sequence begins later and retains its separate bilateral firing cadence.
		# The support sequence raises the guns, drops casings through the longer burst, and vents after it.
		event = { time = 0.0000 sound = { soundeffect = "autonomous_robot_gun_heave_sfx" } }
		event = { time = 1.3000 sound = { soundeffect = "autonomous_robot_casings_sfx" } }
		event = { time = 2.0500 sound = { soundeffect = "autonomous_robot_casings_sfx" } }
		event = { time = 2.8000 sound = { soundeffect = "autonomous_robot_casings_sfx" } }
		event = { time = 3.5500 sound = { soundeffect = "autonomous_robot_casings_sfx" } }
		event = { time = 3.8500 sound = { soundeffect = "autonomous_robot_hydraulic_release_sfx" } }
		event = { time = 1.0000 node = "robot_muzzle_l" particle = "chaosx_robot_sustained_muzzle_particle" light = "mg_muzzle_flash" sound = { soundeffect = "autonomous_robot_mg_report_sfx" } }
		event = { time = 1.0000 node = "robot_muzzle_l" particle = "chaosx_robot_muzzle_smoke_particle" }
		event = { time = 1.1250 node = "robot_muzzle_r" particle = "chaosx_robot_sustained_muzzle_particle" light = "mg_muzzle_flash" sound = { soundeffect = "autonomous_robot_mg_report_sfx" } }
		event = { time = 1.1250 node = "robot_muzzle_r" particle = "chaosx_robot_muzzle_smoke_particle" }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "autonomous_robot_move_sfx" } }
		event = { time = 0.0417 sound = { soundeffect = "autonomous_robot_footfall_sfx" } }
		event = { time = 0.3333 sound = { soundeffect = "autonomous_robot_footfall_sfx" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = yes
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		# The drive motors die, the chassis blows apart, and the wreck crashes into the ground.
		event = { time = 0.0000 sound = { soundeffect = "autonomous_robot_motor_die_sfx" } }
		event = { time = 0.3333 sound = { soundeffect = "autonomous_robot_destruction_sfx" } }
		event = { time = 2.8750 sound = { soundeffect = "autonomous_robot_footfall_sfx" } }
		event = { time = 2.8750 sound = { soundeffect = "autonomous_robot_wreck_debris_sfx" } }
	}

	scale = 0.8
}

entity = { clone = "autonomous_robot_entity" name = "autonomous_robot_entity_snow" }
entity = { clone = "autonomous_robot_entity" name = "autonomous_robot_entity_desert" }
