# Paleogenetic creature land-unit entity: a screaming host fused to a bulbous one-eyed growth, with six tentacles.
# Four tentacles have their own bone chains keyed per action; the middle pair follows the provider arm rig.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the measured phase it voices.

entity = {
	name = "chaosx_paleogenetic_creature_entity"
	pdxmesh = "chaosx_paleogenetic_creature_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Throws its head back screaming, then lashes the tentacles forward at frames 40 and 90.
		event = { time = 0.2000 sound = { soundeffect = "chaosx_mutant_zombie_roar" } }
		event = { time = 1.2333 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 2.9000 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Recoils from a blow at frame 5, tentacles flung back, then wraps them forward.
		event = { time = 0.1333 sound = { soundeffect = "chaosx_infected_zombie_pain" } }
		event = { time = 0.8000 sound = { soundeffect = "chaosx_parasitic_zombie_gurgle" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# Reaches out at frame 25, drags the victim in, and bites it at frame 95.
		event = { time = 0.1000 sound = { soundeffect = "chaosx_parasitic_zombie_gurgle" } }
		event = { time = 0.7333 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 3.0667 sound = { soundeffect = "chaosx_parasitic_zombie_feed" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Shaking steps on bare clawed feet at frames 22 and 65, tentacles trailing.
		event = { time = 0.7000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 2.1333 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Backing away crouched, tentacles raised: plants at frames 12, 30, and 46.
		event = { time = 0.3667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 0.9667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.5000 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Collapses with the tentacles flailing, then lies with them splayed across the ground.
		event = { time = 0.1000 sound = { soundeffect = "chaosx_parasitic_zombie_gurgle" } }
		event = { time = 1.5000 sound = { soundeffect = "chaosx_base_zombie_body_fall" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "chaosx_parasitic_zombie_gurgle" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# A shrieking threat display, tentacles raised, peaking at frames 35 and 165.
		event = { time = 1.1333 sound = { soundeffect = "chaosx_mutant_zombie_roar" } }
		event = { time = 5.4667 sound = { soundeffect = "chaosx_mutant_zombie_roar" } }
	}

	# The mesh is 1.1x the vanilla infantry source height, so the vanilla entity scale leaves it towering slightly.
	scale = 0.8
}

entity = {
	clone = "chaosx_paleogenetic_creature_entity"
	name = "paleogenetic_creature_entity"
}
