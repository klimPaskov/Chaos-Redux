# Reusable Paleogenetic Creature land-unit entity.
#
# No firearm or projectile attachment is declared: this is a four-armed,
# two-legged creature whose preserved geometry contains no separate weapon.
# Sourced audio and any creature-specific particle/effect events remain
# explicitly parent-reviewed until their role audition and consumer proof are
# complete; this entity therefore cannot replace global infantry voices.

entity = {
	name = "chaosx_paleogenetic_creature_entity"
	pdxmesh = "chaosx_paleogenetic_creature_mesh"
	default_state = "idle"

	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.8
		animation_speed = 1.0
		looping = yes
	}
	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "idle"
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "idle"
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "idle"
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
	}
	state = {
		name = "training"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
	}

	state = {
		name = "stalk"
		animation = "stalk"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = yes
	}
	state = {
		name = "charge"
		animation = "charge"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "idle"
	}
	state = {
		name = "roar"
		animation = "roar"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "idle"
	}
	state = {
		name = "wounded"
		animation = "wounded"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "idle"
	}

	# The source mesh is calibrated to the selected vanilla infantry precedent
	# at 7.3518238068 m and receives the entity scale exactly once.
	scale = 1.35
}

# The reusable sub-unit consumer is declared with sprite = paleogenetic_creature,
# so expose the engine's conventional <sprite>_entity name without changing the
# accepted chaosx-prefixed runtime identifier above.
entity = {
	clone = "chaosx_paleogenetic_creature_entity"
	name = "paleogenetic_creature_entity"
}
