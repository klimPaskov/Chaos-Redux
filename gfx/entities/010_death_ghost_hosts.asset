# Chaos Redux Event 010 shared Death ghost host land-unit entity.
# The entity is shared by every Death ghost host subtype through sprite = death_ghost.
# A skull-faced revenant soldier in a torn greatcoat. Actions run at 30 FPS; each event time is
# (frame - first frame) / 30 at the measured phase it voices.

entity = {
	name = "death_ghost_entity"
	pdxmesh = "death_ghost_hosts_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Glides in at frame 22, rakes with the right claw at frame 40 and the left at frame 69.
		event = { time = 0.6333 sound = { soundeffect = "death_ghost_attack" } }
		event = { time = 1.2333 sound = { soundeffect = "death_ghost_impact" } }
		event = { time = 2.2000 sound = { soundeffect = "death_ghost_impact" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Clutches its skull and recoils, lashing out at frame 72.
		event = { time = 0.1000 sound = { soundeffect = "death_ghost_idle" } }
		event = { time = 2.3667 sound = { soundeffect = "death_ghost_impact" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# Reaches out to draw the life from its victim from frame 19, pulling it in at frame 95.
		event = { time = 0.5333 sound = { soundeffect = "death_ghost_attack" } }
		event = { time = 3.0667 sound = { soundeffect = "death_ghost_impact" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Unsteady drifting steps at frames 12, 41, and 77.
		event = { time = 0.3667 sound = { soundeffect = "death_ghost_movement" } }
		event = { time = 1.3333 sound = { soundeffect = "death_ghost_movement" } }
		event = { time = 2.5333 sound = { soundeffect = "death_ghost_movement" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { time = 0.3000 sound = { soundeffect = "death_ghost_movement" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Convulses as the host is torn loose and collapses, settling near frame 140.
		event = { time = 0.1000 sound = { soundeffect = "death_ghost_death" } }
		event = { time = 4.6333 sound = { soundeffect = "death_ghost_impact" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "death_ghost_idle" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# A cold casting gesture peaking at frame 49.
		event = { time = 1.6000 sound = { soundeffect = "death_ghost_attack" } }
	}

	# The mesh keeps the vanilla infantry source height, so the vanilla entity scale applies once.
	scale = 0.8
}
