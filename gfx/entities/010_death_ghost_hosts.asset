	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		event = { sound = { soundeffect = "death_ghost_death" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { sound = { soundeffect = "death_ghost_idle" } }
	}
	state = { name = "training" animation = "idle" animation_blend_time = 0.3 animation_speed = 1.0 looping = yes }

