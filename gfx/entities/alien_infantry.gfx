# Reusable Meshy alien infantry mesh registration.
#
# The firearm is part of the provider-authored, skinned mesh.  This file only
# binds the exported PDX mesh, materials, and genuine provider/preset actions;
# it does not attach or animate a separate weapon in Blender.

objectTypes = {
	pdxmesh = {
		name = "alien_infantry_mesh"
		file = "gfx/models/units/alien_infantry/alien_infantry.mesh"

		animation = { id = "idle" type = "alien_infantry_idle_animation" }
		animation = { id = "move" type = "alien_infantry_move_animation" }
		animation = { id = "attack" type = "alien_infantry_laser_attack_animation" }
		animation = { id = "defend" type = "alien_infantry_defend_animation" }
		animation = { id = "support_attack" type = "alien_infantry_support_attack_animation" }
		animation = { id = "retreat" type = "alien_infantry_retreat_animation" }
		animation = { id = "training" type = "alien_infantry_idle_animation" }
		animation = { id = "wounded" type = "alien_infantry_defend_animation" }
		animation = { id = "death" type = "alien_infantry_death_animation" }

		meshsettings = {
			name = "char1.002"
			index = 0
			texture_diffuse = "alien_infantry_diffuse.dds"
			texture_specular = "alien_infantry_specular.dds"
			texture_normal = "alien_infantry_normal.dds"
			shader = "PdxMeshAdvanced"
		}
	}
}
