# Chaos Redux gorilla heavy infantry entity: an armoured silverback carrying a riveted iron warhammer.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the measured phase it voices.

entity = {
	name = "chaosx_gorilla_heavy_infantry_entity"
	pdxmesh = "chaosx_gorilla_heavy_infantry_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# The hammer smashes down at frame 22, then sweeps sideways at frame 101.
		event = { time = 0.1000 sound = { soundeffect = "chaosx_gorilla_heavy_infantry_idle_sfx" } }
		event = { time = 0.6333 sound = { soundeffect = "chaosx_gorilla_heavy_infantry_attack_sfx" } }
		event = { time = 3.2667 sound = { soundeffect = "chaosx_gorilla_heavy_infantry_attack_sfx" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Blocks blows on the forearms at frames 6 and 25.
		event = { time = 0.1667 sound = { soundeffect = "chaosx_gorilla_heavy_infantry_move_sfx" } }
		event = { time = 0.8000 sound = { soundeffect = "chaosx_gorilla_heavy_infantry_recovery_sfx" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# Beats its chest from frame 8, then pounds the ground with both fists at frame 75 and roars.
		event = { time = 0.1667 sound = { soundeffect = "chaosx_gorilla_heavy_infantry_recovery_sfx" } }
		event = { time = 2.4000 sound = { soundeffect = "chaosx_gorilla_heavy_infantry_attack_sfx" } }
		event = { time = 2.6667 sound = { soundeffect = "chaosx_gorilla_heavy_infantry_idle_sfx" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Hauling the hammer: plants at frames 4 and 17 of the 29-frame loop.
		event = { time = 0.1000 sound = { soundeffect = "chaosx_gorilla_heavy_infantry_move_sfx" } }
		event = { time = 0.5333 sound = { soundeffect = "chaosx_gorilla_heavy_infantry_move_sfx" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { time = 0.2333 sound = { soundeffect = "chaosx_gorilla_heavy_infantry_move_sfx" } }
		event = { time = 1.1000 sound = { soundeffect = "chaosx_gorilla_heavy_infantry_move_sfx" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Knocked down; the body hits the ground at frame 33.
		event = { time = 0.1000 node = "Head" particle = "blood_particle" }
		event = { time = 0.1000 sound = { soundeffect = "chaosx_gorilla_heavy_infantry_death_sfx" } }
		event = { time = 1.0667 sound = { soundeffect = "chaosx_gorilla_heavy_infantry_move_sfx" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "chaosx_gorilla_heavy_infantry_idle_sfx" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Heavy hammer swing drill: the head lands at frame 47.
		event = { time = 1.5333 sound = { soundeffect = "chaosx_gorilla_heavy_infantry_attack_sfx" } }
	}

	# The mesh is 1.15x the vanilla infantry source height, so the vanilla entity scale leaves it towering over infantry.
	scale = 0.8
}
