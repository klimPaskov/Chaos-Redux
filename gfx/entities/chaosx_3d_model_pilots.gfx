		meshsettings = {
			name = "Mesh_0.002"
			index = 0
			texture_diffuse = "Image_0.dds"
			texture_specular = "Image_1.dds"
			texture_normal = "Image_2.dds"
			shader = "PdxMeshAdvanced"
		}
	}

	pdxmesh = {
		name = "chaosx_anomaly_recon_trooper_mesh"
