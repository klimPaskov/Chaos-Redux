# Chaos Redux Event 020 shared oversized rat unit entity.
# The single entity is used by every rat subtype. Licensed action and ambient
# cues are registered in sound/020_black_plague_rat_units_sound.asset.

entity = {
	name = "black_plague_rat_entity"
	pdxmesh = "black_plague_rat_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.0
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		event = { sound = { soundeffect = "black_plague_rat_attack_sfx" } }
		event = { time = 0.55 sound = { soundeffect = "black_plague_rat_bite_sfx" } }
		event = { time = 0.62 sound = { soundeffect = "black_plague_rat_impact_sfx" } }
	}
	state = {
		name = "defend"
		animation = "attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		event = { sound = { soundeffect = "black_plague_rat_attack_sfx" } }
		event = { time = 0.55 sound = { soundeffect = "black_plague_rat_bite_sfx" } }
	}
	state = {
		name = "support_attack"
		animation = "attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		event = { sound = { soundeffect = "black_plague_rat_attack_sfx" } }
		event = { time = 0.55 sound = { soundeffect = "black_plague_rat_bite_sfx" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 1.0
		animation_speed = 1.0
		looping = yes
		event = { sound = { soundeffect = "black_plague_rat_move_sfx" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { sound = { soundeffect = "black_plague_rat_move_sfx" } }
		event = { sound = { soundeffect = "black_plague_rat_retreat_sfx" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		event = { sound = { soundeffect = "black_plague_rat_death_sfx" } }
		event = { time = 0.65 sound = { soundeffect = "black_plague_rat_impact_sfx" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { sound = { soundeffect = "black_plague_rat_idle_sfx" } }
	}
	state = { name = "training" animation = "idle" animation_blend_time = 0.3 animation_speed = 1.0 looping = yes event = { sound = { soundeffect = "black_plague_rat_training_sfx" } } }

	# The prepared rat mesh is 7.3518247604 source units high. This single entity
	# scale produces the requested 9.9249627827 runtime height, about 1.6875x
	# the calibrated vanilla infantry reference.
	scale = 1.35
}
