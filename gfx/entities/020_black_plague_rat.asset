# Chaos Redux Event 020 shared oversized rat unit entity.
# The single entity is used by every rat subtype. Licensed action and ambient
# cues are registered in sound/020_black_plague_rat_units_sound.asset.

entity = {
	name = "black_plague_rat_entity"
	pdxmesh = "black_plague_rat_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		event = { time = 0.30 sound = { soundeffect = "rat_brutes_attack_vocal" } }
		event = { time = 0.87 sound = { soundeffect = "rat_brutes_bite" } }
		event = { time = 0.63 sound = { soundeffect = "rat_brutes_impact" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		event = { time = 0.47 sound = { soundeffect = "rat_brutes_attack_vocal" } }
		event = { time = 0.67 sound = { soundeffect = "rat_brutes_impact" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		event = { time = 0.37 sound = { soundeffect = "rat_brutes_attack_vocal" } }
		event = { time = 1.07 sound = { soundeffect = "rat_brutes_bite" } }
		event = { time = 0.83 sound = { soundeffect = "rat_brutes_impact" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 1.0
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "rat_brutes_move_scurry" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "rat_brutes_move_scurry" } }
		event = { trigger_once = yes sound = { soundeffect = "rat_brutes_retreat_vocal" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		event = { time = 0.13 sound = { soundeffect = "rat_brutes_death_vocal" } }
		event = { time = 1.30 sound = { soundeffect = "rat_brutes_impact" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { sound = { soundeffect = "rat_brutes_idle" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { sound = { soundeffect = "rat_brutes_training_alert" } }
		event = { time = 0.50 sound = { soundeffect = "rat_brutes_impact" } }
	}

	# The prepared rat mesh is 7.3518247604 source units high. This single entity
	# scale produces the requested 9.9249627827 runtime height, about 1.6875x
	# the calibrated vanilla infantry reference.
	scale = 1.35
}
