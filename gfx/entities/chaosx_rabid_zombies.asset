# Chaos Redux rabid zombie entity: a frenzied, bloodied infected woman.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the measured phase it voices.

entity = {
	name = "chaosx_rabid_zombies_entity"
	pdxmesh = "chaosx_rabid_zombies_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# A clawing flurry: alternating reach peaks from frame 19 to 105.
		event = { time = 0.1000 sound = { soundeffect = "chaosx_rabid_zombie_attack" } }
		event = { time = 0.5333 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 1.1000 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 1.9667 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 2.4000 sound = { soundeffect = "chaosx_rabid_zombie_attack" } }
		event = { time = 3.4000 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# The head snaps back from a blow at frame 5.
		event = { time = 0.1333 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 0.2000 sound = { soundeffect = "chaosx_rabid_zombie_attack" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# Tackle at frame 21, then three biting jerks at 38, 47, and 55.
		event = { time = 0.6000 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 1.1667 sound = { soundeffect = "chaosx_base_zombie_eating" } }
		event = { time = 1.4667 sound = { soundeffect = "chaosx_rabid_zombie_attack" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Stumbling plants: left 10, 40, 74; right 27, 53.
		event = { time = 0.3000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 0.8667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.3000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.7333 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 2.4333 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { time = 0.1333 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 0.4000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.1667 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Shot and falling forward: the body lands near frame 45.
		event = { time = 0.0667 node = "Head" particle = "blood_particle" keep_particle = yes }
		event = { time = 0.0667 sound = { soundeffect = "chaosx_rabid_zombie_attack" } }
		event = { time = 1.4667 sound = { soundeffect = "chaosx_base_zombie_body_fall" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "chaosx_zombie_idle" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Furious stomps at frames 9, 25, and 40.
		event = { time = 0.1000 sound = { soundeffect = "chaosx_rabid_zombie_attack" } }
		event = { time = 0.2667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 0.8000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.3000 sound = { soundeffect = "chaosx_zombie_move" } }
	}

	# The mesh keeps the vanilla infantry source height, so the vanilla entity scale applies once.
	scale = 0.8
}
