# Chaos Redux necrotic zombie entity: an emaciated, putrefied corpse in rags.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the measured phase it voices.

entity = {
	name = "chaosx_necrotic_zombies_entity"
	pdxmesh = "chaosx_necrotic_zombies_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Bent forward, a two-handed stab peaks at frames 24-30, then rakes down by 54.
		event = { time = 0.4000 sound = { soundeffect = "chaosx_necrotic_zombie_rattle" } }
		event = { time = 0.8000 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 1.7000 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Head snapped back by a blow near frame 46.
		event = { time = 1.5000 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 1.6000 sound = { soundeffect = "chaosx_necrotic_zombie_rattle" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# Arms raised and swept down in a curse, peaking at frames 38-44 and 69-71.
		event = { time = 0.2000 sound = { soundeffect = "chaosx_necrotic_zombie_rattle" } }
		event = { time = 2.2333 sound = { soundeffect = "chaosx_necrotic_zombie_rattle" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Limping plants: right 15 and 59, left 37 and 82.
		event = { time = 0.4667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.2000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.9333 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 2.7000 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { time = 0.1667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 0.7000 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.5667 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Shot in the back: stumbles through frames 10-28 and lands near frame 40.
		event = { time = 0.1000 node = "Head" particle = "blood_particle" keep_particle = yes }
		event = { time = 0.1000 sound = { soundeffect = "chaosx_necrotic_zombie_rattle" } }
		event = { time = 1.3000 sound = { soundeffect = "chaosx_base_zombie_body_fall" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "chaosx_necrotic_zombie_rattle" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Crouching dry scream with the arms wide at frame 24-27.
		event = { time = 0.4000 sound = { soundeffect = "chaosx_necrotic_zombie_rattle" } }
	}

	# The mesh keeps the vanilla infantry source height, so the vanilla entity scale applies once.
	scale = 0.8
}
