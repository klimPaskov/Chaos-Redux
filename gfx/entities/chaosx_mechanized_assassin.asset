# Event 039 Mechanized Assassin entity: a dark gunmetal four-wheeled armoured car with a traversing machine-gun turret.
# Finite barrel flashes accompany timed vanilla vehicle recordings; wheel dust follows the vanilla vehicle pattern.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the authored beat it voices.

entity = {
	name = "mechanized_assassin_entity"
	pdxmesh = "chaosx_mechanized_assassin_mesh"
	default_state = "idle"

	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { time = 0 node = "left_tracks" particle = "tank_moving_tracks_particle" keep_particle = no trigger_once = yes }
		event = { time = 0 node = "right_tracks" particle = "tank_moving_tracks_particle" keep_particle = no trigger_once = yes }
		event = { trigger_once = yes sound = { soundeffect = "motorized_unit_move_animation" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { time = 0 node = "left_tracks" particle = "tank_moving_tracks_particle" keep_particle = no trigger_once = yes }
		event = { time = 0 node = "right_tracks" particle = "tank_moving_tracks_particle" keep_particle = no trigger_once = yes }
		event = { trigger_once = yes sound = { soundeffect = "motorized_unit_move_animation" } }
	}
	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.0
		animation_speed = 1.0
		looping = yes
		# One burst per cycle begins at frame 24 while the turret traverses.
		event = { time = 0.7667 node = "barrel" particle = "mg_muzzle_particle" light = "mg_muzzle_flash" sound = { soundeffect = "chaosx_mechanized_assassin_mg_fire" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# One suppressive burst per cycle begins at frame 30.
		event = { time = 0.9667 node = "barrel" particle = "mg_muzzle_particle" light = "mg_muzzle_flash" sound = { soundeffect = "chaosx_mechanized_assassin_mg_fire" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.0
		animation_speed = 1.0
		looping = yes
		# One answering burst per cycle begins at frame 8.
		event = { time = 0.2333 node = "barrel" particle = "mg_muzzle_particle" light = "mg_muzzle_flash" sound = { soundeffect = "chaosx_mechanized_assassin_mg_defend" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# The nose drops onto the front wheels and the turret swings aside by frame 25.
		event = { time = 0.1000 sound = { soundeffect = "chaosx_mechanized_assassin_destroyed" } }
	}

	# The mesh is fitted to the vanilla armoured car's length, so the vanilla entity scale applies once.
	scale = 0.6
}
