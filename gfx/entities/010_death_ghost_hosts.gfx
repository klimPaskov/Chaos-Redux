# Chaos Redux Event 010 shared Death ghost host mesh registration.
# All Death ghost host sub-unit types use this one calibrated mesh and rig.

objectTypes = {
	pdxmesh = {
		name = "death_ghost_hosts_mesh"
		file = "gfx/models/units/death_ghost_hosts/death_ghost_hosts.mesh"

		animation = { id = "idle" type = "death_ghost_idle_animation" }
		animation = { id = "move" type = "death_ghost_move_animation" }
		animation = { id = "retreat" type = "death_ghost_retreat_animation" }
		animation = { id = "attack" type = "death_ghost_attack_animation" }
		animation = { id = "death" type = "death_ghost_death_animation" }

		meshsettings = {
			name = "Mesh_0.002"
			index = 0
			texture_diffuse = "death_ghost_hosts_diffuse.dds"
			texture_specular = "death_ghost_hosts_specular.dds"
			texture_normal = "death_ghost_hosts_normal.dds"
			shader = "PdxMeshAdvanced"
		}
	}
}
