# Chaos Redux pan sapper entity: a horned goat-legged demolition sapper in a red field coat hung with charges.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the measured phase it voices.

entity = {
	name = "chaosx_pan_sappers_entity"
	pdxmesh = "chaosx_pan_sappers_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Crouches and pulls a charge from the belt at frame 52, throws overhand at frame 89, then ducks.
		event = { time = 1.6333 sound = { soundeffect = "chaosx_pan_sappers_construction_sfx" } }
		event = { time = 2.8667 sound = { soundeffect = "chaosx_pan_sappers_sabotage_sfx" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Sidesteps incoming fire, the hooves landing at frames 11 and 34.
		event = { time = 0.3333 sound = { soundeffect = "chaosx_pan_sappers_move_sfx" } }
		event = { time = 1.1000 sound = { soundeffect = "chaosx_pan_sappers_move_sfx" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# Kneels and wires a demolition charge with both hands, then stands at frame 98 and steps back.
		event = { time = 0.1000 sound = { soundeffect = "chaosx_pan_sappers_construction_sfx" } }
		event = { time = 1.5000 sound = { soundeffect = "chaosx_pan_sappers_construction_sfx" } }
		event = { time = 3.1667 sound = { soundeffect = "chaosx_pan_sappers_move_sfx" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Sneaking hoof plants: right 6, left 37 and 71.
		event = { time = 0.1667 sound = { soundeffect = "chaosx_pan_sappers_move_sfx" } }
		event = { time = 1.2000 sound = { soundeffect = "chaosx_pan_sappers_move_sfx" } }
		event = { time = 2.3333 sound = { soundeffect = "chaosx_pan_sappers_move_sfx" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Cautious crouched steps backward at frames 10 and 30.
		event = { time = 0.3000 sound = { soundeffect = "chaosx_pan_sappers_move_sfx" } }
		event = { time = 0.9667 sound = { soundeffect = "chaosx_pan_sappers_move_sfx" } }
	}
	state = {
		name = "deploy"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		event = { time = 0.1000 sound = { soundeffect = "chaosx_pan_sappers_construction_sfx" } }
		event = { time = 1.5000 sound = { soundeffect = "chaosx_pan_sappers_construction_sfx" } }
	}
	state = {
		name = "supply_load"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		event = { time = 0.1000 sound = { soundeffect = "chaosx_pan_sappers_construction_sfx" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Blown backward by a blast; the body hits the ground at frame 30.
		event = { time = 0.1000 node = "Head" particle = "blood_particle" keep_particle = yes }
		event = { time = 0.1000 sound = { soundeffect = "chaosx_pan_sappers_death_sfx" } }
		event = { time = 0.9667 sound = { soundeffect = "chaosx_pan_sappers_move_sfx" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "chaosx_pan_sappers_idle_sfx" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Crouch-charge-and-throw drill: the practice charge leaves the hand at frame 150.
		event = { time = 1.0000 sound = { soundeffect = "chaosx_pan_sappers_construction_sfx" } }
		event = { time = 4.9667 sound = { soundeffect = "chaosx_pan_sappers_sabotage_sfx" } }
	}

	# The mesh keeps the vanilla infantry source height, so the vanilla entity scale applies once.
	scale = 0.8
}
