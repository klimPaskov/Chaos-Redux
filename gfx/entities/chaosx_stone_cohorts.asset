# Chaos Redux stone cohort entity: a magma-veined stone warrior wielding a long iron halberd.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the measured phase it voices.

entity = {
	name = "chaosx_stone_cohorts_entity"
	pdxmesh = "chaosx_stone_cohorts_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Two halberd thrusts at frames 30 and 61, then a wide sweep at frame 89.
		event = { time = 0.9000 sound = { soundeffect = "chaosx_stone_cohorts_attack_sfx" } }
		event = { time = 1.9333 sound = { soundeffect = "chaosx_stone_cohorts_attack_sfx" } }
		event = { time = 2.8667 sound = { soundeffect = "chaosx_stone_cohorts_attack_sfx" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# A two-handed parry catches the blow at frame 35.
		event = { time = 1.1333 sound = { soundeffect = "chaosx_stone_cohorts_attack_sfx" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# Plants the halberd and braces low, slamming the butt into the ground at frames 50 and 66.
		event = { time = 0.1000 sound = { soundeffect = "chaosx_stone_cohorts_collapse_recovery_sfx" } }
		event = { time = 1.5667 sound = { soundeffect = "chaosx_stone_cohorts_move_sfx" } }
		event = { time = 2.1000 sound = { soundeffect = "chaosx_stone_cohorts_move_sfx" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Grinding stone steps: right 6, left 21 and 33.
		event = { time = 0.1667 sound = { soundeffect = "chaosx_stone_cohorts_move_sfx" } }
		event = { time = 0.6667 sound = { soundeffect = "chaosx_stone_cohorts_move_sfx" } }
		event = { time = 1.0667 sound = { soundeffect = "chaosx_stone_cohorts_move_sfx" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { time = 0.2667 sound = { soundeffect = "chaosx_stone_cohorts_move_sfx" } }
		event = { time = 1.0667 sound = { soundeffect = "chaosx_stone_cohorts_move_sfx" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Cracks open and collapses under its own weight, settling from frame 51.
		event = { time = 0.1000 sound = { soundeffect = "chaosx_stone_cohorts_death_sfx" } }
		event = { time = 1.6667 sound = { soundeffect = "chaosx_stone_cohorts_collapse_recovery_sfx" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "chaosx_stone_cohorts_idle_sfx" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Halberd combination drill: strikes at frames 20, 39, 67 and 86.
		event = { time = 0.6333 sound = { soundeffect = "chaosx_stone_cohorts_attack_sfx" } }
		event = { time = 1.2667 sound = { soundeffect = "chaosx_stone_cohorts_attack_sfx" } }
		event = { time = 2.2000 sound = { soundeffect = "chaosx_stone_cohorts_attack_sfx" } }
		event = { time = 2.8333 sound = { soundeffect = "chaosx_stone_cohorts_attack_sfx" } }
	}

	# The mesh is 1.25x the vanilla infantry source height, so the vanilla entity scale leaves it towering over infantry.
	scale = 0.8
}
