		scale = 1.0

		animation = { id = "idle" type = "chaosx_elephant_idle_animation" }
		animation = { id = "move" type = "chaosx_elephant_move_animation" }
		animation = { id = "retreat" type = "chaosx_elephant_retreat_animation" }
		animation = { id = "attack" type = "chaosx_elephant_attack_animation" }
		animation = { id = "defend" type = "chaosx_elephant_defend_animation" }
		animation = { id = "support_attack" type = "chaosx_elephant_support_attack_animation" }
		animation = { id = "training" type = "chaosx_elephant_training_animation" }
		animation = { id = "death" type = "chaosx_elephant_death_animation" }

		meshsettings = {
			name = "Mesh_0.002"
			index = 0
			texture_diffuse = "chaosx_elephant_body_diffuse.dds"
			texture_normal = "chaosx_elephant_body_normal.dds"
			texture_specular = "chaosx_elephant_body_specular.dds"
