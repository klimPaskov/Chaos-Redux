		}
		meshsettings = {
			name = "Cube"
			index = 0
			texture_diffuse = "chaosx_elephant_howdah_diffuse.dds"
			texture_normal = "chaosx_elephant_howdah_normal.dds"
			texture_specular = "chaosx_elephant_howdah_specular.dds"
			shader = "PdxMeshAdvanced"
		}
