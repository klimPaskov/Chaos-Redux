# Xenobiological assault organism land-unit entity: a gaunt four-armed insectoid with a beaked skull.
# The upper scythe arms have their own bone chains keyed per action; the lower arms follow the provider rig.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the measured phase it voices.

entity = {
	name = "chaosx_xenobiological_assault_entity"
	pdxmesh = "xenobiological_assault_organism_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Rears back at frame 20, then lunges and drives the scythes down at frames 32 and 74.
		event = { time = 0.6333 sound = { soundeffect = "black_plague_rat_attack_sfx" } }
		event = { time = 1.0333 sound = { soundeffect = "black_plague_rat_impact_sfx" } }
		event = { time = 2.4333 sound = { soundeffect = "black_plague_rat_impact_sfx" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Hisses in a wide threat stance, scythes raised; flinches from hits at frames 10 and 30.
		event = { time = 0.1000 sound = { soundeffect = "black_plague_rat_idle_sfx" } }
		event = { time = 0.3000 sound = { soundeffect = "black_plague_rat_move_sfx" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# Hunches forward and pins its prey at frame 30, then jabs again at frames 55 and 100.
		event = { time = 0.1000 sound = { soundeffect = "black_plague_rat_attack_sfx" } }
		event = { time = 0.9667 sound = { soundeffect = "black_plague_rat_impact_sfx" } }
		event = { time = 1.8000 sound = { soundeffect = "black_plague_rat_bite_sfx" } }
		event = { time = 3.3000 sound = { soundeffect = "black_plague_rat_bite_sfx" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Long-stride stalk: clawed feet land at frames 1 and 18.
		event = { time = 0.0333 sound = { soundeffect = "black_plague_rat_move_sfx" } }
		event = { time = 0.5667 sound = { soundeffect = "black_plague_rat_move_sfx" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Backs away turned aside; the back steps land at frames 10 and 30.
		event = { time = 0.3000 sound = { soundeffect = "black_plague_rat_retreat_sfx" } }
		event = { time = 0.9667 sound = { soundeffect = "black_plague_rat_move_sfx" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Staggers, drops to its knees at frame 21, and topples flat at frame 50.
		event = { time = 0.1000 sound = { soundeffect = "black_plague_rat_death_sfx" } }
		event = { time = 1.6333 sound = { soundeffect = "black_plague_rat_impact_sfx" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "black_plague_rat_idle_sfx" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Drills alternating lunges and scythe strikes, with a stepping strike at frame 132.
		event = { time = 0.1000 sound = { soundeffect = "black_plague_rat_training_sfx" } }
	}

	# The mesh is 1.1x the vanilla infantry source height, so the vanilla entity scale leaves it towering slightly.
	scale = 0.8
}

entity = {
	clone = "chaosx_xenobiological_assault_entity"
	name = "xenobiological_assault_organism_entity"
}
