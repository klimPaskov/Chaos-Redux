# Xenobiological assault organism land-unit entity: a gaunt four-armed insectoid with a beaked skull.
# The upper scythe arms have their own bone chains keyed per action; the lower arms follow the provider rig.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the measured phase it voices.

entity = {
	name = "chaosx_xenobiological_assault_entity"
	pdxmesh = "xenobiological_assault_organism_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Lunges at frame 13, then drives the scythes down at frames 34 and 82.
		event = { time = 0.3333 sound = { soundeffect = "black_plague_rat_attack_sfx" } }
		event = { time = 1.0333 sound = { soundeffect = "black_plague_rat_impact_sfx" } }
		event = { time = 2.6333 sound = { soundeffect = "black_plague_rat_impact_sfx" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Hisses and sidesteps, scythes folded as a guard; feet land at frames 6 and 16.
		event = { time = 0.1000 sound = { soundeffect = "black_plague_rat_idle_sfx" } }
		event = { time = 0.5000 sound = { soundeffect = "black_plague_rat_move_sfx" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# Bounds forward, lands on its prey at frame 34, and tears at it from frame 45 to frame 94.
		event = { time = 0.1000 sound = { soundeffect = "black_plague_rat_attack_sfx" } }
		event = { time = 1.0333 sound = { soundeffect = "black_plague_rat_impact_sfx" } }
		event = { time = 1.4000 sound = { soundeffect = "black_plague_rat_bite_sfx" } }
		event = { time = 2.5000 sound = { soundeffect = "black_plague_rat_bite_sfx" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Stalking crouch-walk: clawed feet land at frames 12, 21, and 29.
		event = { time = 0.3667 sound = { soundeffect = "black_plague_rat_move_sfx" } }
		event = { time = 0.6667 sound = { soundeffect = "black_plague_rat_move_sfx" } }
		event = { time = 0.9333 sound = { soundeffect = "black_plague_rat_move_sfx" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { time = 0.5000 sound = { soundeffect = "black_plague_rat_retreat_sfx" } }
		event = { time = 1.1333 sound = { soundeffect = "black_plague_rat_move_sfx" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Knocked over and flipped; the body slams down at frame 15 and the limbs thrash.
		event = { time = 0.1000 sound = { soundeffect = "black_plague_rat_death_sfx" } }
		event = { time = 0.4667 sound = { soundeffect = "black_plague_rat_impact_sfx" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "black_plague_rat_idle_sfx" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Crouched, scanning, scythes raised and twitching.
		event = { time = 0.1000 sound = { soundeffect = "black_plague_rat_training_sfx" } }
	}

	# The mesh is 1.1x the vanilla infantry source height, so the vanilla entity scale leaves it towering slightly.
	scale = 0.8
}

entity = {
	clone = "chaosx_xenobiological_assault_entity"
	name = "xenobiological_assault_organism_entity"
}
