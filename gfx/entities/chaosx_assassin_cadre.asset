# Event 039 Assassin Cadre entity: a masked beret operative with a folding-stock submachine gun, satchel, and radio pack.
# Three-round SMG bursts (one vanilla burst sound each) fire from the weapon's muzzle locator only on frames where the measured muzzle axis is level and forward.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30.

entity = {
	name = "assassin_cadre_entity"
	pdxmesh = "chaosx_assassin_cadre_mesh"
	default_state = "idle"

	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "infantry_move_animation" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "infantry_move_animation" } }
	}
	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = yes
		# Hip-fire bursts on the level frames 23, 63, and 103.
		event = { time = 0.6667 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" sound = { soundeffect = "infantry_mg_attack" } }
		event = { time = 0.7667 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" }
		event = { time = 0.8667 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" }
		event = { time = 2.0000 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" sound = { soundeffect = "infantry_mg_attack" } }
		event = { time = 2.1000 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" }
		event = { time = 2.2000 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" }
		event = { time = 3.3333 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" sound = { soundeffect = "infantry_mg_attack" } }
		event = { time = 3.4333 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" }
		event = { time = 3.5333 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Crouched advance with the SMG shouldered: bursts at frames 13, 43, 73, and 103.
		event = { time = 0.3333 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" sound = { soundeffect = "infantry_mg_attack" } }
		event = { time = 0.4333 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" }
		event = { time = 0.5333 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" }
		event = { time = 1.3333 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" sound = { soundeffect = "infantry_mg_attack" } }
		event = { time = 1.4333 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" }
		event = { time = 1.5333 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" }
		event = { time = 2.3333 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" sound = { soundeffect = "infantry_mg_attack" } }
		event = { time = 2.4333 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" }
		event = { time = 2.5333 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" }
		event = { time = 3.3333 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" sound = { soundeffect = "infantry_mg_attack" } }
		event = { time = 3.4333 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" }
		event = { time = 3.5333 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = yes
		# Covering fire from a braced stance at frames 11, 51, and 91.
		event = { time = 0.3333 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" sound = { soundeffect = "infantry_mg_attack" } }
		event = { time = 0.4333 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" }
		event = { time = 0.5333 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" }
		event = { time = 1.6667 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" sound = { soundeffect = "infantry_mg_attack" } }
		event = { time = 1.7667 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" }
		event = { time = 1.8667 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" }
		event = { time = 3.0000 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" sound = { soundeffect = "infantry_mg_attack" } }
		event = { time = 3.1000 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" }
		event = { time = 3.2000 node = "muzzle" particle = "mg_muzzle_particle" keep_particle = yes light = "mg_muzzle_flash" }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
	}

	# The mesh is calibrated to the vanilla infantry source height, so the vanilla entity scale applies once.
	scale = 0.8
}

# Shadow Company and Master Assassin share the Cadre's skeleton, actions, and firing events;
# their pdxmesh entries (chaosx_assassin_cadre_variants.gfx) swap only the dyed diffuse map.
entity = {
	clone = "assassin_cadre_entity"
	name = "shadow_company_entity"
	pdxmesh = "chaosx_shadow_company_mesh"
}

entity = {
	clone = "assassin_cadre_entity"
	name = "master_assassin_entity"
	pdxmesh = "chaosx_master_assassin_mesh"
}
