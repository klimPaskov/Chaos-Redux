# Chaos Redux undead zombie entity: a rotting corpse in a grave suit with glowing eyes.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the measured phase it voices.

entity = {
	name = "chaosx_undead_zombies_entity"
	pdxmesh = "chaosx_undead_zombies_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# Slow outstretched grab: reach peaks at frames 44-48, then hands to the mouth by 86-88.
		event = { time = 0.3000 sound = { soundeffect = "chaosx_undead_zombie_moan" } }
		event = { time = 1.4333 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 2.8000 sound = { soundeffect = "chaosx_undead_zombie_grunt" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Recoils from a hit at frame 6.
		event = { time = 0.1667 sound = { soundeffect = "chaosx_base_zombie_grab_contact" } }
		event = { time = 0.2333 sound = { soundeffect = "chaosx_undead_zombie_pain" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# Kneels over a fallen body and feeds, hands to the mouth around frames 48 and 97.
		event = { time = 1.5000 sound = { soundeffect = "chaosx_base_zombie_eating" } }
		event = { time = 3.1333 sound = { soundeffect = "chaosx_base_zombie_eating" } }
		event = { time = 4.0000 sound = { soundeffect = "chaosx_undead_zombie_grunt" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Limping plants: right 11, 44, 80; left 27, 63, 105.
		event = { time = 0.3333 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 0.8667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.4333 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 2.0667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 2.6333 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 3.4667 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { time = 0.7333 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 1.5667 sound = { soundeffect = "chaosx_zombie_move" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Clutches the abdomen, drops to the knees at frame 60, and collapses by 80.
		event = { time = 0.1000 node = "Head" particle = "blood_particle" keep_particle = yes }
		event = { time = 0.1000 sound = { soundeffect = "chaosx_undead_zombie_pain" } }
		event = { time = 1.9667 sound = { soundeffect = "chaosx_zombie_move" } }
		event = { time = 2.6333 sound = { soundeffect = "chaosx_base_zombie_body_fall" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "chaosx_undead_zombie_moan" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Crouching scream with the arms thrown wide at frame 27.
		event = { time = 0.4000 sound = { soundeffect = "chaosx_undead_zombie_grunt" } }
	}

	# The mesh keeps the vanilla infantry source height, so the vanilla entity scale applies once.
	scale = 0.8
}
