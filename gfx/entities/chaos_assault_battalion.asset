# Chaos Redux Chaos Assault Battalion land-unit entity.
# The public chaos_battalion sprite resolves to this dedicated gas-mask infantry
# entity instead of the generic infantry presentation.

entity = {
	name = "chaos_battalion_entity"
	pdxmesh = "chaos_assault_battalion_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.0
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		event = { sound = { soundeffect = "chaos_assault_battalion_attack" } }
	}
	state = {
		name = "defend"
		animation = "attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		event = { sound = { soundeffect = "chaos_assault_battalion_attack" } }
	}
	state = {
		name = "support_attack"
		animation = "attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		event = { sound = { soundeffect = "chaos_assault_battalion_attack" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 1.0
		animation_speed = 1.0
		looping = yes
		event = { sound = { soundeffect = "chaos_assault_battalion_move" } }
	}
	state = {
		name = "retreat"
		animation = "move"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { sound = { soundeffect = "chaos_assault_battalion_move" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		event = { sound = { soundeffect = "chaos_assault_battalion_death" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { sound = { soundeffect = "chaos_assault_battalion_idle" } }
	}
	state = {
		name = "training"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
	}

	# The mesh is calibrated to the installed vanilla infantry source height;
	# retain the vanilla land-unit entity scale exactly once.
	scale = 0.8
}
