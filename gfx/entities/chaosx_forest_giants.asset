# Chaos Redux forest giant entity: a walking tree-spirit colossus carrying a vine-bound stone axe.
# Actions run at 30 FPS; each event time is (frame - first frame) / 30 at the measured phase it voices.

entity = {
	name = "chaosx_forest_giants_entity"
	pdxmesh = "chaosx_forest_giants_mesh"
	default_state = "idle"

	state = {
		name = "attack"
		animation = "attack"
		animation_blend_time = 0.2
		animation_speed = 1.0
		looping = no
		next_state = "attack"
		# The axe comes down overhead at frame 48, then sweeps back across at frame 76.
		event = { time = 0.1954 sound = { soundeffect = "chaosx_forest_giants_idle_sfx" } }
		event = { time = 1.9259 sound = { soundeffect = "chaosx_forest_giants_attack_sfx" } }
		event = { time = 3.0048 sound = { soundeffect = "chaosx_forest_giants_attack_sfx" } }
	}
	state = {
		name = "defend"
		animation = "defend"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Blocks with the axe raised, absorbing blows at frames 8 and 33.
		event = { time = 0.1992 sound = { soundeffect = "chaosx_forest_giants_move_sfx" } }
		event = { time = 1.1110 sound = { soundeffect = "chaosx_forest_giants_idle_sfx" } }
	}
	state = {
		name = "support_attack"
		animation = "support_attack"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "support_attack"
		# A stomp lands at frame 22, the left fist slams the ground at frame 67, then it roars.
		event = { time = 0.6369 sound = { soundeffect = "chaosx_forest_giants_move_sfx" } }
		event = { time = 2.9469 sound = { soundeffect = "chaosx_forest_giants_attack_sfx" } }
		event = { time = 3.8265 sound = { soundeffect = "chaosx_forest_giants_concealment_emergence_sfx" } }
	}
	state = {
		name = "move"
		animation = "move"
		animation_blend_time = 0.5
		animation_speed = 1.0
		looping = yes
		# Heavy plants: left 37 and 129, right 77 and 158.
		event = { time = 1.2211 sound = { soundeffect = "chaosx_forest_giants_move_sfx" } }
		event = { time = 2.5568 sound = { soundeffect = "chaosx_forest_giants_move_sfx" } }
		event = { time = 4.3259 sound = { soundeffect = "chaosx_forest_giants_move_sfx" } }
		event = { time = 5.2925 sound = { soundeffect = "chaosx_forest_giants_move_sfx" } }
	}
	state = {
		name = "retreat"
		animation = "retreat"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Backward steps plant at frames 10 and 18.
		event = { time = 0.3302 sound = { soundeffect = "chaosx_forest_giants_move_sfx" } }
		event = { time = 0.7048 sound = { soundeffect = "chaosx_forest_giants_move_sfx" } }
	}
	state = {
		name = "deploy"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		next_state = "idle"
		# Rises out of the canopy and drives the axe into the earth at frame 51.
		event = { time = 0.1000 sound = { soundeffect = "chaosx_forest_giants_concealment_emergence_sfx" } }
		event = { time = 2.4240 sound = { soundeffect = "chaosx_forest_giants_attack_sfx" } }
	}
	state = {
		name = "death"
		animation = "death"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = no
		# Struck and toppling backward like a felled trunk; it hits the ground at frame 64.
		event = { time = 0.0669 sound = { soundeffect = "chaosx_forest_giants_death_sfx" } }
		event = { time = 2.0329 sound = { soundeffect = "chaosx_forest_giants_move_sfx" } }
	}
	state = {
		name = "idle"
		animation = "idle"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		event = { trigger_once = yes sound = { soundeffect = "chaosx_forest_giants_idle_loop_sfx" } }
	}
	state = {
		name = "training"
		animation = "training"
		animation_blend_time = 0.3
		animation_speed = 1.0
		looping = yes
		# Charged ground slam: the axe bites into the earth at frame 51.
		event = { time = 0.1000 sound = { soundeffect = "chaosx_forest_giants_concealment_emergence_sfx" } }
		event = { time = 2.4240 sound = { soundeffect = "chaosx_forest_giants_attack_sfx" } }
	}

	# The mesh is 1.3x the vanilla infantry source height, so the vanilla entity scale makes it tower over infantry.
	scale = 0.8
}
