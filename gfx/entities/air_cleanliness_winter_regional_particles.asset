# ============================================================================
# CHAOS REDUX - AIR WINTER REGIONAL PARTICLE ENTITIES
# ============================================================================
# Dedicated Fallout-owned particle wrappers. No vanilla weather particle is
# referenced. Runtime placement remains outside this asset-only package.
# ============================================================================

entity = {
	name = "air_winter_snow_frost_mild_entity"
	cull_radius = 36
	default_state = "idle"
	state = {
		name = "idle"
		state_time = 2
		looping = no
		event = {
			time = 0
			particle = "air_winter_snow_frost_mild_particle"
			keep_particle = yes
		}
	}
}

