# Event 012 Africa strange-formation entities.
# Sounds are added only with the sourced unit-audio receipt; the entity states
# themselves are fully mapped to authored skeletal actions and never alias a
# vanilla model.

entity = {
	name = "plague_carriers_entity"
	pdxmesh = "chaosx_plague_carriers_mesh"
	default_state = "idle"
	state = { name = "attack" animation = "deploy" animation_blend_time = 0.2 animation_speed = 1.0 looping = no next_state = "idle" event = { time = 1.400000 sound = { soundeffect = "chaosx_plague_carriers_deploy_sfx" } } }
	state = { name = "defend" animation = "deploy" animation_blend_time = 0.2 animation_speed = 1.0 looping = no next_state = "idle" event = { time = 1.400000 sound = { soundeffect = "chaosx_plague_carriers_deploy_sfx" } } }
	state = { name = "support_attack" animation = "deploy" animation_blend_time = 0.2 animation_speed = 1.0 looping = no next_state = "idle" event = { time = 1.400000 sound = { soundeffect = "chaosx_plague_carriers_deploy_sfx" } } }
	state = { name = "move" animation = "move" animation_blend_time = 0.8 animation_speed = 1.0 looping = yes event = { time = 0.333333 sound = { soundeffect = "chaosx_plague_carriers_move_sfx" } } }
	state = { name = "retreat" animation = "move" animation_blend_time = 0.3 animation_speed = 1.0 looping = yes event = { time = 0.333333 sound = { soundeffect = "chaosx_plague_carriers_move_sfx" } } }
	state = { name = "deploy" animation = "deploy" animation_blend_time = 0.3 animation_speed = 1.0 looping = no next_state = "idle" event = { time = 1.400000 sound = { soundeffect = "chaosx_plague_carriers_deploy_sfx" } } }
	state = { name = "supply_load" animation = "release_containment" animation_blend_time = 0.3 animation_speed = 1.0 looping = no next_state = "idle" event = { time = 0.933333 sound = { soundeffect = "chaosx_plague_carriers_release_containment_sfx" } } event = { time = 1.733333 sound = { soundeffect = "chaosx_plague_carriers_impact_sfx" } } }
	state = { name = "death" animation = "death" animation_blend_time = 0.2 animation_speed = 1.0 looping = no event = { time = 1.333333 sound = { soundeffect = "chaosx_plague_carriers_death_sfx" } } }
	state = { name = "idle" animation = "idle" animation_blend_time = 0.3 animation_speed = 1.0 looping = yes event = { time = 0.000000 trigger_once = yes sound = { soundeffect = "chaosx_plague_carriers_idle_sfx" } } }
	state = { name = "training" animation = "idle" animation_blend_time = 0.3 animation_speed = 1.0 looping = yes event = { time = 0.000000 trigger_once = yes sound = { soundeffect = "chaosx_plague_carriers_idle_sfx" } } }
	scale = 1.0
}
