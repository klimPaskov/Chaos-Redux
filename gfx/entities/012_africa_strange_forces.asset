# Event 012 Africa strange-formation entities.
# Sounds are added only with the sourced unit-audio receipt; the entity states
# themselves are fully mapped to authored skeletal actions and never alias a
# vanilla model.

entity = {
	name = "chaosx_gorilla_heavy_infantry_entity"
	pdxmesh = "chaosx_gorilla_heavy_infantry_mesh"
	default_state = "idle"
	state = { name = "attack" animation = "attack" animation_blend_time = 0.2 animation_speed = 1.0 looping = no next_state = "idle" event = { sound = { soundeffect = "chaosx_gorilla_heavy_infantry_attack_sfx" } } }
	state = { name = "defend" animation = "attack" animation_blend_time = 0.2 animation_speed = 1.0 looping = no next_state = "idle" event = { sound = { soundeffect = "chaosx_gorilla_heavy_infantry_attack_sfx" } } }
	state = { name = "support_attack" animation = "attack" animation_blend_time = 0.2 animation_speed = 1.0 looping = no next_state = "idle" event = { sound = { soundeffect = "chaosx_gorilla_heavy_infantry_attack_sfx" } } }
	state = { name = "move" animation = "move" animation_blend_time = 0.8 animation_speed = 1.0 looping = yes event = { sound = { soundeffect = "chaosx_gorilla_heavy_infantry_move_sfx" } } }
	state = { name = "retreat" animation = "move" animation_blend_time = 0.3 animation_speed = 1.0 looping = yes }
	state = { name = "death" animation = "death" animation_blend_time = 0.2 animation_speed = 1.0 looping = no next_state = "idle" event = { sound = { soundeffect = "chaosx_gorilla_heavy_infantry_death_sfx" } } }
	state = { name = "idle" animation = "idle" animation_blend_time = 0.3 animation_speed = 1.0 looping = yes event = { sound = { soundeffect = "chaosx_gorilla_heavy_infantry_idle_sfx" } } }
	state = { name = "training" animation = "recovery" animation_blend_time = 0.3 animation_speed = 1.0 looping = yes event = { sound = { soundeffect = "chaosx_gorilla_heavy_infantry_recovery_sfx" } } }
	scale = 1.0
}

