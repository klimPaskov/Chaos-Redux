# Shared clone infantry skeletal actions exported through the locked HOI4
# Blender adapter. Attack, support-attack, and training remain pending combined
# rifle-contact visual acceptance; their exact role exports are registered so
# the runtime consumer has no missing animation references.

animation = { name = "clone_infantry_idle_animation" file = "clone_infantry_idle.anim" }
animation = { name = "clone_infantry_move_animation" file = "clone_infantry_move.anim" }
animation = { name = "clone_infantry_attack_animation" file = "clone_infantry_attack.anim" }
animation = { name = "clone_infantry_defend_animation" file = "clone_infantry_defend.anim" }
animation = { name = "clone_infantry_support_attack_animation" file = "clone_infantry_support_attack.anim" }
animation = { name = "clone_infantry_retreat_animation" file = "clone_infantry_retreat.anim" }
animation = { name = "clone_infantry_training_animation" file = "clone_infantry_training.anim" }
animation = { name = "clone_infantry_wounded_animation" file = "clone_infantry_wounded.anim" }
animation = { name = "clone_infantry_death_animation" file = "clone_infantry_death.anim" }
