animation = { name = "alien_infantry_laser_attack_animation" file = "alien_infantry_laser_attack.anim" }
animation = { name = "alien_infantry_defend_animation" file = "alien_infantry_defend.anim" }
animation = { name = "alien_infantry_support_attack_animation" file = "alien_infantry_support_attack.anim" }
animation = { name = "alien_infantry_retreat_animation" file = "alien_infantry_retreat.anim" }
animation = { name = "alien_infantry_death_animation" file = "alien_infantry_death.anim" }
