# Chaos Redux Event 010 Death ghost host sourced unit sound package.
# These WAVs are derived from immutable licensed source candidates.

sound = { name = "death_ghost_selection_source" file = "units/death_ghost_hosts/death_ghost_selection.wav" always_load = no }
