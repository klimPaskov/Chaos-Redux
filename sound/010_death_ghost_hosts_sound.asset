soundeffect = {
	name = "death_ghost_selection"
	falloff = "falloff_100"
	sounds = { sound = "death_ghost_selection_source" }
	volume = 0.55
	max_audible = 3
	max_audible_behaviour = fail
	volume_random_offset = { -0.04 0.04 }
	prevent_random_repetition = yes
	is3d = yes
	loop = no
}

