# Shared autonomous robot positional sound wrappers. Source provenance and exact
# mechanical derivation recipes are recorded in the 3D production handoff.

# Existing robot cues use the umbrella Effects category; this new braced cue is registered locally.
category = { name = "Effects" soundeffects = { autonomous_robot_mg_short_burst_sfx } }

sound = { name = "autonomous_robot_select_source" file = "shared_robot_system/autonomous_robot/autonomous_robot_select.wav" always_load = no }
sound = { name = "autonomous_robot_move_source" file = "shared_robot_system/autonomous_robot/autonomous_robot_move_servo.wav" always_load = no }
sound = { name = "autonomous_robot_idle_source" file = "shared_robot_system/autonomous_robot/autonomous_robot_idle_loop.wav" always_load = no }
sound = { name = "autonomous_robot_footfall_source" file = "shared_robot_system/autonomous_robot/autonomous_robot_impact_footfall.wav" always_load = no }
sound = { name = "autonomous_robot_mg_report_source" file = "shared_robot_system/autonomous_robot/autonomous_robot_mg_report.wav" always_load = no }
sound = { name = "autonomous_robot_mg_short_burst_source" file = "shared_robot_system/autonomous_robot/autonomous_robot_mg_short_burst.wav" always_load = no }
sound = { name = "autonomous_robot_casings_01_source" file = "shared_robot_system/autonomous_robot/autonomous_robot_casings_01.wav" always_load = no }
sound = { name = "autonomous_robot_casings_02_source" file = "shared_robot_system/autonomous_robot/autonomous_robot_casings_02.wav" always_load = no }
sound = { name = "autonomous_robot_casings_03_source" file = "shared_robot_system/autonomous_robot/autonomous_robot_casings_03.wav" always_load = no }
sound = { name = "autonomous_robot_casings_04_source" file = "shared_robot_system/autonomous_robot/autonomous_robot_casings_04.wav" always_load = no }
sound = { name = "autonomous_robot_hydraulic_release_source" file = "shared_robot_system/autonomous_robot/autonomous_robot_hydraulic_release.wav" always_load = no }
sound = { name = "autonomous_robot_gun_heave_source" file = "shared_robot_system/autonomous_robot/autonomous_robot_gun_heave.wav" always_load = no }
sound = { name = "autonomous_robot_motor_die_source" file = "shared_robot_system/autonomous_robot/autonomous_robot_motor_die.wav" always_load = no }
sound = { name = "autonomous_robot_wreck_blast_source" file = "shared_robot_system/autonomous_robot/autonomous_robot_wreck_blast.wav" always_load = no }
sound = { name = "autonomous_robot_wreck_debris_source" file = "shared_robot_system/autonomous_robot/autonomous_robot_wreck_debris.wav" always_load = no }

soundeffect = { name = "autonomous_robot_select_sfx" falloff = "falloff_100" sounds = { sound = "autonomous_robot_select_source" } volume = 0.75 max_audible = 3 max_audible_behaviour = fail prevent_random_repetition = yes is3d = yes loop = no }
soundeffect = { name = "autonomous_robot_move_sfx" falloff = "falloff_100" sounds = { sound = "autonomous_robot_move_source" } volume = 0.55 max_audible = 5 max_audible_behaviour = fail prevent_random_repetition = yes random_sound_when_looping = no is3d = yes loop = yes }
soundeffect = { name = "autonomous_robot_idle_sfx" falloff = "falloff_80" sounds = { sound = "autonomous_robot_idle_source" } volume = 0.38 max_audible = 4 max_audible_behaviour = fail prevent_random_repetition = yes random_sound_when_looping = no is3d = yes loop = yes }
soundeffect = { name = "autonomous_robot_footfall_sfx" falloff = "falloff_80" sounds = { sound = "autonomous_robot_footfall_source" } volume = 0.62 max_audible = 8 max_audible_behaviour = fail playbackrate_random_offset = { -0.04 0.04 } prevent_random_repetition = yes is3d = yes loop = no }
soundeffect = { name = "autonomous_robot_mg_report_sfx" falloff = "falloff_100" sounds = { sound = "autonomous_robot_mg_report_source" sound = "autonomous_robot_mg_report_02_source" sound = "autonomous_robot_mg_report_03_source" } volume = 0.36 max_audible = 2 max_audible_behaviour = fail prevent_random_repetition = yes is3d = yes loop = no }
soundeffect = { name = "autonomous_robot_mg_short_burst_sfx" falloff = "falloff_100" sounds = { sound = "autonomous_robot_mg_short_burst_source" sound = "autonomous_robot_mg_short_burst_02_source" sound = "autonomous_robot_mg_short_burst_03_source" } volume = 0.36 max_audible = 2 max_audible_behaviour = fail prevent_random_repetition = yes is3d = yes loop = no }
soundeffect = { name = "autonomous_robot_casings_sfx" falloff = "falloff_80" sounds = { sound = "autonomous_robot_casings_01_source" sound = "autonomous_robot_casings_02_source" sound = "autonomous_robot_casings_03_source" sound = "autonomous_robot_casings_04_source" } volume = 0.35 max_audible = 8 max_audible_behaviour = fail prevent_random_repetition = yes is3d = yes loop = no }
soundeffect = { name = "autonomous_robot_hydraulic_release_sfx" falloff = "falloff_80" sounds = { sound = "autonomous_robot_hydraulic_release_source" } volume = 0.45 max_audible = 4 max_audible_behaviour = fail playbackrate_random_offset = { -0.04 0.04 } is3d = yes loop = no }
soundeffect = { name = "autonomous_robot_gun_heave_sfx" falloff = "falloff_80" sounds = { sound = "autonomous_robot_gun_heave_source" } volume = 0.5 max_audible = 4 max_audible_behaviour = fail playbackrate_random_offset = { -0.04 0.04 } is3d = yes loop = no }
soundeffect = { name = "autonomous_robot_motor_die_sfx" falloff = "falloff_100" sounds = { sound = "autonomous_robot_motor_die_source" } volume = 0.55 max_audible = 5 max_audible_behaviour = fail is3d = yes loop = no }
soundeffect = { name = "autonomous_robot_destruction_sfx" falloff = "falloff_100" sounds = { sound = "autonomous_robot_wreck_blast_source" } volume = 0.85 max_audible = 5 max_audible_behaviour = fail is3d = yes loop = no }
soundeffect = { name = "autonomous_robot_wreck_debris_sfx" falloff = "falloff_100" sounds = { sound = "autonomous_robot_wreck_debris_source" } volume = 0.7 max_audible = 5 max_audible_behaviour = fail is3d = yes loop = no }

sound = { name = "autonomous_robot_mg_report_02_source" file = "shared_robot_system/autonomous_robot/autonomous_robot_mg_report_02.wav" always_load = no }

sound = { name = "autonomous_robot_mg_report_03_source" file = "shared_robot_system/autonomous_robot/autonomous_robot_mg_report_03.wav" always_load = no }

sound = { name = "autonomous_robot_mg_short_burst_02_source" file = "shared_robot_system/autonomous_robot/autonomous_robot_mg_short_burst_02.wav" always_load = no }

sound = { name = "autonomous_robot_mg_short_burst_03_source" file = "shared_robot_system/autonomous_robot/autonomous_robot_mg_short_burst_03.wav" always_load = no }
