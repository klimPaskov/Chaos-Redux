# Chaos Redux Chaos Assault Battalion runtime sound package.
# The respirator, spray, footsteps, death voices and landing use archived CC0 recordings.
# Source/member hashes, transformations and measurements are in the WP5/WP6 audio handoff.

category = {
	name = "Effects"
	soundeffects = {
		chaos_assault_battalion_support_attack_gas
		chaos_assault_battalion_impact_body
		chaos_assault_battalion_retreat_move
	}
}

sound = { name = "chaos_assault_battalion_idle_source" file = "chaos_warfare/chaos_assault_battalion/chaos_assault_battalion_idle_breath.wav" always_load = no }
sound = { name = "chaos_assault_battalion_attack_source" file = "chaos_warfare/chaos_assault_battalion/chaos_assault_battalion_attack_gas.wav" always_load = no }
sound = { name = "chaos_assault_battalion_support_attack_source" file = "chaos_warfare/chaos_assault_battalion/chaos_assault_battalion_support_attack_gas.wav" always_load = no }
sound = { name = "chaos_assault_battalion_impact_body_source" file = "chaos_warfare/chaos_assault_battalion/chaos_assault_battalion_impact_body.wav" always_load = no }
sound = { name = "chaos_assault_battalion_move_step_01" file = "chaos_warfare/chaos_assault_battalion/chaos_assault_battalion_move_step_01.wav" always_load = no }
sound = { name = "chaos_assault_battalion_move_step_02" file = "chaos_warfare/chaos_assault_battalion/chaos_assault_battalion_move_step_02.wav" always_load = no }
sound = { name = "chaos_assault_battalion_move_step_03" file = "chaos_warfare/chaos_assault_battalion/chaos_assault_battalion_move_step_03.wav" always_load = no }
sound = { name = "chaos_assault_battalion_move_step_04" file = "chaos_warfare/chaos_assault_battalion/chaos_assault_battalion_move_step_04.wav" always_load = no }
sound = { name = "chaos_assault_battalion_death_01" file = "chaos_warfare/chaos_assault_battalion/chaos_assault_battalion_death_01.wav" always_load = no }
sound = { name = "chaos_assault_battalion_death_02" file = "chaos_warfare/chaos_assault_battalion/chaos_assault_battalion_death_02.wav" always_load = no }
sound = { name = "chaos_assault_battalion_death_03" file = "chaos_warfare/chaos_assault_battalion/chaos_assault_battalion_death_03.wav" always_load = no }

soundeffect = {
	name = "chaos_assault_battalion_idle"
	falloff = "falloff_100"
	sounds = { sound = "chaos_assault_battalion_idle_source" }
	volume = 0.28
	max_audible = 1
	max_audible_behaviour = fail
	volume_random_offset = { -0.04 0.04 }
	prevent_random_repetition = yes
	is3d = yes
	loop = yes
}

soundeffect = {
	name = "chaos_assault_battalion_attack"
	falloff = "falloff_100"
	sounds = { sound = "chaos_assault_battalion_attack_source" }
	volume = 0.62
	max_audible = 6
	max_audible_behaviour = fail
	volume_random_offset = { -0.06 0.06 }
	prevent_random_repetition = yes
	is3d = yes
	loop = no
}

soundeffect = {
	name = "chaos_assault_battalion_support_attack_gas"
	falloff = "falloff_100"
	sounds = { sound = "chaos_assault_battalion_support_attack_source" }
	volume = 0.62
	max_audible = 3
	max_audible_behaviour = fail
	prevent_random_repetition = yes
	is3d = yes
	loop = no
}

soundeffect = {
	name = "chaos_assault_battalion_impact_body"
	falloff = "falloff_100"
	sounds = { sound = "chaos_assault_battalion_impact_body_source" }
	volume = 0.58
	max_audible = 3
	max_audible_behaviour = fail
	prevent_random_repetition = yes
	is3d = yes
	loop = no
}

soundeffect = {
	name = "chaos_assault_battalion_move"
	falloff = "falloff_80"
	sounds = {
		sound = "chaos_assault_battalion_move_step_01"
		sound = "chaos_assault_battalion_move_step_02"
		sound = "chaos_assault_battalion_move_step_03"
		sound = "chaos_assault_battalion_move_step_04"
	}
	volume = 0.42
	max_audible = 6
	max_audible_behaviour = fail
	delay_random_offset = { 0.0 0.08 }
	playbackrate_random_offset = { -0.10 0.10 }
	looping_playbackrate_random_offset = yes
	prevent_random_repetition = yes
	is3d = yes
	loop = no
}

soundeffect = {
	name = "chaos_assault_battalion_death"
	falloff = "falloff_100"
	sounds = {
		sound = "chaos_assault_battalion_death_01"
		sound = "chaos_assault_battalion_death_02"
		sound = "chaos_assault_battalion_death_03"
	}
	volume = 0.58
	max_audible = 5
	max_audible_behaviour = fail
	playbackrate_random_offset = { -0.08 0.08 }
	volume_random_offset = { -0.08 0.08 }
	prevent_random_repetition = yes
	is3d = yes
	loop = no
}

# The close pair of backward plants uses the two short recorded boot contacts.
soundeffect = {
	name = "chaos_assault_battalion_retreat_move"
	falloff = "falloff_80"
	sounds = {
		sound = "chaos_assault_battalion_move_step_01"
		sound = "chaos_assault_battalion_move_step_02"
	}
	volume = 0.42
	max_audible = 6
	max_audible_behaviour = fail
	prevent_random_repetition = yes
	is3d = yes
	loop = no
}
