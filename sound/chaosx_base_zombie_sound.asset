# docs/assets/002_zombie_outbreak/models_3d/zombies/audio_sources/runtime_base_receipts_20260927.json.
# Attribution for the CC BY and CC BY-SA recordings ships in 002_zombie_outbreak/zombies/base/ATTRIBUTION.txt.

category = {
	name = "Effects"
	soundeffects = {
		chaosx_base_zombie_attack_growl
		chaosx_base_zombie_lunge
		chaosx_base_zombie_eating
		chaosx_base_zombie_defeated
		chaosx_base_zombie_body_fall
		chaosx_base_zombie_grab_contact
	}
}

sound = { name = "chaosx_base_zombie_attack_growl_source" file = "002_zombie_outbreak/zombies/base/base_zombie_attack_growl.wav" always_load = no }
sound = { name = "chaosx_base_zombie_lunge_source" file = "002_zombie_outbreak/zombies/base/base_zombie_lunge.wav" always_load = no }
sound = { name = "chaosx_base_zombie_eating_source" file = "002_zombie_outbreak/zombies/base/base_zombie_eating.wav" always_load = no }
sound = { name = "chaosx_base_zombie_defeated_source" file = "002_zombie_outbreak/zombies/base/base_zombie_defeated.wav" always_load = no }
sound = { name = "chaosx_base_zombie_body_fall_source" file = "002_zombie_outbreak/zombies/base/base_zombie_body_fall.wav" always_load = no }
sound = { name = "chaosx_base_zombie_grab_contact_source" file = "002_zombie_outbreak/zombies/base/base_zombie_grab_contact.wav" always_load = no }

soundeffect = { name = "chaosx_base_zombie_attack_growl" falloff = "falloff_100" sounds = { sound = "chaosx_base_zombie_attack_growl_source" } volume = 0.55 max_audible = 5 max_audible_behaviour = fail playbackrate_random_offset = { -0.08 0.08 } volume_random_offset = { -0.06 0.06 } is3d = yes loop = no }
soundeffect = { name = "chaosx_base_zombie_lunge" falloff = "falloff_100" sounds = { sound = "chaosx_base_zombie_lunge_source" } volume = 0.55 max_audible = 5 max_audible_behaviour = fail playbackrate_random_offset = { -0.08 0.08 } volume_random_offset = { -0.06 0.06 } is3d = yes loop = no }
soundeffect = { name = "chaosx_base_zombie_eating" falloff = "falloff_80" sounds = { sound = "chaosx_base_zombie_eating_source" } volume = 0.45 max_audible = 3 max_audible_behaviour = fail playbackrate_random_offset = { -0.06 0.06 } is3d = yes loop = no }
soundeffect = { name = "chaosx_base_zombie_defeated" falloff = "falloff_100" sounds = { sound = "chaosx_base_zombie_defeated_source" } volume = 0.6 max_audible = 5 max_audible_behaviour = fail playbackrate_random_offset = { -0.08 0.08 } is3d = yes loop = no }
soundeffect = { name = "chaosx_base_zombie_body_fall" falloff = "falloff_80" sounds = { sound = "chaosx_base_zombie_body_fall_source" } volume = 0.55 max_audible = 5 max_audible_behaviour = fail playbackrate_random_offset = { -0.06 0.06 } is3d = yes loop = no }
soundeffect = { name = "chaosx_base_zombie_grab_contact" falloff = "falloff_80" sounds = { sound = "chaosx_base_zombie_grab_contact_source" } volume = 0.4 max_audible = 6 max_audible_behaviour = fail playbackrate_random_offset = { -0.1 0.1 } volume_random_offset = { -0.06 0.06 } is3d = yes loop = no }
