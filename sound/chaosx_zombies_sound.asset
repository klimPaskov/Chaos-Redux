	name = "chaosx_zombie_attack"
	falloff = "falloff_100"
	sounds = {
		sound = "chaosx_zombie_attack_01"
		sound = "chaosx_zombie_attack_02"
		sound = "chaosx_zombie_attack_03"
	}
	volume = 0.58
	max_audible = 6
	max_audible_behaviour = fail
	delay_random_offset = { 0.0 0.2 }
	playbackrate_random_offset = { -0.10 0.10 }
	volume_random_offset = { -0.08 0.08 }
	prevent_random_repetition = yes
	is3d = yes
	loop = no
}

soundeffect = {
	name = "chaosx_zombie_death"
	falloff = "falloff_100"
	sounds = {
		sound = "chaosx_zombie_death_01"
		sound = "chaosx_zombie_death_02"
		sound = "chaosx_zombie_death_03"
	}
	volume = 0.62
	max_audible = 5
	max_audible_behaviour = fail
	playbackrate_random_offset = { -0.08 0.08 }
	volume_random_offset = { -0.08 0.08 }
	prevent_random_repetition = yes
