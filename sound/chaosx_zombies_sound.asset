# Chaos Redux shared zombie sounds and ZZZ infantry selection voice.
# The base zombie entity uses the idle and move effects; its own voices live in chaosx_base_zombie_sound.asset.

category = {
	name = "Voices"
	soundeffects = {
		ZZZ_infantry_idle
	}
	compressor = {
		enabled = yes
		pregain = 0.0
		postgain = 2.0
		ratio = 10.0
		threshold = -10.0
		attacktime = 0.030
		releasetime = 1.2
	}
}

sound = { name = "chaosx_zombie_idle_moan_01" file = "002_zombie_outbreak/zombies/zombie_idle_moan_01.wav" always_load = no }
sound = { name = "chaosx_zombie_idle_moan_02" file = "002_zombie_outbreak/zombies/zombie_idle_moan_02.wav" always_load = no }
sound = { name = "chaosx_zombie_idle_moan_03" file = "002_zombie_outbreak/zombies/zombie_idle_moan_03.wav" always_load = no }

sound = { name = "chaosx_zombie_move_step_01" file = "002_zombie_outbreak/zombies/zombie_move_step_01.wav" always_load = no }
sound = { name = "chaosx_zombie_move_step_02" file = "002_zombie_outbreak/zombies/zombie_move_step_02.wav" always_load = no }
sound = { name = "chaosx_zombie_move_step_03" file = "002_zombie_outbreak/zombies/zombie_move_step_03.wav" always_load = no }
sound = { name = "chaosx_zombie_move_step_04" file = "002_zombie_outbreak/zombies/zombie_move_step_04.wav" always_load = no }
sound = { name = "chaosx_zombie_move_step_05" file = "002_zombie_outbreak/zombies/zombie_move_step_05.wav" always_load = no }
sound = { name = "chaosx_zombie_move_step_06" file = "002_zombie_outbreak/zombies/zombie_move_step_06.wav" always_load = no }

soundeffect = {
	name = "chaosx_zombie_idle"
	falloff = "falloff_100"
	sounds = {
		sound = "chaosx_zombie_idle_moan_01"
		sound = "chaosx_zombie_idle_moan_02"
		sound = "chaosx_zombie_idle_moan_03"
	}
	volume = 0.42
	max_audible = 4
	max_audible_behaviour = fail
	delay_random_offset = { 0.0 0.4 }
	playbackrate_random_offset = { -0.08 0.08 }
	volume_random_offset = { -0.04 0.04 }
	prevent_random_repetition = yes
	is3d = yes
	loop = no
}

# HOI4 resolves TAG_infantry_idle as the country/original-tag infantry selection voice.
soundeffect = {
	name = "ZZZ_infantry_idle"
	sounds = {
		sound = "chaosx_zombie_idle_moan_01"
		sound = "chaosx_zombie_idle_moan_02"
		sound = "chaosx_zombie_idle_moan_03"
	}
	volume = 0.45
	max_audible = 1
	max_audible_behaviour = fail
	playbackrate_random_offset = { 0.0 -0.12 }
	volume_random_offset = { 0.0 -0.12 }
	prevent_random_repetition = yes
}

soundeffect = {
	name = "chaosx_zombie_move"
	falloff = "falloff_80"
	sounds = {
		sound = "chaosx_zombie_move_step_01"
		sound = "chaosx_zombie_move_step_02"
		sound = "chaosx_zombie_move_step_03"
		sound = "chaosx_zombie_move_step_04"
		sound = "chaosx_zombie_move_step_05"
		sound = "chaosx_zombie_move_step_06"
	}
	volume = 0.5
	max_audible = 6
	max_audible_behaviour = fail
	playbackrate_random_offset = { -0.12 0.12 }
	looping_playbackrate_random_offset = yes
	prevent_random_repetition = yes
	is3d = yes
	loop = no
}

