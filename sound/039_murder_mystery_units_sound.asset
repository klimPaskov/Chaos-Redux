# Event 039 infantry-family audio from archived licensed unit recordings.
category = {
	name = "Effects"
	soundeffects = { chaosx_assassin_cadre_attack chaosx_silent_guard_attack chaosx_assassin_cadre_death chaosx_silent_guard_death }
}

# Three distinct recorded transients, cut and faded into one dry 10 Hz burst.
sound = { name = "chaosx_assassin_attack_source" file = "039_murder_mystery/units/assassin_cadre/attack_3shot.wav" always_load = no }

soundeffect = {
	name = "chaosx_assassin_cadre_attack"
	falloff = "falloff_100"
	sounds = { sound = "chaosx_assassin_attack_source" }
	volume = 0.2
	max_audible = 4
	max_audible_behaviour = fail
	prevent_random_repetition = yes
	is3d = yes
	loop = no
}

soundeffect = {
	name = "chaosx_silent_guard_attack"
	falloff = "falloff_100"
	sounds = { sound = "chaosx_assassin_attack_source" }
	volume = 0.2
	max_audible = 4
	max_audible_behaviour = fail
	prevent_random_repetition = yes
	is3d = yes
	loop = no
}

