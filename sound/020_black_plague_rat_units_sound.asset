category = {
	name = "Voices"
	soundeffects = {
		RTA_infantry_idle
		RTA_infantry_move_out
		RTA_infantry_neutral_combat
		RTA_infantry_positive_combat
		RTA_infantry_retreat
		RTX_infantry_idle
		RTX_infantry_move_out
		RTX_infantry_neutral_combat
		RTX_infantry_positive_combat
		RTX_infantry_retreat
	}
}

sound = { name = "black_plague_rat_selection_source" file = "020_black_plague/rat_units/black_plague_rat_selection_01.wav" always_load = no }
sound = { name = "black_plague_rat_acknowledgement_source" file = "020_black_plague/rat_units/black_plague_rat_acknowledgement_01.wav" always_load = no }
