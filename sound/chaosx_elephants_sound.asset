# Event 012 elephant audio. All WAVs are mechanically derived from preserved
# CC0/public-domain originals documented in the model job's audio handoff.

sound = { name = "chaosx_elephant_move_contact_source" file = "012_africa/elephant/chaosx_elephant_move_contact.wav" always_load = no }
sound = { name = "chaosx_elephant_idle_call_source" file = "012_africa/elephant/chaosx_elephant_idle_call.wav" always_load = no }
sound = { name = "chaosx_elephant_attack_call_source" file = "012_africa/elephant/chaosx_elephant_attack_call.wav" always_load = no }
sound = { name = "chaosx_elephant_impact_contact_source" file = "012_africa/elephant/chaosx_elephant_impact_contact.wav" always_load = no }
sound = { name = "chaosx_elephant_supply_load_creak_source" file = "012_africa/elephant/chaosx_elephant_supply_load_creak.wav" always_load = no }
sound = { name = "chaosx_elephant_death_call_source" file = "012_africa/elephant/chaosx_elephant_death_call.wav" always_load = no }

soundeffect = {
	name = "chaosx_elephant_move_contact"
	falloff = "falloff_80"
	sounds = { sound = "chaosx_elephant_move_contact_source" }
	volume = 0.55
	max_audible = 4
	max_audible_behaviour = fail
	delay_random_offset = { 0.0 0.08 }
	playbackrate_random_offset = { -0.08 0.08 }
	prevent_random_repetition = yes
	is3d = yes
	loop = no
}

