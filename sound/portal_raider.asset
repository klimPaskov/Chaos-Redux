# Portal Raider sourced action audio; the electrical hum is a source-bound seamless idle loop.
category = { name = "Effects" soundeffects = { portal_raider_select portal_raider_move_animation portal_raider_idle_electrical portal_raider_ray_attack portal_raider_impact portal_raider_portal_arrival portal_raider_death } }

