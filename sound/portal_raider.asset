soundeffect = {
	name = portal_raider_select
	falloff = "falloff_80"
	sounds = { sound = portal_raider_select_01 }
	volume = 0.6
	max_audible = 3
	max_audible_behaviour = fail
	is3d = yes
	loop = no
}
soundeffect = {
	name = portal_raider_move_animation
	falloff = "falloff_80"
	sounds = { sound = portal_raider_step_01 sound = portal_raider_step_02 sound = portal_raider_step_03 sound = portal_raider_step_04 sound = portal_raider_step_05 sound = portal_raider_step_06 }
	volume = 0.6
	max_audible = 3
	max_audible_behaviour = fail
	prevent_random_repetition = yes
	is3d = yes
	loop = no
}
