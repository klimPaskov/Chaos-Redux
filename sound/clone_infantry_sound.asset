# Shared clone infantry positional sound wrappers. Sources are mechanically
# derived from preserved licensed recordings documented in the 3D handoff.

# The sourced death landing cue is an Effects one-shot.
category = { name = "Effects" soundeffects = { clone_infantry_body_impact } }

sound = { name = "clone_infantry_step_left_source" file = "shared_clone_system/clone_infantry/clone_infantry_step_left_01.wav" always_load = no }
sound = { name = "clone_infantry_step_right_source" file = "shared_clone_system/clone_infantry/clone_infantry_step_right_01.wav" always_load = no }
sound = { name = "clone_infantry_attack_voice_source" file = "shared_clone_system/clone_infantry/clone_infantry_attack_voice_01.wav" always_load = no }
sound = { name = "clone_infantry_rifle_source" file = "shared_clone_system/clone_infantry/clone_infantry_rifle_01.wav" always_load = no }
sound = { name = "clone_infantry_cartridge_source" file = "shared_clone_system/clone_infantry/clone_infantry_casing_01.wav" always_load = no }
sound = { name = "clone_infantry_wounded_source" file = "shared_clone_system/clone_infantry/clone_infantry_wounded_01.wav" always_load = no }
sound = { name = "clone_infantry_death_source" file = "shared_clone_system/clone_infantry/clone_infantry_death_01.wav" always_load = no }
sound = { name = "clone_infantry_death_02_source" file = "shared_clone_system/clone_infantry/clone_infantry_death_02.wav" always_load = no }
sound = { name = "clone_infantry_death_03_source" file = "shared_clone_system/clone_infantry/clone_infantry_death_03.wav" always_load = no }

sound = { name = "clone_infantry_attack_voice_02_source" file = "shared_clone_system/clone_infantry/clone_infantry_attack_voice_02.wav" always_load = no }
sound = { name = "clone_infantry_wounded_02_source" file = "shared_clone_system/clone_infantry/clone_infantry_wounded_02.wav" always_load = no }
sound = { name = "clone_infantry_wounded_03_source" file = "shared_clone_system/clone_infantry/clone_infantry_wounded_03.wav" always_load = no }

soundeffect = { name = "clone_infantry_step_left" falloff = "falloff_80" sounds = { sound = "clone_infantry_step_left_source" } volume = 0.55 max_audible = 6 max_audible_behaviour = fail playbackrate_random_offset = { -0.08 0.08 } prevent_random_repetition = yes is3d = yes loop = no }
soundeffect = { name = "clone_infantry_step_right" falloff = "falloff_80" sounds = { sound = "clone_infantry_step_right_source" } volume = 0.55 max_audible = 6 max_audible_behaviour = fail playbackrate_random_offset = { -0.08 0.08 } prevent_random_repetition = yes is3d = yes loop = no }
soundeffect = { name = "clone_infantry_attack_voice" falloff = "falloff_100" sounds = { sound = "clone_infantry_attack_voice_source" sound = "clone_infantry_attack_voice_02_source" } volume = 0.72 max_audible = 4 max_audible_behaviour = fail playbackrate_random_offset = { -0.06 0.06 } prevent_random_repetition = yes is3d = yes loop = no }
soundeffect = { name = "clone_infantry_rifle_attack" falloff = "falloff_100" sounds = { sound = "clone_infantry_rifle_source" } volume = 0.9 max_audible = 8 max_audible_behaviour = fail playbackrate_random_offset = { -0.04 0.04 } prevent_random_repetition = yes is3d = yes loop = no }
soundeffect = { name = "clone_infantry_rifle_cartridge" falloff = "falloff_80" sounds = { sound = "clone_infantry_cartridge_source" } volume = 0.5 max_audible = 8 max_audible_behaviour = fail playbackrate_random_offset = { -0.08 0.08 } prevent_random_repetition = yes is3d = yes loop = no }
soundeffect = { name = "clone_infantry_wounded" falloff = "falloff_100" sounds = { sound = "clone_infantry_wounded_source" sound = "clone_infantry_wounded_02_source" sound = "clone_infantry_wounded_03_source" } volume = 0.68 max_audible = 4 max_audible_behaviour = fail playbackrate_random_offset = { -0.05 0.05 } prevent_random_repetition = yes is3d = yes loop = no }
soundeffect = { name = "clone_infantry_death" falloff = "falloff_100" sounds = { sound = "clone_infantry_death_source" sound = "clone_infantry_death_02_source" sound = "clone_infantry_death_03_source" } volume = 0.7 max_audible = 4 max_audible_behaviour = fail playbackrate_random_offset = { -0.05 0.05 } prevent_random_repetition = yes is3d = yes loop = no }

sound = { name = "clone_infantry_body_impact_source" file = "shared_clone_system/clone_infantry/clone_infantry_body_impact_01.wav" always_load = no }
soundeffect = { name = "clone_infantry_body_impact" falloff = "falloff_100" sounds = { sound = "clone_infantry_body_impact_source" } volume = 0.6 max_audible = 4 max_audible_behaviour = fail prevent_random_repetition = yes is3d = yes loop = no }
