# Shared alien infantry entity-state audio. These sounds are bound only to the
# alien_infantry entity and never replace country-wide infantry voices.

sound = { name = "alien_infantry_laser_fire_source" file = "shared_alien_system/alien_infantry/alien_infantry_laser_fire.wav" always_load = no }
sound = { name = "alien_infantry_move_source" file = "shared_alien_system/alien_infantry/alien_infantry_move.wav" always_load = no }
sound = { name = "alien_infantry_idle_source" file = "shared_alien_system/alien_infantry/alien_infantry_idle.wav" always_load = no }
sound = { name = "alien_infantry_death_source" file = "shared_alien_system/alien_infantry/alien_infantry_death.wav" always_load = no }

soundeffect = { name = "alien_infantry_laser_fire" falloff = "falloff_100" sounds = { sound = "alien_infantry_laser_fire_source" } volume = 0.9 max_audible = 8 max_audible_behaviour = fail playbackrate_random_offset = { -0.03 0.03 } prevent_random_repetition = yes is3d = yes loop = no }
soundeffect = { name = "alien_infantry_move" falloff = "falloff_80" sounds = { sound = "alien_infantry_move_source" } volume = 0.52 max_audible = 6 max_audible_behaviour = fail playbackrate_random_offset = { -0.06 0.06 } prevent_random_repetition = yes is3d = yes loop = no }
soundeffect = { name = "alien_infantry_idle" falloff = "falloff_80" sounds = { sound = "alien_infantry_idle_source" } volume = 0.35 max_audible = 4 max_audible_behaviour = fail prevent_random_repetition = yes is3d = yes loop = no }
soundeffect = { name = "alien_infantry_death" falloff = "falloff_100" sounds = { sound = "alien_infantry_death_source" } volume = 0.72 max_audible = 5 max_audible_behaviour = fail playbackrate_random_offset = { -0.04 0.04 } prevent_random_repetition = yes is3d = yes loop = no }
