# Event 033 Acid Rain severe forecast cue.
# Plays once for a player whose territory receives a severe cell or superstorm
# forecast. It reuses the base game's one-shot thunder samples
# (weather_thunder_01 to _04, defined in the base game's sound/sound.asset), so
# no audio file is added. The name suffix follows the super-event audio volume
# setting; the x0 setting plays nothing. The six names are listed in the
# Effects category of sound/chaosx_sound.asset.

soundeffect = { name = "chaosx_acid_rain_severe_forecast_cue_0_5" volume = 0.33 sounds = { sound = weather_thunder_01 sound = weather_thunder_02 sound = weather_thunder_03 sound = weather_thunder_04 } max_audible = 1 max_audible_behaviour = fail prevent_random_repetition = yes }
soundeffect = { name = "chaosx_acid_rain_severe_forecast_cue_1_0" volume = 0.67 sounds = { sound = weather_thunder_01 sound = weather_thunder_02 sound = weather_thunder_03 sound = weather_thunder_04 } max_audible = 1 max_audible_behaviour = fail prevent_random_repetition = yes }
soundeffect = { name = "chaosx_acid_rain_severe_forecast_cue_1_5" volume = 1.00 sounds = { sound = weather_thunder_01 sound = weather_thunder_02 sound = weather_thunder_03 sound = weather_thunder_04 } max_audible = 1 max_audible_behaviour = fail prevent_random_repetition = yes }
soundeffect = { name = "chaosx_acid_rain_severe_forecast_cue_2_0" volume = 1.33 sounds = { sound = weather_thunder_01 sound = weather_thunder_02 sound = weather_thunder_03 sound = weather_thunder_04 } max_audible = 1 max_audible_behaviour = fail prevent_random_repetition = yes }
soundeffect = { name = "chaosx_acid_rain_severe_forecast_cue_2_5" volume = 1.67 sounds = { sound = weather_thunder_01 sound = weather_thunder_02 sound = weather_thunder_03 sound = weather_thunder_04 } max_audible = 1 max_audible_behaviour = fail prevent_random_repetition = yes }
soundeffect = { name = "chaosx_acid_rain_severe_forecast_cue_3_0" volume = 2.00 sounds = { sound = weather_thunder_01 sound = weather_thunder_02 sound = weather_thunder_03 sound = weather_thunder_04 } max_audible = 1 max_audible_behaviour = fail prevent_random_repetition = yes }
