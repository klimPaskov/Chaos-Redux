# Git LFS holds only assets Hearts of Iron IV loads: textures, meshes and animations under gfx/,
# sound and music audio, map bitmaps, and the launcher thumbnail. Docs evidence, previews, contact
# sheets, source art, provider downloads, Blender checkpoints and archives never go to LFS; .gitignore
# keeps them out of the repository. See the chaos-redux-event-assets skill, Git LFS storage budget.
gfx/**/*.dds filter=lfs diff=lfs merge=lfs -text
gfx/**/*.tga filter=lfs diff=lfs merge=lfs -text
gfx/**/*.png filter=lfs diff=lfs merge=lfs -text
gfx/**/*.mesh filter=lfs diff=lfs merge=lfs -text
gfx/**/*.anim filter=lfs diff=lfs merge=lfs -text
sound/**/*.wav filter=lfs diff=lfs merge=lfs -text
sound/**/*.ogg filter=lfs diff=lfs merge=lfs -text
music/**/*.ogg filter=lfs diff=lfs merge=lfs -text
map/**/*.bmp filter=lfs diff=lfs merge=lfs -text
map/**/*.dds filter=lfs diff=lfs merge=lfs -text
map/**/*.tga filter=lfs diff=lfs merge=lfs -text
map/**/*.png filter=lfs diff=lfs merge=lfs -text
/thumbnail.png filter=lfs diff=lfs merge=lfs -text
# Maintained non-game binaries (skill reference images, README media, wiki snapshot images,
# workbooks, vendored add-ons) are ordinary Git blobs.
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.mp4 -text
*.xlsx -text
*.zip -text

# Locked 3D adapter/configuration hashes use canonical LF text bytes on Windows.
.tools/3d_pipeline/adapter/*.py text eol=lf
.tools/3d_pipeline/textures/*.py text eol=lf
.tools/3d_pipeline/pack_pdx_material.py text eol=lf
.tools/3d_pipeline/review/pdx_textures.py text eol=lf
.tools/3d_pipeline/review/lab_items.py text eol=lf
.tools/3d_pipeline/blender_client.py text eol=lf
.tools/3d_pipeline/lib/mcp_stdio.py text eol=lf
.tools/3d_pipeline/config/*.json text eol=lf
.tools/3d_pipeline/wrappers/*.mjs text eol=lf

