{
  "disabledMcpjsonServers": [],
  "env": {
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "30000",
    "MAX_MCP_OUTPUT_TOKENS": "30000"
  },
  "permissions": {
    "deny": [
      "Edit(/AGENTS.md)",
      "Edit(/.claude/agent-map.md)",
      "Edit(/.codex/agents/**)",
      "Edit(/.cursor/agents/**)",
      "Edit(/.cursor/agent-map.md)",
      "Edit(/.qoder/agents/**)",
      "Edit(/.opencode/agent/**)",
      "Edit(/.opencode/agent-map.md)",
      "Edit(/docs/spreadsheets/chaos_redux_events_catalog.csv)",
      "Edit(/docs/spreadsheets/chaos_redux_clusters_catalog.csv)",
      "Edit(/docs/spreadsheets/chaos_redux_scenarios_catalog.csv)",
      "Edit(/common/scripted_guis/chaosx_formable_state_puzzles.txt)",
      "Edit(/common/scripted_localisation/chaosx_formable_state_puzzles.txt)",
      "Edit(/localisation/english/chaosx_formable_state_puzzles_l_english.yml)",
      "Edit(/common/script_constants/016_transit_catalog_constants.txt)",
      "Edit(/common/scripted_triggers/016_transit_state_province_catalog_triggers.txt)",
      "Edit(/common/scripted_triggers/016_transit_state_province_catalog_data.txt)",
      "Edit(/interface/chaosx_formable_state_puzzles.gfx)",
      "Edit(/.claude/skills/chaos-redux-ai-strategies/**)",
      "Edit(/.claude/skills/chaos-redux-characters-leaders/**)",
      "Edit(/.claude/skills/chaos-redux-diplomacy-war/**)",
      "Edit(/.claude/skills/chaos-redux-equipment/**)",
      "Edit(/.claude/skills/chaos-redux-ideas-modifiers/**)",
      "Edit(/.claude/skills/chaos-redux-investigate/**)",
      "Edit(/.claude/skills/chaos-redux-map-states/**)",
      "Edit(/.claude/skills/chaos-redux-mtth/**)",
      "Edit(/.claude/skills/chaos-redux-technology-doctrines/**)",
      "Edit(/.claude/skills/chaos-redux-units-divisions/**)",
      "Edit(/.tools/kit_skills/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.tools/py.sh\" -B \"${CLAUDE_PROJECT_DIR}/.tools/sync/generators.py\" --hook",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
