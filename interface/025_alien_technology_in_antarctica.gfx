# ============================================================================
# CHAOS REDUX - EVENT 025 EXPEDITION BOARD VISUAL REGISTRATIONS
# ============================================================================
# The board consumes event-scoped DDS assets. Animation entries always have a
# matching static sprite; the scripted GUI selects the static entry when the
# player has disabled animation. Asset production remains outside this file.
# ============================================================================

spriteTypes = {
	# Decision-category consumers use Event 025's own icon and picture family.
	# The event-specific names keep the rework isolated from the retired UFO-race
	# textures; secondary categories use distinct Event 025 action emblems.
