# ============================================================================
# CHAOS REDUX - EVENT 020 BLACK PLAGUE RESPONSE DASHBOARD
# ============================================================================
# Read-only decision-category attachment for national plague response. Ordinary
# decisions remain the sole action surface; this panel only presents live state.
# ============================================================================

@BLACK_PLAGUE_RESPONSE_GUI_WIDTH = 470
@BLACK_PLAGUE_RESPONSE_GUI_HEIGHT = 272
@BLACK_PLAGUE_RESPONSE_GUI_SEGMENT_SCALE = 0.34

guiTypes = {
	containerWindowType = {
		name = "black_plague_response_category_window"
		position = { x = 0 y = 0 }
		size = { width = @BLACK_PLAGUE_RESPONSE_GUI_WIDTH height = @BLACK_PLAGUE_RESPONSE_GUI_HEIGHT }
		moveable = no
		clipping = yes
		background = { name = "Background" quadTextureSprite = "GFX_tiled_window" }

		iconType = {
			name = "black_plague_response_category_picture"
			spriteType = "GFX_decision_cat_picture_black_plague_response"
			position = { x = 16 y = 14 }
			scale = 0.58
			alwaystransparent = yes
			pdx_tooltip = "black_plague_response_gui_identity_tt"
		}
		instantTextBoxType = {
			name = "black_plague_response_gui_title"
			position = { x = 94 y = 15 }
			font = "hoi_24header"
			text = "black_plague_response_gui_title"
			format = left
			maxWidth = 350
			maxHeight = 30
			fixedsize = yes
			pdx_tooltip = "black_plague_response_gui_identity_tt"
		}
		instantTextBoxType = {
