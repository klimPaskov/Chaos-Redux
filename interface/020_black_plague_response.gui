# ============================================================================
# CHAOS REDUX - EVENT 020 BLACK PLAGUE RESPONSE COMMAND BOARD
# ============================================================================
# Read-only decision-category attachment for national plague response. Ordinary
# decisions remain the sole action surface; this panel only presents live state.
# ============================================================================

@BLACK_PLAGUE_RESPONSE_GUI_WIDTH = 520
@BLACK_PLAGUE_RESPONSE_GUI_HEIGHT = 282
@BLACK_PLAGUE_RESPONSE_GUI_METER_SEGMENT_WIDTH = 96

guiTypes = {
