# ============================================================================
# CHAOS REDUX - EVENT 020 BLACK PLAGUE RESPONSE COMMAND BOARD
# ============================================================================
# Read-only decision-category attachment for national plague response. Ordinary
# decisions remain the sole action surface; this panel only presents live state.
# ============================================================================

@BLACK_PLAGUE_RESPONSE_GUI_WIDTH = 520
@BLACK_PLAGUE_RESPONSE_GUI_HEIGHT = 282
@BLACK_PLAGUE_RESPONSE_GUI_MARGIN = 20
@BLACK_PLAGUE_RESPONSE_GUI_CONTENT_WIDTH = 480
# One progress band is exactly one sprite segment wide, so the five bands fill
# the 480-wide meter without a seam. GFX_black_plague_response_progress_fill is
# 96x27, matching the band width and the meter height.
@BLACK_PLAGUE_RESPONSE_GUI_METER_SEGMENT_WIDTH = 96
@BLACK_PLAGUE_RESPONSE_GUI_METER_BAND_1_X = 0
@BLACK_PLAGUE_RESPONSE_GUI_METER_BAND_2_X = 96
@BLACK_PLAGUE_RESPONSE_GUI_METER_BAND_3_X = 192
@BLACK_PLAGUE_RESPONSE_GUI_METER_BAND_4_X = 288
@BLACK_PLAGUE_RESPONSE_GUI_METER_BAND_5_X = 384
# Vertical rhythm: 14px padding at the top and bottom and a 9px gap between
# every sibling row. Keep both when a row's height changes.

guiTypes = {
	containerWindowType = {
		name = "black_plague_response_category_window"
		position = { x = 0 y = 0 }
		size = { width = @BLACK_PLAGUE_RESPONSE_GUI_WIDTH height = @BLACK_PLAGUE_RESPONSE_GUI_HEIGHT }
		moveable = no
		clipping = yes
		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_window"
		}

		instantTextBoxType = {
			name = "black_plague_response_gui_title"
			position = { x = @BLACK_PLAGUE_RESPONSE_GUI_MARGIN y = 14 }
			font = "hoi_24header"
			text = "black_plague_response_gui_title"
			format = left
			maxWidth = @BLACK_PLAGUE_RESPONSE_GUI_CONTENT_WIDTH
			maxHeight = 30
			fixedsize = yes
			alwaystransparent = yes
			pdx_tooltip = "black_plague_response_gui_identity_tt"
		}
		instantTextBoxType = {
			name = "black_plague_response_gui_programme_status"
			position = { x = @BLACK_PLAGUE_RESPONSE_GUI_MARGIN y = 53 }
			font = "hoi_18mbs"
			text = "black_plague_response_gui_programme_status"
			format = left
			maxWidth = @BLACK_PLAGUE_RESPONSE_GUI_CONTENT_WIDTH
			maxHeight = 36
			fixedsize = yes
			alwaystransparent = yes
			pdx_tooltip = "black_plague_countermeasure_progress_tt"
		}

		instantTextBoxType = {
			name = "black_plague_response_gui_progress_label"
			position = { x = @BLACK_PLAGUE_RESPONSE_GUI_MARGIN y = 98 }
			font = "hoi_18b"
			text = "black_plague_countermeasure_progress_label"
			format = left
			maxWidth = 320
			maxHeight = 24
			fixedsize = yes
			alwaystransparent = yes
			pdx_tooltip = "black_plague_countermeasure_progress_tt"
		}
		instantTextBoxType = {
			name = "black_plague_response_gui_progress_value"
			position = { x = 376 y = 98 }
			font = "hoi_20b"
			text = "black_plague_countermeasure_progress_value"
			format = right
			maxWidth = 124
			maxHeight = 24
			fixedsize = yes
			alwaystransparent = yes
			pdx_tooltip = "black_plague_countermeasure_progress_tt"
		}

		containerWindowType = {
			name = "black_plague_response_gui_progress_meter"
			position = { x = @BLACK_PLAGUE_RESPONSE_GUI_MARGIN y = 131 }
			size = { width = @BLACK_PLAGUE_RESPONSE_GUI_CONTENT_WIDTH height = 27 }
			clipping = yes
			background = {
				name = "black_plague_response_gui_progress_meter_background"
				quadTextureSprite = "GFX_tiled_progress_bar"
				alwaystransparent = yes
				pdx_tooltip = "black_plague_countermeasure_progress_tt"
			}

			iconType = {
				name = "black_plague_response_gui_progress_fill_1"
				position = { x = @BLACK_PLAGUE_RESPONSE_GUI_METER_BAND_1_X y = 0 }
				spriteType = "GFX_black_plague_response_progress_fill"
				alwaystransparent = yes
			}
			iconType = {
				name = "black_plague_response_gui_progress_fill_2"
				position = { x = @BLACK_PLAGUE_RESPONSE_GUI_METER_BAND_2_X y = 0 }
				spriteType = "GFX_black_plague_response_progress_fill"
				alwaystransparent = yes
			}
			iconType = {
				name = "black_plague_response_gui_progress_fill_3"
				position = { x = @BLACK_PLAGUE_RESPONSE_GUI_METER_BAND_3_X y = 0 }
				spriteType = "GFX_black_plague_response_progress_fill"
				alwaystransparent = yes
			}
			iconType = {
				name = "black_plague_response_gui_progress_fill_4"
				position = { x = @BLACK_PLAGUE_RESPONSE_GUI_METER_BAND_4_X y = 0 }
				spriteType = "GFX_black_plague_response_progress_fill"
				alwaystransparent = yes
			}
			iconType = {
				name = "black_plague_response_gui_progress_fill_5"
				position = { x = @BLACK_PLAGUE_RESPONSE_GUI_METER_BAND_5_X y = 0 }
				spriteType = "GFX_black_plague_response_progress_fill"
				alwaystransparent = yes
			}
		}

		containerWindowType = {
			name = "black_plague_response_gui_outbreak_summary"
			position = { x = @BLACK_PLAGUE_RESPONSE_GUI_MARGIN y = 167 }
			size = { width = @BLACK_PLAGUE_RESPONSE_GUI_CONTENT_WIDTH height = 70 }
			clipping = yes
			background = {
				name = "black_plague_response_gui_outbreak_summary_background"
				quadTextureSprite = "GFX_tiled_window_transparent"
				alwaystransparent = yes
			}
			instantTextBoxType = {
				name = "black_plague_response_gui_outbreak_ledger"
				position = { x = 12 y = 21 }
				font = "hoi_18b"
				text = "black_plague_response_gui_outbreak_ledger"
				format = center
				maxWidth = 220
				maxHeight = 28
				fixedsize = yes
				alwaystransparent = yes
				pdx_tooltip = "black_plague_response_gui_outbreak_ledger_tt"
			}
			instantTextBoxType = {
				name = "black_plague_response_gui_response_capacity"
				position = { x = 248 y = 21 }
				font = "hoi_18b"
				text = "black_plague_response_gui_response_capacity"
				format = center
				maxWidth = 220
				maxHeight = 28
				fixedsize = yes
				alwaystransparent = yes
				pdx_tooltip = "black_plague_response_gui_response_capacity_tt"
			}
			instantTextBoxType = {
				name = "black_plague_response_gui_capacity_unorganized"
				position = { x = 248 y = 21 }
				font = "hoi_18b"
				text = "black_plague_response_gui_capacity_unorganized"
				format = center
				maxWidth = 220
				maxHeight = 28
				fixedsize = yes
				alwaystransparent = yes
				pdx_tooltip = "black_plague_response_gui_capacity_unorganized_tt"
			}
		}

		instantTextBoxType = {
			name = "black_plague_response_gui_capacity_warning"
			position = { x = @BLACK_PLAGUE_RESPONSE_GUI_MARGIN y = 246 }
			font = "hoi_16mbs"
			text = "black_plague_response_gui_capacity_warning"
			format = center
			maxWidth = @BLACK_PLAGUE_RESPONSE_GUI_CONTENT_WIDTH
			maxHeight = 22
			fixedsize = yes
			alwaystransparent = yes
			pdx_tooltip = "black_plague_response_gui_capacity_warning_tt"
		}
	}
}
