@MIGRATION_REPORT_HEADER_WIDTH = 470
@MIGRATION_REPORT_HEADER_HEIGHT = 190

guiTypes = {
	containerWindowType = {
		name = "migration_report_header_window"
		position = { x = 0 y = 0 }
		size = { width = @MIGRATION_REPORT_HEADER_WIDTH height = @MIGRATION_REPORT_HEADER_HEIGHT }
		moveable = no
		clipping = yes
		background = { name = "Background" quadTextureSprite = "GFX_tiled_window" }

		iconType = { name = "migration_report_wartime_evacuation" position = { x = 7 y = 7 } spriteType = "GFX_report_event_migration_wartime_evacuation" alwaysTransparent = yes }
		iconType = { name = "migration_report_closed_border" position = { x = 7 y = 7 } spriteType = "GFX_report_event_migration_closed_border" alwaysTransparent = yes }
		iconType = { name = "migration_report_nuclear_evacuation" position = { x = 7 y = 7 } spriteType = "GFX_report_event_migration_nuclear_evacuation" alwaysTransparent = yes }
		iconType = { name = "migration_report_return" position = { x = 7 y = 7 } spriteType = "GFX_report_event_migration_return" alwaysTransparent = yes }

		instantTextBoxType = { name = "migration_report_wartime_evacuation_title" position = { x = 230 y = 14 } font = "hoi_24header" text = "migration_report_wartime_evacuation" format = left maxWidth = 220 maxHeight = 32 fixedsize = yes }
		instantTextBoxType = { name = "migration_report_wartime_evacuation_summary" position = { x = 230 y = 52 } font = "hoi_16mbs" text = "migration_report_wartime_evacuation_summary" format = left maxWidth = 220 maxHeight = 120 fixedsize = yes }
		instantTextBoxType = { name = "migration_report_closed_border_title" position = { x = 230 y = 14 } font = "hoi_24header" text = "migration_report_closed_border" format = left maxWidth = 220 maxHeight = 32 fixedsize = yes }
		instantTextBoxType = { name = "migration_report_closed_border_summary" position = { x = 230 y = 52 } font = "hoi_16mbs" text = "migration_report_closed_border_summary" format = left maxWidth = 220 maxHeight = 120 fixedsize = yes }
		instantTextBoxType = { name = "migration_report_nuclear_evacuation_title" position = { x = 230 y = 14 } font = "hoi_24header" text = "migration_report_nuclear_evacuation" format = left maxWidth = 220 maxHeight = 32 fixedsize = yes }
		instantTextBoxType = { name = "migration_report_nuclear_evacuation_summary" position = { x = 230 y = 52 } font = "hoi_16mbs" text = "migration_report_nuclear_evacuation_summary" format = left maxWidth = 220 maxHeight = 120 fixedsize = yes }
		instantTextBoxType = { name = "migration_report_return_title" position = { x = 230 y = 14 } font = "hoi_24header" text = "migration_report_return" format = left maxWidth = 220 maxHeight = 32 fixedsize = yes }
		instantTextBoxType = { name = "migration_report_return_summary" position = { x = 230 y = 52 } font = "hoi_16mbs" text = "migration_report_return_summary" format = left maxWidth = 220 maxHeight = 120 fixedsize = yes }
	}
}
