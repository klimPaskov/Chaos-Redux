# ============================================================================
# CHAOS REDUX - EVENT 033 ACID RAIN WORLD WINDOW
# ============================================================================
# Dedicated event-owned presentation surface. The 900x600 board is centered
# on every supported resolution and keeps the 560x300 map as the visual anchor.
# The category remains the action surface; this window only reads the projected
# Event 033 presentation model and exposes a read-only refresh control.
#
# Layout at the reference canvas:
#   header and event ledger       x=24..876, y=12..62
#   world map                     x=24..584, y=74..374
#   front/global card stack       x=604..876, y=74..374
#   coverage meter and region rows x=24..584, y=390..500
#   national Preparedness strip   x=24..876, y=508..552
#   footer controls               x=24..876, y=560..594
#
# Decorative map layers, cards, frames, markers, pips, and text are
# click-through. Only the named refresh and close buttons own click regions.
# ============================================================================

@ACID_RAIN_GUI_WIDTH = 900
@ACID_RAIN_GUI_HEIGHT = 600
@ACID_RAIN_GUI_MAP_WIDTH = 560
@ACID_RAIN_GUI_MAP_HEIGHT = 300
@ACID_RAIN_GUI_CARD_WIDTH = 272
@ACID_RAIN_GUI_CARD_HEIGHT = 86
@ACID_RAIN_GUI_COVERAGE_WIDTH = 560

guiTypes = {
	containerWindowType = {
		name = "acid_rain_world_window"
		# Center the upper-left origin explicitly. With a centered screen anchor,
		# subtracting half the board keeps child positions local to the board.
		position = { x = -450 y = -300 }
		orientation = center
		origo = upper_left
		size = { width = @ACID_RAIN_GUI_WIDTH height = @ACID_RAIN_GUI_HEIGHT }
		moveable = no
		clipping = yes
		background = {
			name = "acid_rain_world_window_background"
			quadTextureSprite = "GFX_tiled_window"
		}

		# Header: identity, current phase, and the four required global ledgers.
		instantTextBoxType = {
			name = "acid_rain_world_title"
			position = { x = 24 y = 10 }
			font = "hoi_20b"
			text = "EVENT 033  |  ACID RAIN"
			format = left
			vertical_alignment = center
			maxWidth = 300
			maxHeight = 26
			fixedsize = yes
			alwaystransparent = yes
		}
		instantTextBoxType = {
			name = "acid_rain_world_phase"
			position = { x = 330 y = 12 }
			font = "hoi_16mbs"
			text = "PHASE  [?global.acid_rain_gui_phase|0]"
			format = left
			vertical_alignment = center
			maxWidth = 220
			maxHeight = 22
			fixedsize = yes
			alwaystransparent = yes
		}
		instantTextBoxType = {
			name = "acid_rain_world_global_ledger"
			position = { x = 24 y = 39 }
			font = "hoi_12mbs"
			text = "GLOBAL AIR  [?global.acid_rain_gui_current_air_contamination_bp|0]  |  ADDED  [?global.acid_rain_gui_lifetime_air_added_bp|0]  |  ALLOWANCE  [?global.acid_rain_gui_air_allowance_remaining_bp|0]  |  EVENT DEATHS  [?global.acid_rain_gui_global_deaths|0]"
			format = left
			vertical_alignment = center
			maxWidth = 790
			maxHeight = 18
			fixedsize = yes
			alwaystransparent = yes
			pdx_tooltip = "acid_rain_gui_contamination_tt"
		}
		buttonType = {
			name = "acid_rain_world_close"
			position = { x = -45 y = 13 }
			quadTextureSprite = "GFX_closebutton"
			shortcut = "ESCAPE"
			orientation = upper_right
			clicksound = click_close
			oversound = ui_menu_over
			pdx_tooltip = "CLOSE"
		}

		# ------------------------------------------------------------------------
		# WORLD MAP: all layers are full-map presentation sprites. The source
		# handoff uses a 1672x941 composition, so 0.335 maps it to 560px wide;
		# the 300px panel clips the unused lower edge without moving the anchors.
		# ------------------------------------------------------------------------
		containerWindowType = {
			name = "acid_rain_map_panel"
			position = { x = 24 y = 74 }
