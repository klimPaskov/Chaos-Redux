# ============================================================================
# CHAOS REDUX - EVENT 033 ACID RAIN WORLD WINDOW
# ============================================================================
# Dedicated event-owned presentation surface. The 900x600 board is centered
# on every supported resolution and keeps the 560x300 map as the visual anchor.
# The category remains the action surface; this window only reads the projected
# Event 033 presentation model and exposes a read-only refresh control.
#
# Layout at the reference canvas:
#   header and event ledger       x=24..876, y=12..62
#   world map                     x=24..584, y=74..374
#   front/global card stack       x=604..876, y=74..374
#   coverage meter and region rows x=24..584, y=390..508
#   national Preparedness strip   x=24..876, y=508..552
#   footer controls               x=24..876, y=560..594
#
# Decorative map layers, cards, frames, markers, pips, and text are
# click-through. Only refresh, close, and the country-owned motion toggle
# own click regions. Static partners share each animated consumer's bounds.
# ============================================================================

@ACID_RAIN_GUI_WIDTH = 900
@ACID_RAIN_GUI_HEIGHT = 600
@ACID_RAIN_GUI_MAP_WIDTH = 560
@ACID_RAIN_GUI_MAP_HEIGHT = 300
@ACID_RAIN_GUI_MAP_FIT_SCALE = 0.3188
@ACID_RAIN_GUI_MAP_FIT_X = 13
@ACID_RAIN_GUI_MAP_FIT_Y = 0
@ACID_RAIN_GUI_MAP_MARKER_SCALE = 0.356866
@ACID_RAIN_GUI_CARD_WIDTH = 272
@ACID_RAIN_GUI_CARD_HEIGHT = 86
@ACID_RAIN_GUI_COVERAGE_WIDTH = 560
@ACID_RAIN_GUI_INLAY_WIDTH = 500
@ACID_RAIN_GUI_INLAY_HEIGHT = 92

guiTypes = {
	# Native decision-category attachment. The existing world board below keeps
	# its geometry and is instantiated separately in the player's main context.
	containerWindowType = {
		name = "acid_rain_category_inlay"
		orientation = upper_left
		position = { x = 0 y = 0 }
		size = { width = @ACID_RAIN_GUI_INLAY_WIDTH height = @ACID_RAIN_GUI_INLAY_HEIGHT }
		clipping = yes
		background = { name = "acid_rain_category_inlay_background" quadTextureSprite = "GFX_tiled_window_transparent" }
		instantTextBoxType = {
			name = "acid_rain_category_phase"
			position = { x = 12 y = 4 }
			font = "hoi_16mbs"
			text = "acid_rain_category_phase"
			maxWidth = 472
			maxHeight = 20
			fixedsize = yes
			alwaystransparent = yes
		}
		instantTextBoxType = {
			name = "acid_rain_category_coverage"
			position = { x = 12 y = 28 }
			font = "Arial12"
			text = "acid_rain_category_coverage"
			maxWidth = 235
			maxHeight = 18
			fixedsize = yes
			alwaystransparent = yes
			pdx_tooltip = "acid_rain_gui_coverage_tt"
		}
		instantTextBoxType = {
			name = "acid_rain_category_preparedness"
			position = { x = 255 y = 28 }
			font = "Arial12"
			text = "acid_rain_category_preparedness"
			maxWidth = 220
			maxHeight = 18
			fixedsize = yes
			alwaystransparent = yes
			pdx_tooltip = "acid_rain_gui_preparedness_tt"
		}
		instantTextBoxType = {
			name = "acid_rain_category_status"
			position = { x = 12 y = 56 }
			font = "Arial12"
			text = "acid_rain_category_status"
			maxWidth = 334
			maxHeight = 28
			fixedsize = yes
			alwaystransparent = yes
		}
		buttonType = {
			name = "acid_rain_category_open"
			position = { x = 364 y = 54 }
			quadTextureSprite = "GFX_button_123x34"
			buttonText = "acid_rain_category_open"
			buttonFont = "hoi_16mbs"
			pdx_tooltip = "acid_rain_gui_open_tt"
			clicksound = decisions_ui_button
			oversound = ui_menu_over
		}
	}

	containerWindowType = {
		name = "acid_rain_world_window"
		# Center the upper-left origin explicitly. With a centered screen anchor,
		# subtracting half the board keeps child positions local to the board.
		position = { x = -450 y = -300 }
		orientation = center
		origo = upper_left
		size = { width = @ACID_RAIN_GUI_WIDTH height = @ACID_RAIN_GUI_HEIGHT }
		moveable = no
		clipping = yes
		background = {
			name = "acid_rain_world_window_background"
			quadTextureSprite = "GFX_tiled_window"
		}

		# Header: identity, current phase, and the four required global ledgers.
		instantTextBoxType = {
			name = "acid_rain_world_title"
			orientation = upper_left
			position = { x = 24 y = 10 }
			font = "hoi_20b"
			text = "acid_rain_world_title"
