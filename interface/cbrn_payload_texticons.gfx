		legacy_lazy_load = no
	}
	spriteType = {
		name = "GFX_cbrn_biological_payload_texticon"
		texturefile = "gfx/texticons/cbrn_biological_payload_texticon.dds"
		legacy_lazy_load = no
	}
}
