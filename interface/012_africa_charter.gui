# ============================================================================
# CHAOS REDUX - EVENT 012 CHARTER LEAGUE WINDOW
# ============================================================================
# Decision-category-attached surface. Static and animated art names are kept
# exact to the Event 012 asset matrix; the corresponding binary files are
# intentionally supplied by the art pipeline rather than generated here.
# ============================================================================

@AFRICA_CHARTER_WIDTH = 1000
@AFRICA_CHARTER_HEIGHT = 680
@AFRICA_CHARTER_BUTTON_WIDTH = 286
@AFRICA_CHARTER_BUTTON_HEIGHT = 28

