		iconType = { name = "nr25_militarised_static" spriteType = "GFX_025_expedition_militarised" position = { x = 300 y = 132 } alwaystransparent = yes }
		# One highlight per sector, cut from the sector map at its own offset.
		iconType = { name = "nr25_sector_1_selected" spriteType = "GFX_025_expedition_sector_selected_1" position = { x = 326 y = 157 } scale = @NR25_MAP_SCALE alwaystransparent = yes }
		iconType = { name = "nr25_sector_2_selected" spriteType = "GFX_025_expedition_sector_selected_2" position = { x = 435 y = 141 } scale = @NR25_MAP_SCALE alwaystransparent = yes }
		iconType = { name = "nr25_sector_3_selected" spriteType = "GFX_025_expedition_sector_selected_3" position = { x = 515 y = 132 } scale = @NR25_MAP_SCALE alwaystransparent = yes }
