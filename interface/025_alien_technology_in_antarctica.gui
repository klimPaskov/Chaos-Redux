# ============================================================================
# CHAOS REDUX - EVENT 025 EXPEDITION BOARD
# ============================================================================
# Reference canvas: 1024x640. The board is centered with a 24px downward
# offset so the 1280x720 low target keeps the top bar clear while retaining a
# deliberate 24px outer margin on the reference canvas.
#
# Layout zones:
#   header content      x=24..1000, y=12..76
#   phase banner art    x=300..1000, y=11..131; lower overlap is covered by later panels
#   status column       x=24..296,  y=92..496 (panels 92, 196, 300)
#   Antarctic operations x=300..741, y=92..479
#   rival cards         x=742..1000,y=92..488
#   phase action tray   x=24..1000, y=506..640
#
# All panel art and decorative overlays are click-through. Interactive bounds
# are supplied only by the sector, rival, board-control, and action buttons.
# ============================================================================

@NR25_BOARD_WIDTH = 1024
@NR25_BOARD_HEIGHT = 640
@NR25_BOARD_LEFT = -512
@NR25_BOARD_TOP = -296
@NR25_STATUS_X = 24
@NR25_STATUS_WIDTH = 272
@NR25_MAP_X = 300
@NR25_MAP_WIDTH = 441
@NR25_RIVALS_X = 742
@NR25_RIVALS_WIDTH = 258
@NR25_ACTION_X = 24
@NR25_ACTION_WIDTH = 976
@NR25_MAP_SCALE = 0.63
@NR25_SECTOR_STATE_SCALE = 0.5
@NR25_METER_SCALE = 0.75
@NR25_SUPPORT_ICON_SCALE = 0.75
@NR25_RIVALS_SCALE = 0.92
@NR25_RIVAL_CARD_SCALE = 0.85
@NR25_RIVAL_SELECTED_SCALE = 0.58
@NR25_RIVAL_STATE_SCALE = 0.5
@NR25_RIVAL_INCIDENT_SCALE = 0.8
@NR25_ACTION_CARD_SCALE = 0.78
@NR25_ACTION_STATE_SCALE = 0.55
@NR25_ACTION_TEXT_WIDTH = 88
@NR25_ACTION_TEXT_HEIGHT = 80
@NR25_ACTION_TRAY_SCALE = 1.394
@NR25_CONFIRM_X = 272
@NR25_CONFIRM_Y = 180
@NR25_CONFIRM_WIDTH = 480
@NR25_CONFIRM_HEIGHT = 250

guiTypes = {
	containerWindowType = {
		name = "nr25_expedition_board_window"
		# Centred on screen: the top-left corner sits half a board left of and
		# above the screen centre, lowered by the top-bar offset. Children are
		# positioned from that corner, so no origo override is used.
		position = { x = @NR25_BOARD_LEFT y = @NR25_BOARD_TOP }
		orientation = center
		size = { width = @NR25_BOARD_WIDTH height = @NR25_BOARD_HEIGHT }
		moveable = no
		clipping = yes

		# One complete board canvas. The asset owns only safe background regions;
		# all functional elements are placed in the zones documented above.
		iconType = {
			name = "nr25_board_background"
			spriteType = "GFX_025_expedition_board_background"
			position = { x = 0 y = 0 }
			alwaystransparent = yes
		}

		# Header: identity, phase, broad race state, and deadline remain concise.
		iconType = {
			name = "nr25_board_phase_banner_animated"
			spriteType = "GFX_025_expedition_phase_banner_animated"
			position = { x = 300 y = 11 }
			alwaystransparent = yes
		}
		iconType = {
			name = "nr25_board_phase_banner_static"
			spriteType = "GFX_025_expedition_phase_banner"
			position = { x = 300 y = 11 }
			alwaystransparent = yes
		}
		instantTextBoxType = {
			name = "nr25_board_title"
			position = { x = 36 y = 14 }
			font = "hoi_20b"
			text = "chaosx_nr25_board_title"
			format = left
			vertical_alignment = center
			maxWidth = 300
			maxHeight = 26
			fixedsize = yes
			alwaystransparent = yes
		}
		instantTextBoxType = {
			name = "nr25_board_phase"
			position = { x = 374 y = 14 }
			font = "hoi_16mbs"
			text = "[GetChaosxNr25BoardPhaseText]"
			format = center
			vertical_alignment = center
			maxWidth = 270
			maxHeight = 26
			fixedsize = yes
			pdx_tooltip = "chaosx_nr25_board_phase_tt"
			alwaystransparent = yes
		}
		iconType = {
			name = "nr25_board_deadline_icon"
			spriteType = "GFX_025_expedition_deadline_icon"
			position = { x = 660 y = 16 }
			alwaystransparent = yes
		}
		instantTextBoxType = {
			name = "nr25_board_deadline"
			position = { x = 682 y = 14 }
			font = "hoi_16mbs"
			text = "[GetChaosxNr25BoardDeadlineText]"
			format = left
			vertical_alignment = center
			maxWidth = 128
			maxHeight = 26
			fixedsize = yes
			pdx_tooltip = "chaosx_nr25_board_deadline_tt"
			alwaystransparent = yes
		}
		buttonType = {
			name = "nr25_board_animation"
			position = { x = 814 y = 14 }
			quadTextureSprite = "GFX_025_expedition_control_animation"
			clicksound = decisions_ui_button
			oversound = ui_menu_over
			pdx_tooltip = "chaosx_nr25_board_animation_tt"
		}
		buttonType = {
			name = "nr25_board_refresh"
			position = { x = 850 y = 14 }
			quadTextureSprite = "GFX_025_expedition_control_refresh"
			clicksound = decisions_ui_button
			oversound = ui_menu_over
			pdx_tooltip = "chaosx_nr25_board_refresh_tt"
		}
		buttonType = {
			name = "nr25_board_history"
			position = { x = 886 y = 14 }
			quadTextureSprite = "GFX_025_expedition_control_history"
			clicksound = decisions_ui_button
			oversound = ui_menu_over
			pdx_tooltip = "chaosx_nr25_board_history_tt"
		}
		buttonType = {
			name = "nr25_board_details"
			position = { x = 922 y = 14 }
			quadTextureSprite = "GFX_025_expedition_control_details"
			clicksound = decisions_ui_button
			oversound = ui_menu_over
			pdx_tooltip = "chaosx_nr25_board_details_tt"
		}
		buttonType = {
			name = "nr25_board_close"
			position = { x = 958 y = 14 }
			quadTextureSprite = "GFX_025_expedition_control_close"
			shortcut = "ESCAPE"
			clicksound = menu_close_window
			oversound = ui_menu_over
			pdx_tooltip = "chaosx_nr25_board_close_tt"
		}

		# Left column: exactly three main values. Route, outpost, and target are
		# compact supporting states and never receive a fourth meter.
		iconType = {
			name = "nr25_progress_card"
			spriteType = "GFX_025_expedition_status_panel_compact"
			position = { x = @NR25_STATUS_X y = 92 }
			alwaystransparent = yes
		}
		iconType = {
			name = "nr25_logistics_card"
			spriteType = "GFX_025_expedition_status_panel_compact"
			position = { x = @NR25_STATUS_X y = 196 }
			alwaystransparent = yes
