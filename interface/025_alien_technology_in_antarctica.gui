		buttonType = { name = "nr25_sector_1_select" position = { x = 316 y = 168 } quadTextureSprite = "GFX_025_expedition_sector_hitbox" clicksound = decisions_ui_button oversound = ui_menu_over pdx_tooltip = "chaosx_nr25_sector_1_tt" }
		iconType = { name = "nr25_sector_1_state_icon" spriteType = "GFX_025_expedition_sector_state" position = { x = 336 y = 169 } scale = @NR25_SECTOR_STATE_SCALE alwaystransparent = yes }
		instantTextBoxType = { name = "nr25_sector_1" position = { x = 304 y = 229 } font = "hoi_16mbs" text = "[GetChaosxNr25Sector1StateText]" format = center vertical_alignment = center maxWidth = 120 maxHeight = 34 fixedsize = yes pdx_tooltip = "chaosx_nr25_sector_1_tt" alwaystransparent = yes }

