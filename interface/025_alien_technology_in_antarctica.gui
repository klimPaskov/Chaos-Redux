		# Center operations panel. Sector node buttons are 96x58 hit regions and
		# state overlays/text are click-through, keeping selection geometry exact.
		iconType = {
			name = "nr25_operations_panel"
			spriteType = "GFX_025_expedition_operations_panel"
			position = { x = 300 y = 92 }
			scale = @NR25_MAP_SCALE
			alwaystransparent = yes
		}
		instantTextBoxType = {
			name = "nr25_sector_map_header"
			position = { x = 298 y = 103 }
			font = "hoi_16mbs"
			text = "chaosx_nr25_sector_map_header"
			format = center
			maxWidth = 404
			maxHeight = 22
			fixedsize = yes
			alwaystransparent = yes
		}
		iconType = {
			name = "nr25_sector_map"
			spriteType = "GFX_025_expedition_sector_map"
			position = { x = 300 y = 132 }
			scale = @NR25_MAP_SCALE
			alwaystransparent = yes
		}
		# Evolution overlays are 441x271 frames, the sector map's displayed size,
		# so they need no scale. Each has an animated sheet and a static frame;
		# the viewer's animation setting picks one.
		iconType = { name = "nr25_signal_animated" spriteType = "GFX_025_expedition_signal_animated" position = { x = 300 y = 132 } alwaystransparent = yes }
		iconType = { name = "nr25_signal_static" spriteType = "GFX_025_expedition_signal" position = { x = 300 y = 132 } alwaystransparent = yes }
		iconType = { name = "nr25_survivor_animated" spriteType = "GFX_025_expedition_survivor_animated" position = { x = 300 y = 132 } alwaystransparent = yes }
		iconType = { name = "nr25_survivor_static" spriteType = "GFX_025_expedition_survivor" position = { x = 300 y = 132 } alwaystransparent = yes }
		iconType = { name = "nr25_fragment_animated" spriteType = "GFX_025_expedition_fragment_animated" position = { x = 300 y = 132 } alwaystransparent = yes }
		iconType = { name = "nr25_fragment_static" spriteType = "GFX_025_expedition_fragment" position = { x = 300 y = 132 } alwaystransparent = yes }
		iconType = { name = "nr25_dependence_animated" spriteType = "GFX_025_expedition_dependence_animated" position = { x = 300 y = 132 } alwaystransparent = yes }
