			position = { x = 40 y = 110 }
			alwaystransparent = yes
		}
		iconType = {
			name = "nr25_board_progress_meter"
			spriteType = "GFX_025_expedition_meter_progress_organizing"
			position = { x = 84 y = 131 }
			scale = @NR25_METER_SCALE
			pdx_tooltip = "chaosx_nr25_board_progress_tt"
