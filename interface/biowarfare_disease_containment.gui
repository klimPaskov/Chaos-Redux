# ============================================================================
# CHAOS REDUX - SHARED DISEASE CONTAINMENT BOARD
# ============================================================================
# A compact category header opens the shared disease inspection popup. Standard
# tiled interface components provide the structural shell; disease-specific
# identity, status, and progress art is registered separately by each disease.
# ============================================================================

@DISEASE_BOARD_HEADER_WIDTH = 470
@DISEASE_BOARD_HEADER_HEIGHT = 150
@DISEASE_BOARD_WIDTH = 900
@DISEASE_BOARD_HEIGHT = 650
@DISEASE_BOARD_ENTRY_WIDTH = 376
@DISEASE_BOARD_ENTRY_HEIGHT = 66

guiTypes = {
	containerWindowType = {
		name = "disease_containment_header_window"
		position = { x = 0 y = 0 }
		size = { width = @DISEASE_BOARD_HEADER_WIDTH height = @DISEASE_BOARD_HEADER_HEIGHT }
		moveable = no
		clipping = no
		background = { name = "Background" quadTextureSprite = "GFX_tiled_window" }

		instantTextBoxType = { name = "disease_containment_header_title" position = { x = 22 y = 14 } font = "hoi_24header" text = "disease_containment.gui.header.title" format = left maxWidth = 410 maxHeight = 32 }
		instantTextBoxType = { name = "disease_containment_header_summary" position = { x = 22 y = 48 } font = "hoi_16mbs" text = "disease_containment.gui.header.summary" format = left maxWidth = 420 maxHeight = 54 pdx_tooltip = "disease_containment.gui.header.summary.tt" }
		instantTextBoxType = { name = "disease_containment_header_black_plague" position = { x = 22 y = 104 } font = "hoi_16mbs" text = "disease_containment.gui.header.black_plague" format = left maxWidth = 260 maxHeight = 30 pdx_tooltip = "disease_containment.gui.header.black_plague.tt" }
		buttonType = { name = "disease_containment_board_open" position = { x = 330 y = 106 } spriteType = "GFX_chaosx_button_123x34" buttonFont = "hoi_16mbs" buttonText = "disease_containment.gui.open" clicksound = decisions_ui_button pdx_tooltip = "disease_containment.gui.open.tt" scale = 0.9 }
	}

	containerWindowType = {
		name = "disease_containment_board_window"
		position = { x = 0 y = 18 }
		orientation = center
		size = { width = @DISEASE_BOARD_WIDTH height = @DISEASE_BOARD_HEIGHT }
		moveable = yes
		clipping = no
		background = { name = "Background" quadTextureSprite = "GFX_tiled_window" }

		instantTextBoxType = { name = "disease_containment_board_title" position = { x = 22 y = 14 } font = "hoi_24header" text = "disease_containment.gui.title" format = left maxWidth = 470 maxHeight = 32 }
		instantTextBoxType = { name = "disease_containment_board_global_summary" position = { x = 22 y = 46 } font = "hoi_16mbs" text = "disease_containment.gui.global_summary" format = left maxWidth = 610 maxHeight = 44 pdx_tooltip = "disease_containment.gui.global_summary.tt" }
		buttonType = { name = "disease_containment_board_refresh" position = { x = 640 y = 16 } spriteType = "GFX_chaosx_button_123x34" buttonFont = "hoi_16mbs" buttonText = "disease_containment.gui.refresh" clicksound = decisions_ui_button pdx_tooltip = "disease_containment.gui.refresh.tt" scale = 0.78 }
		buttonType = { name = "disease_containment_board_close" position = { x = 780 y = 16 } spriteType = "GFX_chaosx_button_123x34" buttonFont = "hoi_16mbs" buttonText = "disease_containment.gui.close" clicksound = decisions_ui_button pdx_tooltip = "disease_containment.gui.close.tt" scale = 0.78 }

		buttonType = { name = "disease_containment_board_tab_anthrax" position = { x = 18 y = 92 } spriteType = "GFX_chaosx_button_123x34" buttonFont = "hoi_16mbs" buttonText = "disease_containment.gui.tab.anthrax" clicksound = decisions_ui_button pdx_tooltip = "disease_containment.gui.tab.anthrax.tt" scale = 0.9 }
		buttonType = { name = "disease_containment_board_tab_plague" position = { x = 150 y = 92 } spriteType = "GFX_chaosx_button_123x34" buttonFont = "hoi_16mbs" buttonText = "disease_containment.gui.tab.plague" clicksound = decisions_ui_button pdx_tooltip = "disease_containment.gui.tab.plague.tt" scale = 0.9 }
		buttonType = { name = "disease_containment_board_tab_tularemia" position = { x = 282 y = 92 } spriteType = "GFX_chaosx_button_123x34" buttonFont = "hoi_16mbs" buttonText = "disease_containment.gui.tab.tularemia" clicksound = decisions_ui_button pdx_tooltip = "disease_containment.gui.tab.tularemia.tt" scale = 0.9 }
		buttonType = { name = "disease_containment_board_tab_smallpox" position = { x = 414 y = 92 } spriteType = "GFX_chaosx_button_123x34" buttonFont = "hoi_16mbs" buttonText = "disease_containment.gui.tab.smallpox" clicksound = decisions_ui_button pdx_tooltip = "disease_containment.gui.tab.smallpox.tt" scale = 0.9 }
		buttonType = { name = "disease_containment_board_tab_black_plague" position = { x = 546 y = 92 } spriteType = "GFX_chaosx_button_123x34" buttonFont = "hoi_16mbs" buttonText = "disease_containment.gui.tab.black_plague" clicksound = decisions_ui_button pdx_tooltip = "disease_containment.gui.tab.black_plague.tt" scale = 1.08 }

		instantTextBoxType = { name = "disease_containment_board_country_summary" position = { x = 22 y = 140 } font = "hoi_16mbs" text = "disease_containment.gui.country_summary" format = left maxWidth = 850 maxHeight = 48 pdx_tooltip = "disease_containment.gui.country_summary.tt" }

		buttonType = { name = "disease_containment_board_status_filter" position = { x = 18 y = 194 } spriteType = "GFX_sort_button_100x29" buttonFont = "hoi_16mbs" buttonText = "disease_containment.gui.filter.status" clicksound = decisions_ui_button pdx_tooltip = "disease_containment.gui.filter.status.tt" scale = 1.08 }
		buttonType = { name = "disease_containment_board_ownership_filter" position = { x = 132 y = 194 } spriteType = "GFX_sort_button_100x29" buttonFont = "hoi_16mbs" buttonText = "disease_containment.gui.filter.ownership" clicksound = decisions_ui_button pdx_tooltip = "disease_containment.gui.filter.ownership.tt" scale = 1.08 }
		buttonType = { name = "disease_containment_board_urgency_filter" position = { x = 246 y = 194 } spriteType = "GFX_sort_button_100x29" buttonFont = "hoi_16mbs" buttonText = "disease_containment.gui.filter.urgency" clicksound = decisions_ui_button pdx_tooltip = "disease_containment.gui.filter.urgency.tt" scale = 1.08 }
		instantTextBoxType = { name = "disease_containment_board_state_list_header" position = { x = 22 y = 230 } font = "hoi_18b" text = "disease_containment.gui.states" format = left maxWidth = 380 maxHeight = 28 }

		containerWindowType = {
			name = "disease_containment_board_state_list_panel"
			position = { x = 18 y = 260 }
			size = { width = 400 height = 338 }
			clipping = yes
			verticalScrollbar = "right_vertical_slider_intel"
			scroll_wheel_factor = 40
			smooth_scrolling = yes
			background = { name = "Background" quadTextureSprite = "GFX_tiled_window_transparent" }
			gridBoxType = { name = "disease_containment_board_state_dynamic_list" position = { x = 4 y = 0 } size = { width = @DISEASE_BOARD_ENTRY_WIDTH height = 338 } slotsize = { width = @DISEASE_BOARD_ENTRY_WIDTH height = @DISEASE_BOARD_ENTRY_HEIGHT } format = "UPPER_LEFT" max_slots_horizontal = 1 }
		}

		instantTextBoxType = { name = "disease_containment_board_no_states" position = { x = 44 y = 286 } font = "hoi_18mbs" text = "disease_containment.gui.no_states" format = center maxWidth = 330 maxHeight = 80 }

		containerWindowType = {
			name = "disease_containment_board_selected_card"
			position = { x = 438 y = 194 }
			size = { width = 438 height = 404 }
			clipping = no
			background = { name = "Background" quadTextureSprite = "GFX_tiled_window_transparent" }

			instantTextBoxType = { name = "disease_containment_board_selected_title" position = { x = 16 y = 12 } font = "hoi_20b" text = "disease_containment.gui.selected.title" format = left maxWidth = 350 maxHeight = 30 }
			instantTextBoxType = { name = "disease_containment_board_selected_summary" position = { x = 16 y = 50 } font = "hoi_18mbs" text = "disease_containment.gui.selected.summary" format = left maxWidth = 400 maxHeight = 72 pdx_tooltip = "disease_containment.gui.selected.summary.tt" }
			instantTextBoxType = { name = "disease_containment_board_selected_card_private_values" position = { x = 16 y = 126 } font = "hoi_16mbs" text = "disease_containment.gui.selected.private_values" format = left maxWidth = 400 maxHeight = 154 pdx_tooltip = "disease_containment.gui.selected.private_values.tt" }
			instantTextBoxType = { name = "disease_containment_board_selected_card_public_values" position = { x = 16 y = 126 } font = "hoi_16mbs" text = "disease_containment.gui.selected.public_values" format = left maxWidth = 400 maxHeight = 154 pdx_tooltip = "disease_containment.gui.selected.public_values.tt" }
			instantTextBoxType = { name = "disease_containment_board_response_target" position = { x = 16 y = 288 } font = "hoi_16mbs" text = "disease_containment.gui.response_target" format = left maxWidth = 400 maxHeight = 48 pdx_tooltip = "disease_containment.gui.response_target.tt" }
			buttonType = { name = "disease_containment_board_goto" position = { x = 16 y = 352 } spriteType = "GFX_chaosx_button_123x34" buttonFont = "hoi_16mbs" buttonText = "disease_containment.gui.goto" clicksound = decisions_ui_button pdx_tooltip = "disease_containment.gui.goto.tt" scale = 0.9 }
		}
	}

	containerWindowType = {
		name = "disease_containment_board_state_entry"
		position = { x = 0 y = 0 }
		size = { width = @DISEASE_BOARD_ENTRY_WIDTH height = @DISEASE_BOARD_ENTRY_HEIGHT }
		background = { name = "Background" quadTextureSprite = "GFX_tiled_window_transparent" }
		buttonType = { name = "disease_containment_board_state_entry_select" position = { x = 0 y = 0 } size = { x = @DISEASE_BOARD_ENTRY_WIDTH y = @DISEASE_BOARD_ENTRY_HEIGHT } quadTextureSprite = "GFX_tiled_window_transparent" clicksound = decisions_ui_button pdx_tooltip = "disease_containment.gui.state_entry.select.tt" }
		instantTextBoxType = { name = "disease_containment_board_state_entry_text" position = { x = 12 y = 8 } font = "hoi_16mbs" text = "disease_containment.gui.state_entry" format = left maxWidth = 276 maxHeight = 52 alwaysTransparent = yes }
		instantTextBoxType = { name = "disease_containment_board_state_entry_selected" position = { x = 292 y = 8 } font = "hoi_16mbs" text = "disease_containment.gui.state_entry.view" format = right maxWidth = 72 maxHeight = 24 alwaysTransparent = yes }
		instantTextBoxType = { name = "disease_containment_board_state_entry_response" position = { x = 292 y = 34 } font = "hoi_16mbs" text = "disease_containment.gui.state_entry.response" format = right maxWidth = 72 maxHeight = 24 alwaysTransparent = yes }
	}
}
