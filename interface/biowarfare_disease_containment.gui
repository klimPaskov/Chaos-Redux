# ============================================================================
# CHAOS REDUX - SHARED DISEASE CONTAINMENT BOARD
# ============================================================================
# A compact category header opens one information view of the country's outbreak
# situation: national readiness, an overall status line, and a scrollable list of
# affected states (worst first) with the selected state's report beside it.
# Standard tiled interface components provide the structural shell. The board has
# no per-disease selector; disease actions are decisions in the category.
# ============================================================================

@DISEASE_BOARD_HEADER_WIDTH = 470
@DISEASE_BOARD_HEADER_HEIGHT = 136
@DISEASE_BOARD_WIDTH = 820
@DISEASE_BOARD_HEIGHT = 450
@DISEASE_BOARD_ENTRY_WIDTH = 376
@DISEASE_BOARD_ENTRY_HEIGHT = 50

guiTypes = {
	containerWindowType = {
		name = "disease_containment_header_window"
		position = { x = 0 y = 0 }
		size = { width = @DISEASE_BOARD_HEADER_WIDTH height = @DISEASE_BOARD_HEADER_HEIGHT }
		moveable = no
		clipping = yes
		background = { name = "Background" quadTextureSprite = "GFX_tiled_window" }

		instantTextBoxType = { name = "disease_containment_header_title" position = { x = 22 y = 14 } font = "hoi_24header" text = "disease_containment.gui.header.title" format = left maxWidth = 410 maxHeight = 32 fixedsize = yes }
		instantTextBoxType = { name = "disease_containment_header_summary" position = { x = 22 y = 50 } font = "hoi_16mbs" text = "disease_containment.gui.header.summary" format = left maxWidth = 420 maxHeight = 44 fixedsize = yes pdx_tooltip = "disease_containment.gui.header.summary.tt" }

	}

	containerWindowType = {
		name = "disease_containment_board_window"
		position = { x = -410 y = -225 }
		orientation = center
		size = { width = @DISEASE_BOARD_WIDTH height = @DISEASE_BOARD_HEIGHT }
		moveable = yes
		clipping = yes
		background = { name = "Background" quadTextureSprite = "GFX_tiled_window" }

		instantTextBoxType = { name = "disease_containment_board_title" orientation = UPPER_LEFT position = { x = 20 y = 14 } font = "hoi_24header" text = "disease_containment.gui.title" format = left maxWidth = 510 maxHeight = 32 fixedsize = yes }
		buttonType = { name = "disease_containment_board_refresh" orientation = UPPER_LEFT position = { x = 548 y = 14 } spriteType = "GFX_chaosx_button_123x34" buttonFont = "hoi_16mbs" buttonText = "disease_containment.gui.refresh" clicksound = decisions_ui_button pdx_tooltip = "disease_containment.gui.refresh.tt" scale = 1 }
		buttonType = { name = "disease_containment_board_close" orientation = UPPER_LEFT position = { x = 680 y = 14 } spriteType = "GFX_chaosx_button_123x34" buttonFont = "hoi_16mbs" buttonText = "disease_containment.gui.close" clicksound = decisions_ui_button pdx_tooltip = "disease_containment.gui.close.tt" scale = 1 }

		# Overall status line and national readiness.
		instantTextBoxType = { name = "disease_containment_board_phase" orientation = UPPER_LEFT position = { x = 20 y = 56 } font = "hoi_18mbs" text = "disease_containment.gui.phase" format = left maxWidth = 780 maxHeight = 24 fixedsize = yes pdx_tooltip = "disease_containment.gui.phase.tt" }
		iconType = { name = "disease_containment_board_preparedness_icon" orientation = UPPER_LEFT position = { x = 20 y = 80 } spriteType = "GFX_decision_bio_expand_biosecurity_capacity" alwaysTransparent = yes }
		instantTextBoxType = { name = "disease_containment_board_preparedness" orientation = UPPER_LEFT position = { x = 60 y = 86 } font = "hoi_18mbs" text = "disease_containment.gui.preparedness" format = left maxWidth = 210 maxHeight = 24 fixedsize = yes pdx_tooltip = "disease_containment.gui.preparedness.tt" }
		iconType = { name = "disease_containment_board_medical_icon" orientation = UPPER_LEFT position = { x = 290 y = 80 } spriteType = "GFX_decision_bio_expand_medical_capacity" alwaysTransparent = yes }
		instantTextBoxType = { name = "disease_containment_board_medical" orientation = UPPER_LEFT position = { x = 330 y = 86 } font = "hoi_18mbs" text = "disease_containment.gui.medical" format = left maxWidth = 220 maxHeight = 24 fixedsize = yes pdx_tooltip = "disease_containment.gui.medical.tt" }

		instantTextBoxType = { name = "disease_containment_board_state_list_header" orientation = UPPER_LEFT position = { x = 24 y = 126 } font = "hoi_18b" text = "disease_containment.gui.states" format = left maxWidth = 380 maxHeight = 28 fixedsize = yes }

		containerWindowType = {
			name = "disease_containment_board_select_hint"
			orientation = UPPER_LEFT
			position = { x = 436 y = 126 }
			size = { width = 364 height = 300 }
			background = { name = "Background" quadTextureSprite = "GFX_tiled_window_transparent" }
			instantTextBoxType = { name = "disease_containment_board_select_hint_text" orientation = UPPER_LEFT position = { x = 16 y = 16 } font = "hoi_18mbs" text = "disease_containment.gui.select_hint" format = left maxWidth = 332 maxHeight = 64 fixedsize = yes }
		}

		containerWindowType = {
			name = "disease_containment_board_state_list_panel"
			position = { x = 20 y = 156 }
			orientation = UPPER_LEFT
			size = { width = 400 height = 270 }
			clipping = yes
			verticalScrollbar = "right_vertical_slider_intel"
			scroll_wheel_factor = 50
			smooth_scrolling = yes
			background = { name = "Background" quadTextureSprite = "GFX_tiled_window_transparent" }
			gridBoxType = { name = "disease_containment_board_state_dynamic_list" orientation = UPPER_LEFT position = { x = 4 y = 0 } size = { width = @DISEASE_BOARD_ENTRY_WIDTH height = 270 } slotsize = { width = @DISEASE_BOARD_ENTRY_WIDTH height = @DISEASE_BOARD_ENTRY_HEIGHT } format = "UPPER_LEFT" max_slots_horizontal = 1 }
		}

		instantTextBoxType = { name = "disease_containment_board_no_states" orientation = UPPER_LEFT position = { x = 44 y = 236 } font = "hoi_18mbs" text = "disease_containment.gui.no_states" format = center maxWidth = 330 maxHeight = 54 fixedsize = yes }

		containerWindowType = {
			name = "disease_containment_board_selected_card"
			position = { x = 436 y = 126 }
			orientation = UPPER_LEFT
			size = { width = 364 height = 300 }
			clipping = yes
			background = { name = "Background" quadTextureSprite = "GFX_tiled_window_transparent" }

			instantTextBoxType = { name = "disease_containment_board_selected_title" orientation = UPPER_LEFT position = { x = 16 y = 12 } font = "hoi_20b" text = "disease_containment.gui.selected.title" format = left maxWidth = 296 maxHeight = 30 fixedsize = yes }
			iconType = { name = "disease_containment_board_black_plague_crisis_seal" orientation = UPPER_LEFT position = { x = 306 y = 8 } spriteType = "GFX_black_plague_crisis_seal_static" scale = 0.45 alwaysTransparent = yes pdx_tooltip = "disease_containment.gui.selected.black_plague_crisis_seal.tt" }
			iconType = { name = "disease_containment_board_black_plague_crisis_seal_animated" orientation = UPPER_LEFT position = { x = 306 y = 8 } spriteType = "GFX_black_plague_crisis_seal_animated" scale = 0.45 alwaysTransparent = yes pdx_tooltip = "disease_containment.gui.selected.black_plague_crisis_seal.tt" }
			instantTextBoxType = { name = "disease_containment_board_selected_summary" orientation = UPPER_LEFT position = { x = 16 y = 48 } font = "hoi_16mbs" text = "disease_containment.gui.selected.summary" format = left maxWidth = 332 maxHeight = 106 fixedsize = yes pdx_tooltip = "disease_containment.gui.selected.summary.tt" }
			instantTextBoxType = { name = "disease_containment_board_selected_card_private_values" orientation = UPPER_LEFT position = { x = 16 y = 160 } font = "hoi_16mbs" text = "disease_containment.gui.selected.private_values" format = left maxWidth = 332 maxHeight = 70 fixedsize = yes pdx_tooltip = "disease_containment.gui.selected.private_values.tt" }
			instantTextBoxType = { name = "disease_containment_board_selected_card_public_values" orientation = UPPER_LEFT position = { x = 16 y = 160 } font = "hoi_16mbs" text = "disease_containment.gui.selected.public_values" format = left maxWidth = 332 maxHeight = 70 fixedsize = yes pdx_tooltip = "disease_containment.gui.selected.public_values.tt" }
			instantTextBoxType = { name = "disease_containment_board_black_plague_metrics" orientation = UPPER_LEFT position = { x = 16 y = 160 } font = "hoi_16mbs" text = "disease_containment.gui.selected.black_plague_metrics" format = left maxWidth = 332 maxHeight = 70 fixedsize = yes pdx_tooltip = "disease_containment.gui.selected.black_plague_metrics.tt" }
			instantTextBoxType = { name = "disease_containment_board_response_target" orientation = UPPER_LEFT position = { x = 16 y = 234 } font = "hoi_16mbs" text = "disease_containment.gui.response_target" format = left maxWidth = 332 maxHeight = 22 fixedsize = yes pdx_tooltip = "disease_containment.gui.response_target.tt" }
			buttonType = { name = "disease_containment_board_goto" orientation = UPPER_LEFT position = { x = 16 y = 258 } spriteType = "GFX_chaosx_button_123x34" buttonFont = "hoi_16mbs" buttonText = "disease_containment.gui.goto" clicksound = decisions_ui_button pdx_tooltip = "disease_containment.gui.goto.tt" scale = 1 }
		}
	}

	containerWindowType = {
		name = "disease_containment_board_state_entry"
		orientation = UPPER_LEFT
		position = { x = 0 y = 0 }
		size = { width = @DISEASE_BOARD_ENTRY_WIDTH height = @DISEASE_BOARD_ENTRY_HEIGHT }
		background = { name = "Background" quadTextureSprite = "GFX_tiled_window_transparent" }
		buttonType = { name = "disease_containment_board_state_entry_select" orientation = UPPER_LEFT position = { x = 0 y = 0 } size = { x = @DISEASE_BOARD_ENTRY_WIDTH y = @DISEASE_BOARD_ENTRY_HEIGHT } quadTextureSprite = "GFX_tiled_window_transparent" clicksound = decisions_ui_button pdx_tooltip = "disease_containment.gui.state_entry.select.tt" }
		instantTextBoxType = { name = "disease_containment_board_state_entry_text" orientation = UPPER_LEFT position = { x = 12 y = 4 } font = "hoi_16mbs" text = "disease_containment.gui.state_entry" format = left maxWidth = 352 maxHeight = 42 fixedsize = yes alwaysTransparent = yes }
	}
}
