			position = { x = 18 y = 262 }
			size = { width = 394 height = @CANNIBALISM_NETWORK_LIST_HEIGHT }
			clipping = yes
			verticalScrollbar = "right_vertical_slider"
			scroll_wheel_factor = 40
			smooth_scrolling = yes
			background = { name = "Background" quadTextureSprite = "GFX_tiled_window_transparent" }
			gridBoxType = { name = "cannibalism_network_country_dynamic_list" position = { x = 4 y = 0 } size = { width = 374 height = @CANNIBALISM_NETWORK_LIST_HEIGHT } slotsize = { width = @CANNIBALISM_NETWORK_ENTRY_WIDTH height = @CANNIBALISM_NETWORK_ENTRY_HEIGHT } format = "UPPER_LEFT" max_slots_horizontal = 1 }
		}
		containerWindowType = {
			name = "cannibalism_network_state_list_panel"
			position = { x = 431 y = 262 }
			size = { width = 394 height = @CANNIBALISM_NETWORK_LIST_HEIGHT }
			clipping = yes
			verticalScrollbar = "right_vertical_slider"
