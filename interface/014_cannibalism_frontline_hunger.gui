		iconType = { name = "cannibalism_cult_emblem_static" spriteType = "GFX_cannibalism_cult_cohesion_emblem_static" position = { x = 372 y = 146 } }

		instantTextBoxType = { name = "cannibalism_early_mission_summary" position = { x = 304 y = 210 } font = "hoi_16mbs" text = "cannibalism.gui.active_mission" format = center maxWidth = 153 maxHeight = 54 fixedsize = yes pdx_tooltip = "cannibalism.gui.active_mission.tt" }
		buttonType = { name = "cannibalism_network_open" position = { x = 335 y = 266 } spriteType = "GFX_chaosx_button_123x34" buttonFont = "hoi_16mbs" buttonText = "cannibalism.gui.open_network" clicksound = decisions_ui_button oversound = ui_menu_over pdx_tooltip = "cannibalism.gui.open_network.tt" scale = 0.86 }
	}

	containerWindowType = {
		name = "cannibalism_network_window"
