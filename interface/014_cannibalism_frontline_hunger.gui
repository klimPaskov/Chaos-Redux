# ============================================================================
# CHAOS REDUX - EVENT 014 MECHANIC WINDOWS
# ============================================================================
# Five gated player surfaces: early containment, organized network, warlord
# command, revealed command, and Wendigo transformation. Gameplay actions stay
# in decisions; these windows expose live state and safe view controls.
# ============================================================================

@CANNIBALISM_HEADER_WIDTH = 470
@CANNIBALISM_EARLY_HEIGHT = 304
@CANNIBALISM_WARLORD_HEIGHT = 340
@CANNIBALISM_REVEALED_HEIGHT = 380
@CANNIBALISM_WENDIGO_HEIGHT = 400
@CANNIBALISM_NETWORK_WIDTH = 860
@CANNIBALISM_NETWORK_HEIGHT = 620
@CANNIBALISM_NETWORK_ENTRY_WIDTH = 374
@CANNIBALISM_NETWORK_ENTRY_HEIGHT = 64
@CANNIBALISM_NETWORK_LEFT = -430
@CANNIBALISM_NETWORK_TOP = -295
@CANNIBALISM_NETWORK_LIST_HEIGHT = 200
@CANNIBALISM_NETWORK_DETAIL_WIDTH = 820
@CANNIBALISM_NETWORK_DETAIL_HEIGHT = 136

guiTypes = {
	containerWindowType = {
		name = "cannibalism_early_header_window"
		position = { x = 0 y = 0 }
		size = { width = @CANNIBALISM_HEADER_WIDTH height = @CANNIBALISM_EARLY_HEIGHT }
		moveable = no
		clipping = yes

		iconType = { name = "cannibalism_early_background" spriteType = "GFX_cannibalism_early_category_background" position = { x = 0 y = 0 } }
		instantTextBoxType = { name = "cannibalism_early_title" position = { x = 24 y = 14 } font = "hoi_24header" text = "cannibalism.gui.early.title" format = left maxWidth = 330 maxHeight = 32 fixedsize = yes }

		iconType = { name = "cannibalism_field_hunger_meter" spriteType = "GFX_cannibalism_field_hunger_meter" position = { x = 20 y = 54 } }
		instantTextBoxType = { name = "cannibalism_field_hunger_value" position = { x = 34 y = 64 } font = "hoi_18mbs" text = "cannibalism.gui.field_hunger" format = left maxWidth = 244 maxHeight = 28 fixedsize = yes pdx_tooltip = "cannibalism.gui.field_hunger.tt" }

		iconType = { name = "cannibalism_command_integrity_meter" spriteType = "GFX_cannibalism_command_integrity_meter" position = { x = 20 y = 104 } }
		instantTextBoxType = { name = "cannibalism_command_integrity_value" position = { x = 34 y = 114 } font = "hoi_18mbs" text = "cannibalism.gui.command_integrity" format = left maxWidth = 244 maxHeight = 28 fixedsize = yes pdx_tooltip = "cannibalism.gui.command_integrity.tt" }

