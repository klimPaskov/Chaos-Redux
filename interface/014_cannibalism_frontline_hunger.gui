		iconType = { name = "cannibalism_primary_state_card" spriteType = "GFX_cannibalism_primary_state_card" position = { x = 20 y = 204 } }
		instantTextBoxType = { name = "cannibalism_primary_state_text" position = { x = 34 y = 214 } font = "hoi_16mbs" text = "cannibalism.gui.primary_state" format = left maxWidth = 244 maxHeight = 52 fixedsize = yes pdx_tooltip = "cannibalism.gui.primary_state.tt" }

		iconType = { name = "cannibalism_early_warning_animated" spriteType = "GFX_cannibalism_early_warning_seal_animated" position = { x = 372 y = 76 } }
		iconType = { name = "cannibalism_early_warning_static" spriteType = "GFX_cannibalism_early_warning_seal_static" position = { x = 372 y = 76 } }
