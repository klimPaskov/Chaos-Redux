guiTypes = {
	# All Settings window: every adjustable Chaos Redux setting in one scrollable list.
	# Opened from Settings > Advanced Settings > Show All Settings. Wiring lives in
	# common/scripted_guis/chaosx_scripted_gui_all_settings.txt and reuses the same
	# scripted effects and variables as the settings pages.
	containerWindowType = {
		name = "chaosx_all_settings_window"
		position = { x = -300 y = -270 }
		size = { width = 600 height = 540 }
		orientation = center
		moveable = yes
		click_to_front = yes
		show_sound = menu_open_window
		hide_sound = menu_close_window

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_window_2b_border"
		}

		instantTextBoxType = {
			name = "all_settings_title"
			position = { x = 20 y = 16 }
			textureFile = ""
			font = "hoi_24header"
			borderSize = { x = 0 y = 0 }
			text = "chaosx.all_settings.title"
			maxWidth = 560
			maxHeight = 28
			format = center
			alwaysTransparent = yes
		}

		buttonType = {
			name = "all_settings_close_button"
			position = { x = 570 y = 12 }
			quadTextureSprite = "GFX_closebutton_small"
			clicksound = click_close
			pdx_tooltip = "chaosx.all_settings.close.tt"
		}

		instantTextBoxType = {
			name = "all_settings_hint"
			position = { x = 20 y = 46 }
			textureFile = ""
			font = "hoi_16mbs"
			borderSize = { x = 0 y = 0 }
			text = "chaosx.all_settings.hint"
			maxWidth = 560
			maxHeight = 20
			format = center
			alwaysTransparent = yes
		}

		containerWindowType = {
			name = "all_settings_scroll"
			position = { x = 16 y = 72 }
			size = { width = 568 height = 452 }
			orientation = upper_left
			click_to_front = no
			clipping = yes
			margin = { top = 0 left = 0 bottom = 0 right = 16 }
			verticalScrollbar = "right_vertical_slider"
			autohide_scrollbars = no
			scroll_wheel_factor = 44
			smooth_scrolling = yes

			background = {
				name = "Background"
				quadTextureSprite = "GFX_tiled_plain_bg"
			}

			containerWindowType = {
				name = "all_settings_content"
