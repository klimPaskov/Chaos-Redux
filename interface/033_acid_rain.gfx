# ============================================================================
# CHAOS REDUX - EVENT 033 ACID RAIN GUI VISUAL REGISTRATIONS
# ============================================================================
# Event-owned sprite registrations for the bounded world window. The final
# DDS package is supplied by the Event 033 asset handoff; this file keeps the
# names stable so layout and presentation wiring do not need to move later.
# Animation entries are intentionally not declared until reviewed frame-sheet
# outputs exist. The GUI uses the named static sprites as the safe fallback.
# ============================================================================

spriteTypes = {
	# Map composition and the seven stable region masks.
	spriteType = { name = "GFX_acid_rain_map_base" texturefile = "gfx/interface/033_acid_rain/gui/acid_rain_map_base.dds" noOfFrames = 1 }
	spriteType = { name = "GFX_acid_rain_region_overlay_1" texturefile = "gfx/interface/033_acid_rain/gui/acid_rain_region_overlay_1.dds" noOfFrames = 1 }
	spriteType = { name = "GFX_acid_rain_region_overlay_2" texturefile = "gfx/interface/033_acid_rain/gui/acid_rain_region_overlay_2.dds" noOfFrames = 1 }
	spriteType = { name = "GFX_acid_rain_region_overlay_3" texturefile = "gfx/interface/033_acid_rain/gui/acid_rain_region_overlay_3.dds" noOfFrames = 1 }
	spriteType = { name = "GFX_acid_rain_region_overlay_4" texturefile = "gfx/interface/033_acid_rain/gui/acid_rain_region_overlay_4.dds" noOfFrames = 1 }
	spriteType = { name = "GFX_acid_rain_region_overlay_5" texturefile = "gfx/interface/033_acid_rain/gui/acid_rain_region_overlay_5.dds" noOfFrames = 1 }
	spriteType = { name = "GFX_acid_rain_region_overlay_6" texturefile = "gfx/interface/033_acid_rain/gui/acid_rain_region_overlay_6.dds" noOfFrames = 1 }
	spriteType = { name = "GFX_acid_rain_region_overlay_7" texturefile = "gfx/interface/033_acid_rain/gui/acid_rain_region_overlay_7.dds" noOfFrames = 1 }

	# Presentation veils use distinct static layers so visited coverage never
	# shares the warning colour language.
	spriteType = { name = "GFX_acid_rain_visited_veil" texturefile = "gfx/interface/033_acid_rain/gui/acid_rain_visited_veil.dds" noOfFrames = 1 }
	spriteType = { name = "GFX_acid_rain_warning_veil" texturefile = "gfx/interface/033_acid_rain/gui/acid_rain_warning_veil.dds" noOfFrames = 1 }
	spriteType = { name = "GFX_acid_rain_ordinary_veil" texturefile = "gfx/interface/033_acid_rain/gui/acid_rain_ordinary_veil.dds" noOfFrames = 1 }
	spriteType = { name = "GFX_acid_rain_global_veil" texturefile = "gfx/interface/033_acid_rain/gui/acid_rain_global_veil.dds" noOfFrames = 1 }

	# Static marker fallbacks. The frame-animation handoff may later add
	# separate animated names without changing these consumers.
	spriteType = { name = "GFX_acid_rain_front_marker" texturefile = "gfx/interface/033_acid_rain/gui/acid_rain_front_marker.dds" noOfFrames = 1 }
	spriteType = { name = "GFX_acid_rain_warning_marker" texturefile = "gfx/interface/033_acid_rain/gui/acid_rain_warning_marker.dds" noOfFrames = 1 }
	spriteType = { name = "GFX_acid_rain_severe_marker" texturefile = "gfx/interface/033_acid_rain/gui/acid_rain_severe_marker.dds" noOfFrames = 1 }

	# Structural cards and meters. The background and coverage assets are
	# consumed as quad sprites so the bounded layout owns the safe dimensions.
	spriteType = { name = "GFX_acid_rain_card_background" texturefile = "gfx/interface/033_acid_rain/gui/acid_rain_card_background.dds" noOfFrames = 1 }
	spriteType = { name = "GFX_acid_rain_coverage_frame" texturefile = "gfx/interface/033_acid_rain/gui/acid_rain_coverage_frame.dds" noOfFrames = 1 }
	spriteType = { name = "GFX_acid_rain_coverage_fill" texturefile = "gfx/interface/033_acid_rain/gui/acid_rain_coverage_fill.dds" noOfFrames = 1 }
	spriteType = { name = "GFX_acid_rain_preparedness_badge" texturefile = "gfx/interface/033_acid_rain/gui/acid_rain_preparedness_badge.dds" noOfFrames = 1 }

	# The component pip is a five-frame strip for runtime tiers 0 through 4.
	spriteType = { name = "GFX_acid_rain_component_pip" texturefile = "gfx/interface/033_acid_rain/gui/acid_rain_component_pip.dds" noOfFrames = 5 }
}
