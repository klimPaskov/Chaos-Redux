# ============================================================================
# CHAOS REDUX - EVENT 033 ACID RAIN GUI VISUAL REGISTRATIONS
# ============================================================================
# Event-owned sprite registrations for the bounded world window. The final
# DDS package is supplied by the Event 033 asset handoff; this file keeps the
# names stable so layout and presentation wiring do not need to move later.
# The decision, modifier, and frame-animation families use stable package-owned
# names. Static animation representatives remain registered for accessibility
# and degraded-motion presentation without replacing the animated consumers.
# ============================================================================

spriteTypes = {
	spriteType = { name = "GFX_super_event_033_acid_rain" texturefile = "gfx/event_pictures/super_events/033_acid_rain.dds" }
