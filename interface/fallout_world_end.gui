guiTypes = {
	containerWindowType = {
		name = "fallout_world_end_blackout_window"
		position = { x = 0 y = 0 }
		size = { width = 100% height = 100% }
		fullScreen = yes
		clipping = no
		moveable = no
		Orientation = "CENTER"

		# A non-transparent button consumes pointer input across the opaque
		# blackout tile. The scripted GUI owns no click effect, so the control
		# cannot advance the transition or mutate the world.
		buttonType = {
			name = "fallout_world_end_click_blocker"
			spriteType = "GFX_fallout_blackout_tile"
			position = { x = -5000 y = -5000 }
			scale = 1000
			buttonText = ""
			alwaystransparent = no
		}

		instantTextBoxType = {
			name = "fallout_world_end_blackout_text"
			position = { x = -600 y = -96 }
			font = "hoi_24header"
			text = "fallout_world_end_blackout_display"
			format = center
			maxWidth = 1200
			maxHeight = 192
			alwaysTransparent = yes
		}
	}
}
