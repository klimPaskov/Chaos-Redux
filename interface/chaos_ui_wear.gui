# ============================================================================
# CHAOS REDUX - CHAOS UI WEAR OVERLAYS
# ============================================================================
# Click-through crack decals drawn over vanilla interface frames as global
# Chaos rises. Each decal is a five-frame sheet (one frame per Chaos tier)
# with a purple twin shown after a world-end scenario. Visibility, frame and
# colour are driven by common/scripted_guis/chaos_ui_wear_scripted_gui.txt.
# Decals sit only on frame borders and empty header plate, never over text.
# See docs/systems/chaos_ui_wear.md.
# ============================================================================

guiTypes = {
	# Top bar: flag frame, lower lip, war-status block and the date widget's top border.
	containerWindowType = {
		name = "chaos_ui_wear_topbar_window"
		position = { x = 0 y = 0 }
		size = { width = 100%% height = 100%% }
		clipping = no

		iconType = {
			name = "wear_flag_corner"
			spriteType = "GFX_chaos_ui_wear_corner_tl"
			position = { x = 0 y = 0 }
