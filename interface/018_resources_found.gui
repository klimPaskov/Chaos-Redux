# ============================================================================
# CHAOS REDUX - EVENT 018 SELECTED FIELD PANEL
# ============================================================================
# Compact decision-category header aligned to the 470x304 field-record art.
# Text remains on the left slate, field artwork remains in the right aperture,
# and all unscaled controls align with the four engraved lower wells.
# ============================================================================

guiTypes = {
