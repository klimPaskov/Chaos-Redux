# ============================================================================
# CHAOS REDUX - WELCOME SCREEN
# ============================================================================
# Overview:
# - Welcome screen window (chaosx_welcome_screen) and its text container.
# ============================================================================

guiTypes = {
	containerWindowType = {
		name = "chaosx_welcome_screen"
		position = { x = 0 y = 0 }
		size = { width = 1024 height= 586 }
		moveable = no
		origo = CENTER
		orientation = CENTER
		clipping = yes
		show_sound = intel_mapmode
		hide_sound = intel_mapmode
		fade_time = 300
		fade_type = linear

		iconType = {
			name = "chaosx_welcome_background"
			quadTextureSprite = GFX_chaosx_welcome_bg
			orientation = UPPER_LEFT
		}

		instantTextBoxType = {
			name ="chaosx_welcome_to"
			position = { x = 82 y = 15 }
			orientation = UPPER_LEFT
			font = hoi_36header
			text = "chaosx_welcome_to_loc"
			format = center
			maxWidth = 860
			maxHeight = 330
			scrollbarType = standardtext_slider
		}
		instantTextBoxType = {
			name ="chaosx_description"
			position = { x = 82 y = 175 }
			orientation = UPPER_LEFT
			font = hoi_36header
			text = "chaosx_description_loc"
			format = center
			maxWidth = 860
			maxHeight = 330
			scrollbarType = standardtext_slider
		}

		containerWindowType = {
			name = "chaosx_welcome_text_container"
			position = { x = 0 y = 71 }
			size = { width = 918 height= 264 }
			moveable = no
			origo = CENTER
			orientation = CENTER
			clipping = yes
			show_animation_type = linear
			hide_animation_type = accelerated
			hide_position = { x = -100 y = 71 }
			show_position = { x = 0 y = 71 }
			background = {
				name = "Background"
				quadTextureSprite = "GFX_tiled_window_transparent"
			}

			instantTextBoxType = {
				name ="chaosx_welcome_text"
				position = { x = 40 y = 0 }
				orientation = UPPER_LEFT
				font = vic_22
				text = "chaosx_welcome_text_loc"
				format = left
				maxWidth = 860
				maxHeight = 264
				scrollbarType = standardtext_slider
			}
		}

		buttonType = {
			name = "chaosx_discord_button"
