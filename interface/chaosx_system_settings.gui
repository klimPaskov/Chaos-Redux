guiTypes = {
	# System Settings window: normally hidden system tuning that the settings system keeps at
	# runtime. Opened from Settings > Advanced Settings > System Settings. Wiring lives in
	# common/scripted_guis/chaosx_scripted_gui_system_settings.txt and
	# common/scripted_effects/chaosx_system_settings_effects.txt.
	containerWindowType = {
		name = "chaosx_system_settings_window"
		position = { x = -270 y = -186 }
		size = { width = 540 height = 372 }
		orientation = center
		moveable = yes
		click_to_front = yes
		show_sound = menu_open_window
		hide_sound = menu_close_window

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_window_2b_border"
		}

		instantTextBoxType = {
			name = "system_settings_title"
			position = { x = 35 y = 16 }
			textureFile = ""
			font = "hoi_24header"
			borderSize = { x = 0 y = 0 }
			text = "chaosx.system_settings.title"
			maxWidth = 470
			maxHeight = 28
			format = center
			alwaysTransparent = yes
		}

		buttonType = {
			name = "system_settings_close_button"
			position = { x = 510 y = 12 }
			quadTextureSprite = "GFX_closebutton_small"
			clicksound = click_close
			pdx_tooltip = "chaosx.system_settings.close.tt"
		}

		instantTextBoxType = {
			name = "system_settings_hint"
			position = { x = 20 y = 46 }
			textureFile = ""
			font = "hoi_16mbs"
			borderSize = { x = 0 y = 0 }
			text = "chaosx.system_settings.hint"
			maxWidth = 500
			maxHeight = 20
			format = center
			alwaysTransparent = yes
		}

		containerWindowType = {
